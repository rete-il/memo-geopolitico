---
import friccionData from '../data/friccion.json';
import escenariosData from '../data/escenarios.json';
import catalizadoresData from '../data/catalizadores.json';
---

<aside class="lg:col-span-3 flex flex-col gap-6">
  <!-- MÓDULO 1: Índice de Fricción Direccional -->
  <div class="flex flex-col gap-3">
    <div
      class="flex items-center justify-between border-b border-slate-300 pb-2"
    >
      <h2
        class="text-xs font-bold uppercase tracking-wider text-slate-500 flex items-center gap-2"
      >
        <i class="ph-fill ph-trend-up text-slate-700"></i> Fricción Direccional
      </h2>
    </div>
    <div class="flex flex-col gap-3">
      {
        friccionData.map((item) => (
          <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200">
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-sm font-bold text-slate-900">{item.region}</h3>
              {item.tendencia === 'alza' && (
                <span class="bg-red-100 text-red-700 px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider flex items-center gap-1">
                  <i class="ph ph-arrow-up-right" /> Al Alza
                </span>
              )}
              {item.tendencia === 'lateral' && (
                <span class="bg-amber-100 text-amber-700 px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider flex items-center gap-1">
                  <i class="ph ph-arrow-right" /> Lateral
                </span>
              )}
              {item.tendencia === 'baja' && (
                <span class="bg-blue-100 text-blue-700 px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider flex items-center gap-1">
                  <i class="ph ph-arrow-down-right" /> A la Baja
                </span>
              )}
            </div>
            <p class="text-[13px] text-slate-600 leading-relaxed">
              {item.analisis}
            </p>
          </div>
        ))
      }
    </div>
  </div>

  <!-- MÓDULO 2: Panel de Escenarios y Probabilidades -->
  <div class="flex flex-col gap-3 mt-4">
    <div
      class="flex items-center justify-between border-b border-slate-300 pb-2"
    >
      <h2
        class="text-xs font-bold uppercase tracking-wider text-slate-500 flex items-center gap-2"
      >
        <i class="ph-fill ph-chart-pie-slice text-slate-700"></i> Escenarios Proyectados
      </h2>
    </div>
    <div class="flex flex-col gap-4">
      {
        escenariosData.map((foco) => (
          <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200">
            <h3 class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-3">
              {foco.foco}
            </h3>
            <div class="flex flex-col gap-3">
              {foco.escenarios.map((escenario) => (
                <div>
                  <div class="flex justify-between text-[13px] mb-1">
                    <span class="font-medium text-slate-800">
                      {escenario.nombre}
                    </span>
                    <span class="font-bold text-slate-600">
                      {escenario.probabilidad}%
                    </span>
                  </div>
                  <div class="w-full bg-slate-100 rounded-full h-1.5">
                    <div
                      class="bg-slate-700 h-1.5 rounded-full"
                      style={`width: ${escenario.probabilidad}%`}
                    />
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- MÓDULO 3: Puntos de Inflexión (Tipping Points) -->
  <div class="flex flex-col gap-3 mt-4">
    <div
      class="flex items-center justify-between border-b border-slate-300 pb-2"
    >
      <h2
        class="text-xs font-bold uppercase tracking-wider text-slate-500 flex items-center gap-2"
      >
        <i class="ph-fill ph-target text-slate-700"></i> Puntos de Inflexión
      </h2>
    </div>
    <div class="flex flex-col gap-3 pb-8">
      {
        catalizadoresData.map((punto) => (
          <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 relative overflow-hidden">
            <div
              class={`absolute left-0 top-0 bottom-0 w-1 ${punto.estado === 'inminente' ? 'bg-red-500' : punto.estado === 'en desarrollo' ? 'bg-amber-500' : 'bg-slate-300'}`}
            />
            <div class="pl-2">
              <h3 class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">
                {punto.foco}
              </h3>
              <p class="text-[13px] font-medium text-slate-800 leading-snug mb-2">
                Si: {punto.evento}
              </p>
              <div class="flex justify-start">
                <span
                  class={`text-[10px] font-bold uppercase px-2 py-0.5 rounded-sm ${punto.estado === 'inminente' ? 'bg-red-50 text-red-700' : punto.estado === 'en desarrollo' ? 'bg-amber-50 text-amber-700' : 'bg-slate-50 text-slate-500'}`}
                >
                  {punto.estado}
                </span>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</aside>
