---
const { ensayos } = Astro.props;

function formatDate(value: Date): string {
  return value.toLocaleDateString('es-ES', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
  });
}
---

<div
  class="mt-2 flex items-center justify-between border-b border-slate-300 pb-2"
>
  <h2
    class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-500"
  >
    <i class="ph-fill ph-article text-slate-700" aria-hidden="true"></i>
    Focos
  </h2>

  <a
    href="/focos/"
    class="text-[11px] font-semibold text-blue-700 hover:text-blue-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2"
  >
    Ver todos →
  </a>
</div>

<div id="focos-container" class="flex flex-col gap-5">
  {
    ensayos.map((foco: any) => {
      const updated = foco.data.updated ?? foco.data.date;

      return (
        <article class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition-shadow hover:shadow-md">
          <div class="flex flex-wrap gap-2">
            {(foco.data.tags || []).map((tag: string) => (
              <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-slate-600">
                {tag}
              </span>
            ))}
          </div>

          <h3 class="mt-3 text-xl font-serif font-bold leading-snug text-slate-900">
            {foco.data.title}
          </h3>

          <p class="mt-3 text-sm leading-6 text-slate-600">
            {foco.data.homeSummary}
          </p>

          <footer class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-4">
            <time
              datetime={updated.toISOString()}
              class="text-[11px] text-slate-400"
            >
              Actualizado: {formatDate(updated)}
            </time>

            <a
              href={`/focos/${foco.id}/`}
              class="inline-flex items-center text-sm font-semibold text-blue-700 transition-colors hover:text-blue-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2"
              aria-label={`Leer el foco completo: ${foco.data.title}`}
            >
              Leer foco
              <i class="ph ph-arrow-right ml-1" aria-hidden="true"></i>
            </a>
          </footer>
        </article>
      );
    })
  }
</div>
