---
const pathname = Astro.url.pathname;

const navItems = [
  {
    label: 'Inicio',
    href: '/',
  },
  {
    label: 'Directorio',
    href: '/directorio/',
  },
  {
    label: 'Ensayos',
    href: '/ensayos/',
  },
];

function isActive(href: string): boolean {
  if (href === '/') {
    return pathname === '/';
  }

  const normalizedHref = href.replace(/\/$/, '');

  return (
    pathname === normalizedHref ||
    pathname === `${normalizedHref}/` ||
    pathname.startsWith(`${normalizedHref}/`)
  );
}
---

<header
  class="bg-slate-900 text-white sticky top-0 z-50 shadow-md border-b border-slate-800"
>
  <div
    class="max-w-screen-2xl mx-auto px-4 lg:px-6 h-16 flex items-center justify-between"
  >
    <a
      href="/"
      class="flex items-center gap-2 rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-900"
      aria-label="Ir al inicio de Memo Geopolítico"
    >
      <i
        class="ph-fill ph-globe-hemisphere-west text-2xl text-red-600"
        aria-hidden="true"></i>

      <span class="text-xl font-bold tracking-tight uppercase font-sans">
        Memo Geopolítico
      </span>
    </a>

    <nav class="flex items-center gap-1" aria-label="Navegación principal">
      {
        navItems.map((item) => {
          const active = isActive(item.href);

          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'px-4 py-2 text-sm rounded-sm transition-colors',
                'focus-visible:outline-none focus-visible:ring-2',
                'focus-visible:ring-blue-400 focus-visible:ring-offset-2',
                'focus-visible:ring-offset-slate-900',
                active
                  ? 'font-bold text-blue-400'
                  : 'font-medium text-gray-300 hover:text-white',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
