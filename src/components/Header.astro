---
const { pathname } = Astro.url;

const navigation = [
  { href: '/', label: 'Inicio' },
  { href: '/observatorio/', label: 'Observatorio' },
  { href: '/publicaciones/', label: 'Publicaciones' },
  { href: '/recursos-visuales/', label: 'Recursos visuales' },
  { href: '/acerca-de/', label: 'Acerca de' },
];

const exploration = [
  { href: '/regiones/', label: 'Regiones' },
  { href: '/espacios-geopoliticos/', label: 'Espacios geopolíticos' },
  { href: '/temas/', label: 'Temas' },
  { href: '/actores/', label: 'Actores' },
  { href: '/etiquetas/', label: 'Etiquetas' },
  { href: '/medios/', label: 'Medios' },
];

const active = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="site-header">
  <div class="header-inner">
    <button
      class="menu-trigger"
      type="button"
      aria-label="Abrir menú de exploración"
      aria-controls="site-menu"
      aria-expanded="false"
      data-menu-open
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>

    <a class="brand" href="/" aria-label="Memo Geopolítico, inicio">
      <span class="brand-mark" aria-hidden="true">MG</span>
      <span>
        <strong>Memo Geopolítico</strong>
        <small>Procesos que exceden la coyuntura</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Navegación principal">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            aria-current={active(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a class="search-shortcut" href="/observatorio/#explorar" aria-label="Buscar en el Observatorio">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="6.5"></circle>
        <path d="m16 16 4 4"></path>
      </svg>
    </a>
  </div>
</header>

<dialog id="site-menu" class="site-menu" aria-labelledby="menu-title">
  <div class="menu-shell">
    <div class="menu-heading">
      <div>
        <p class="eyebrow">Exploración</p>
        <h2 id="menu-title">Explorar Memo Geopolítico</h2>
      </div>
      <button type="button" class="menu-close" aria-label="Cerrar menú" data-menu-close>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>

    <nav class="menu-primary" aria-label="Exploración transversal">
      {
        exploration.map((item) => (
          <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>
            <span>{item.label}</span>
            <span aria-hidden="true">→</span>
          </a>
        ))
      }
    </nav>

    <div class="menu-explore">
      <p class="eyebrow">Seguimiento</p>
      <div>
        <a href="/observatorio/?editorial=en_curso#explorar">Trabajo en curso</a>
        <a href="/observatorio/dashboard/">Dashboard público</a>
        <a href="/observatorio/senales/">Señales</a>
        <a href="/metodologia/relevancia-atencion-mediatica/">Metodología</a>
      </div>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#site-menu');
  const openButton = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  const closeMenu = () => {
    if (!dialog?.open) return;
    dialog.close();
    openButton?.setAttribute('aria-expanded', 'false');
    openButton?.focus();
  };

  openButton?.addEventListener('click', () => {
    dialog?.showModal();
    document.documentElement.classList.add('menu-open');
    openButton.setAttribute('aria-expanded', 'true');
    closeButton?.focus();
  });

  closeButton?.addEventListener('click', closeMenu);

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) closeMenu();
  });

  dialog?.addEventListener('close', () => {
    document.documentElement.classList.remove('menu-open');
    openButton?.setAttribute('aria-expanded', 'false');
  });
</script>
