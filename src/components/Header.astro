---
import { primaryNavigation, explorationNavigation, followUpNavigation, siteSearch } from '../lib/navigation';
import { selectActiveNavigationItem } from '../../tools/lib/navigation-policy.mjs';

const { pathname } = Astro.url;

const secondaryGroups = [
  { id: 'menu-explore-title', label: 'Explorar por tema y lugar', links: explorationNavigation },
  { id: 'menu-follow-up-title', label: 'Seguimiento', links: followUpNavigation },
];

const activeItem = selectActiveNavigationItem(primaryNavigation, pathname);
---

<header class="site-header">
  <div class="header-inner">
    <button
      class="menu-trigger"
      type="button"
      aria-label="Abrir menú del sitio"
      aria-controls="site-menu"
      aria-expanded="false"
      data-menu-open
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>

    <a class="brand" href="/" aria-label="Memo Geopolítico, inicio">
      <span class="brand-mark" aria-hidden="true">MG</span>
      <span>
        <strong>Memo Geopolítico</strong>
        <small>Procesos que exceden la coyuntura</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Navegación principal">
      {
        primaryNavigation.map((item) => (
          <a
            href={item.href}
            aria-current={item === activeItem ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a class="search-shortcut" href={siteSearch.href} aria-label={siteSearch.label}>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="6.5"></circle>
        <path d="m16 16 4 4"></path>
      </svg>
    </a>
  </div>
</header>

<dialog id="site-menu" class="site-menu" aria-labelledby="menu-title">
  <div class="menu-shell">
    <div class="menu-heading">
      <div>
        <p class="eyebrow">Memo Geopolítico</p>
        <h2 id="menu-title">Menú del sitio</h2>
      </div>
      <button type="button" class="menu-close" aria-label="Cerrar menú" data-menu-close>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>

    <nav class="menu-primary" aria-label="Secciones principales">
      {
        primaryNavigation.map((item) => (
          <a href={item.href} aria-current={item === activeItem ? 'page' : undefined}>
            <span>{item.label}</span>
            <span aria-hidden="true">→</span>
          </a>
        ))
      }
    </nav>

    {secondaryGroups.map(group => (
      <nav class="menu-explore" aria-labelledby={group.id}>
        <h3 id={group.id} class="eyebrow">{group.label}</h3>
        <div>
          {group.links.map(item => <a href={item.href}>{item.label}</a>)}
        </div>
      </nav>
    ))}
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#site-menu');
  const openButton = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  const closeMenu = () => {
    if (!dialog?.open) return;
    dialog.close();
    openButton?.setAttribute('aria-expanded', 'false');
    openButton?.focus();
  };

  openButton?.addEventListener('click', () => {
    if (!dialog || dialog.open) return;
    dialog.showModal();
    document.documentElement.classList.add('menu-open');
    openButton.setAttribute('aria-expanded', 'true');
    closeButton?.focus();
  });

  closeButton?.addEventListener('click', closeMenu);

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) closeMenu();
  });

  dialog?.addEventListener('close', () => {
    document.documentElement.classList.remove('menu-open');
    openButton?.setAttribute('aria-expanded', 'false');
    openButton?.focus();
  });
</script>
