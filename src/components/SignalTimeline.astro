---
import { sourceById } from '../lib/data';
import { formatDate } from '../lib/text';
import { signalHref } from '../../tools/lib/navigation-policy.mjs';
import type { PublicSignal } from '../lib/types';

interface Props {
  signals: PublicSignal[];
  processSlug?: string;
  headingLevel?: 2 | 3;
}

const { signals, processSlug, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
---

<ol class="signal-timeline">
  {
    signals.map((signal) => {
      const signalSources = signal.fuente_ids
        .map((id) => sourceById.get(id))
        .filter(Boolean);
      const href = processSlug
        ? signalHref(processSlug, signal.senal_id)
        : undefined;
      return (
        <li id={processSlug ? signal.senal_id : undefined}>
          <time datetime={signal.fecha}>{formatDate(signal.fecha)}</time>
          <div>
            <div class="signal-heading">
              <Heading class="signal-title">
                {signal.titulo}
              </Heading>
              <span class={`verification ${signal.estado_verificacion}`}>
                {signal.estado_verificacion}
              </span>
            </div>
            <p>{signal.resumen}</p>
            {href && <a class="signal-permalink" href={href} aria-label={`Enlace permanente: ${signal.titulo}`}>Enlace permanente a esta señal</a>}
            {signalSources.length > 0 && (
              <p class="signal-sources">
                Fuentes:{' '}
                {signalSources.map((source, index) => (
                  <>
                    {index > 0 && ', '}
                    <a href={source?.url} target="_blank" rel="noopener noreferrer">
                      {source?.medio || source?.titulo}
                    </a>
                  </>
                ))}
              </p>
            )}
          </div>
        </li>
      );
    })
  }
</ol>
