---
import { catalogMaps } from '../lib/data';
import {
  cardLabelReferences,
  labelHref,
  topicHref,
  topicReferences,
} from '../lib/taxonomy';
import { editorialStageLabel, formatDate } from '../lib/text';
import type { Classification } from '../lib/types';

interface Props {
  publication: {
    slug: string;
    titulo: string;
    subtitulo: string;
    resumen: string;
    tipo_publicacion: string;
    publicacion: {
      estado: string;
      publicado_el?: string | null;
      actualizado_el: string;
    };
    macroevento_principal_id: string;
    clasificacion: Classification;
  };
  editorialPreview?: boolean;
  currentThemeId?: string;
  currentLabelId?: string;
}

const {
  publication,
  editorialPreview = false,
  currentThemeId,
  currentLabelId,
} = Astro.props;
const isPublished = publication.publicacion.estado === 'publicado';
const destination = isPublished || editorialPreview
  ? `/publicaciones/${publication.slug}/`
  : `/observatorio/${publication.macroevento_principal_id}/`;
const topics = topicReferences(publication.clasificacion, catalogMaps);
const primaryTopic = topics.find((topic) => topic.primary);
const labels = cardLabelReferences(publication.clasificacion, catalogMaps);
---

<article
  class:list={[
    'publication-card',
    isPublished
      ? 'publication-card--published'
      : 'publication-card--in-progress',
  ]}
>
  <div class="card-meta">
    {
      primaryTopic &&
        (primaryTopic.id === currentThemeId ? (
          <span
            class="meta-link meta-link--theme meta-link--primary"
            aria-current="page"
          >
            {primaryTopic.item.nombre}
          </span>
        ) : (
          <a
            class="meta-link meta-link--theme meta-link--primary"
            href={topicHref(primaryTopic)}
          >
            {primaryTopic.item.nombre}
          </a>
        ))
    }
    {
      labels.map((label) =>
        label.id === currentLabelId ? (
          <span class="meta-link meta-link--label" aria-current="page">
            {label.item.nombre}
          </span>
        ) : (
          <a class="meta-link meta-link--label" href={labelHref(label)}>
            {label.item.nombre}
          </a>
        ),
      )
    }
    {
      !isPublished && (
        <span
          class:list={[
            'status-link',
            `status-link--${publication.publicacion.estado}`,
          ]}
        >
          {editorialPreview && 'Vista local · '}
          {editorialStageLabel(publication.publicacion.estado)}
        </span>
      )
    }
  </div>
  <h2>
    {
      isPublished || editorialPreview ? (
        <a href={destination}>{publication.titulo}</a>
      ) : (
        <span>{publication.titulo}</span>
      )
    }
  </h2>
  {
    publication.subtitulo && (
      <p class="publication-subtitle">{publication.subtitulo}</p>
    )
  }
  <p>{publication.resumen}</p>
  <footer>
    <span>
      {
        publication.publicacion.publicado_el
          ? `Publicado ${formatDate(publication.publicacion.publicado_el)}`
          : `Actualizado ${formatDate(publication.publicacion.actualizado_el)}`
      }
    </span>
    <a href={destination}>
      {isPublished ? 'Leer publicación' : editorialPreview ? 'Leer borrador' : 'Abrir expediente'}{' '}
      <span aria-hidden="true">→</span>
    </a>
  </footer>
</article>
