---
import { supportConfig } from '../config/support';

const visible = supportConfig.enabled && supportConfig.showOnPublications;
---

{
  visible && (
    <aside class="support-cta" aria-label="Apoyo a Memo Geopolítico">
      <p class="eyebrow">Proyecto independiente</p>
      <h2>¿Te resultó útil este análisis?</h2>
      <p>
        Tu apoyo contribuye a sostener la investigación, las fuentes y el
        desarrollo de Memo Geopolítico.
      </p>
      <a href={supportConfig.url} target="_blank" rel="noopener noreferrer">
        Apoyar Memo Geopolítico
        <span class="sr-only"> mediante Ko-fi</span>
      </a>
    </aside>
  )
}
