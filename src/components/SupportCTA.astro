---
import { supportConfig } from '../config/support';

interface Props {
  placement: 'alert' | 'essay';
}

const { placement } = Astro.props;

const placementEnabled =
  placement === 'alert'
    ? supportConfig.showOnAlerts
    : supportConfig.showOnEssays;

const visible = supportConfig.enabled && placementEnabled;
---

{
  visible && (
    <aside
      class="mt-12 rounded-xl border border-slate-200 bg-slate-50 p-6 text-center shadow-sm"
      aria-label="Apoyo a Memo Geopolítico"
    >
      <h2 class="text-xl font-bold text-slate-900">
        ¿Te resultó útil este análisis?
      </h2>

      <p class="mx-auto mt-3 max-w-xl text-[15px] leading-6 text-slate-600">
        Memo Geopolítico es un proyecto editorial independiente. Tu apoyo
        contribuye a sostener la investigación, las fuentes y el desarrollo
        del sitio.
      </p>

      <a
        href={supportConfig.url}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex min-h-11 items-center justify-center rounded-md bg-slate-900 px-6 py-2.5 font-semibold text-white transition-colors hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2"
      >
        Apoyar Memo Geopolítico
        <span class="sr-only"> mediante Ko-fi</span>
      </a>
    </aside>
  )
}
