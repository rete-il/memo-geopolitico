---
import type { PublicProcess } from '../../lib/types';

interface Props { process: PublicProcess; }
const { process } = Astro.props;

---

{
  (process.indicadores_fortalecimiento?.length || process.indicadores_debilitamiento?.length) && (
    <section class="content-section">
      <h2>Cómo cambia la hipótesis</h2>
      {(process.indicadores_fortalecimiento?.length ?? 0) > 0 && (
        <>
          <h3>Indicadores de fortalecimiento</h3>
          <ul>{process.indicadores_fortalecimiento?.map((item) => <li>{item}</li>)}</ul>
        </>
      )}
      {(process.indicadores_debilitamiento?.length ?? 0) > 0 && (
        <>
          <h3>Indicadores de debilitamiento</h3>
          <ul>{process.indicadores_debilitamiento?.map((item) => <li>{item}</li>)}</ul>
        </>
      )}
    </section>
  )
}

{
  (process.condiciones_refutacion?.length || process.incertidumbres?.length) && (
    <section class="content-section">
      <h2>Refutación e incertidumbres</h2>
      {(process.condiciones_refutacion?.length ?? 0) > 0 && (
        <>
          <h3>Condiciones de refutación</h3>
          <ul>{process.condiciones_refutacion?.map((item) => <li>{item}</li>)}</ul>
        </>
      )}
      {(process.incertidumbres?.length ?? 0) > 0 && (
        <>
          <h3>Incertidumbres abiertas</h3>
          <ul>{process.incertidumbres?.map((item) => <li>{item}</li>)}</ul>
        </>
      )}
    </section>
  )
}

{
  Object.values(process.escenarios).some(Boolean) && (
    <section class="content-section">
      <h2>Escenarios</h2>
      <div class="explore-grid">
        {process.escenarios.base && (
          <article class="explore-card">
            <h3>Base</h3>
            <p>{process.escenarios.base}</p>
          </article>
        )}
        {process.escenarios.adverso && (
          <article class="explore-card">
            <h3>Adverso</h3>
            <p>{process.escenarios.adverso}</p>
          </article>
        )}
        {process.escenarios.transformador && (
          <article class="explore-card">
            <h3>Transformador</h3>
            <p>{process.escenarios.transformador}</p>
          </article>
        )}
      </div>
    </section>
  )
}
