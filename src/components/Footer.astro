---
import { supportConfig } from '../config/support';

const showSupport = supportConfig.enabled && supportConfig.showInFooter;
---

<footer class="site-footer">
  <div class="footer-inner">
    <div>
      <a class="footer-brand" href="/">Memo Geopolítico</a>
      <p>Análisis independiente de procesos geopolíticos de mediano y largo plazo.</p>
    </div>
    <nav aria-label="Navegación del pie">
      <a href="/observatorio/">Observatorio</a>
      <a href="/observatorio/dashboard/">Dashboard</a>
      <a href="/publicaciones/">Publicaciones</a>
      <a href="/medios/">Medios</a>
      <a href="/metodologia/relevancia-atencion-mediatica/">Metodología</a>
      <a href="/acerca-de/">Acerca de</a>
      {
        showSupport && (
          <a href={supportConfig.url} target="_blank" rel="noopener noreferrer">
            Apoyar el proyecto <span class="sr-only">mediante Ko-fi</span>
          </a>
        )
      }
    </nav>
  </div>
  <div class="footer-legal">
    <span>© {new Date().getFullYear()} Memo Geopolítico</span>
    <span>Sitio estático · Sin seguimiento publicitario</span>
  </div>
</footer>
