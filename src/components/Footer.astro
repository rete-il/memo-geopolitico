---
import { supportConfig } from '../config/support';
import { footerNavigation } from '../lib/navigation';
import { institutionalContacts, institutionalPages } from '../lib/institutional';

const showSupport = supportConfig.enabled && supportConfig.showInFooter;
const generalContact = institutionalContacts('contacto').find(contact => contact.key === 'general');
const institutionalPaths = new Set(institutionalPages.map(page => `/${page.slug}/`));
const explorationLinks = footerNavigation.filter(item => !institutionalPaths.has(item.href));
const informationLinks = footerNavigation.filter(item => institutionalPaths.has(item.href));
const hasInformation = informationLinks.length > 0 || showSupport;
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-identity">
      <a class="footer-brand" href="/">Memo Geopolítico</a>
      <p>Análisis independiente de procesos geopolíticos de mediano y largo plazo.</p>
      {generalContact && <a class="footer-contact" href={generalContact.href}>{generalContact.email}</a>}
    </div>
    <nav class:list={['footer-navigation', { 'footer-navigation--single': !hasInformation }]} aria-label="Navegación del pie">
      <div class="footer-navigation-group">
        <h2>Explorar</h2>
        <ul>
          {explorationLinks.map(item => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </div>
      {hasInformation && <div class="footer-navigation-group">
        <h2>Información</h2>
        <ul>
          {informationLinks.map(item => <li><a href={item.href}>{item.label}</a></li>)}
          {showSupport && <li>
            <a href={supportConfig.url} target="_blank" rel="noopener noreferrer">
              Apoyar el proyecto <span class="sr-only">mediante Ko-fi</span>
            </a>
          </li>}
        </ul>
      </div>}
    </nav>
  </div>
  <div class="footer-legal">
    <span>© {new Date().getFullYear()} Memo Geopolítico</span>
    <span>Sitio estático · Sin seguimiento publicitario</span>
  </div>
</footer>
