---
import type { OpinionReading } from '../lib/opinion';
import { latestOpinionReadings } from '../../tools/lib/opinion-selection.mjs';
import { formatDate } from '../lib/text';
import MoreOpinionsLink from './MoreOpinionsLink.astro';
import { homeConfig } from '../config/home';
interface Props { readings: OpinionReading[]; }
const selected = latestOpinionReadings(Astro.props.readings, homeConfig.opinion.limit);
---
{selected.length > 0 && <section class="home-opinion" aria-labelledby="opinion-title">
  <header>
    <div><p class="eyebrow">{homeConfig.opinion.eyebrow}</p><h2 id="opinion-title">{homeConfig.opinion.title}</h2></div>
    <MoreOpinionsLink />
  </header>
  <p class="intro">{homeConfig.opinion.description}</p>
  <div class="opinion-grid">
    {selected.map(reading => <article>
      <p class="format">{reading.formato === 'entrevista' ? 'Entrevista' : 'Artículo'} · {reading.origen.medio}</p>
      <h3><a href={`/opinion/${reading.slug}/`}>{reading.titulo}</a></h3>
      <p class="author">{reading.autor.nombre}{reading.entrevistador && <span> · Entrevista de {reading.entrevistador}</span>}</p>
      <p class="description">{reading.descripcion}</p>
      <footer>
        {reading.incorporado_el && <p>Incorporado al sitio: <time datetime={reading.incorporado_el}>{formatDate(reading.incorporado_el)}</time></p>}
        <p>Publicación original: <time datetime={reading.origen.fecha}>{formatDate(reading.origen.fecha)}</time></p>
      </footer>
    </article>)}
  </div>
  <div class="section-end"><MoreOpinionsLink /></div>
</section>}
<style>
  .home-opinion { margin-top: var(--section-gap); }
  header { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--space-4); }
  h2 { margin: var(--space-2) 0 0; font: var(--font-weight-medium) var(--type-section-size)/1.2 var(--serif); letter-spacing: -.025em; }
  .section-end { display: flex; justify-content: flex-end; margin-top: var(--space-6); }
  .intro { max-width: 65ch; color: var(--ink-700); margin: var(--space-4) 0 var(--space-6); font-size: var(--type-body-small-size); }
  .opinion-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); }
  article { display: flex; flex-direction: column; min-width: 0; padding-top: var(--space-5); border-top: 2px solid var(--line-strong); }
  .format { margin: 0; color: var(--amber-text); font-size: var(--type-meta-size); font-weight: var(--font-weight-semibold); }
  h3 { margin: var(--space-3) 0; font: var(--font-weight-medium) var(--type-card-size)/1.2 var(--serif); letter-spacing: -.025em; text-wrap: pretty; }
  h3 a { text-decoration: none; }
  h3 a:hover { text-decoration: underline; }
  .author { margin: 0; font-weight: var(--font-weight-semibold); font-size: var(--type-body-small-size); }
  .author span { font-weight: var(--font-weight-regular); }
  .description { color: var(--ink-700); font-size: var(--type-body-small-size); }
  footer { margin-top: auto; padding-top: var(--space-4); border-top: 1px solid var(--line); color: var(--ink-600); font-size: var(--type-meta-size); }
  footer p { margin: var(--space-1) 0; }
  @media (max-width: 900px) { .opinion-grid { grid-template-columns: 1fr; } }
</style>
