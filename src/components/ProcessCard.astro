---
import { catalogMaps } from '../lib/data';
import {
  editorialStateSlug,
  effectiveEditorialState,
  relatedPublicationForProcess,
} from '../lib/editorial';
import {
  getPublicationEntries,
  type PublicationEntry,
} from '../lib/publications';
import {
  cardLabelReferences,
  labelHref,
  topicHref,
  topicReferences,
} from '../lib/taxonomy';
import { editorialStageLabel, formatDate } from '../lib/text';
import type { PublicationState, PublicProcess } from '../lib/types';
import RatingPair from './RatingPair.astro';
import { processSearchText } from '../../tools/lib/search-policy.mjs';

interface Props {
  process: PublicProcess;
  editorialPreview?: boolean;
  currentThemeId?: string;
  currentLabelId?: string;
  currentGeographyId?: string;
  currentState?: PublicationState;
  editorialState?: PublicationState;
  relatedPublication?: PublicationEntry;
}

const {
  process,
  currentThemeId,
  currentLabelId,
  currentGeographyId,
  currentState,
  editorialState: suppliedEditorialState,
  relatedPublication: suppliedRelatedPublication,
} = Astro.props;
const topics = topicReferences(process.clasificacion, catalogMaps);
const primaryTopic = topics.find((topic) => topic.primary);
const labels = cardLabelReferences(process.clasificacion, catalogMaps);
const geographyItems = [
  ...process.clasificacion.geografia.region_ids.map((id) => ({
    id,
    item: catalogMaps.regiones.get(id),
    hrefBase: '/regiones',
  })),
  ...process.clasificacion.geografia.subregion_ids.map((id) => ({
    id,
    item: catalogMaps.subregiones.get(id),
    hrefBase: '/regiones',
  })),
  ...process.clasificacion.geografia.pais_ids.map((id) => ({
    id,
    item: catalogMaps.paises.get(id),
    hrefBase: '/regiones',
  })),
  ...process.clasificacion.geografia.espacio_ids.map((id) => ({
    id,
    item: catalogMaps.espacios.get(id),
    hrefBase: '/espacios-geopoliticos',
  })),
].filter(
  (
    reference,
  ): reference is {
    id: string;
    item: NonNullable<typeof reference.item>;
    hrefBase: string;
  } => Boolean(reference.item),
);
const contextualGeography =
  geographyItems.find(({ id }) => id === currentGeographyId) ||
  geographyItems[0];
const suppliedPublishedPrimary =
  suppliedRelatedPublication?.data.macroevento_principal_id === process.macroevento_id &&
  suppliedRelatedPublication?.data.publicacion.estado === 'publicado'
    ? suppliedRelatedPublication
    : undefined;
// Re-evaluate secondary or unpublished hints; they cannot hide a published
// principal article. Retain the fast path for a preselected published principal.
const publicationEntries = suppliedPublishedPrimary && suppliedEditorialState ? [] : await getPublicationEntries({
  includePreview: true,
});
const relatedPublication =
  suppliedPublishedPrimary ||
  relatedPublicationForProcess(process, publicationEntries);
const publishedPublication =
  relatedPublication?.data.publicacion.estado === 'publicado'
    ? relatedPublication
    : undefined;
const primaryPublication =
  publishedPublication?.data.macroevento_principal_id === process.macroevento_id
    ? publishedPublication
    : undefined;
const publicationHref = primaryPublication
  ? `/publicaciones/${primaryPublication.data.slug}/`
  : '';
const relatedPublicationHref = !primaryPublication && publishedPublication
  ? `/publicaciones/${publishedPublication.data.slug}/`
  : '';
const editorialState =
  suppliedEditorialState ||
  effectiveEditorialState(process, publicationEntries);
---

<article
  class="process-card"
  data-process-card
  data-search={processSearchText(process, catalogMaps)}
  data-region={[
    ...process.clasificacion.geografia.region_ids,
    ...process.clasificacion.geografia.subregion_ids,
    ...process.clasificacion.geografia.pais_ids,
    ...process.clasificacion.geografia.espacio_ids,
  ].join(' ')}
  data-theme={[
    process.clasificacion.tema_principal_id,
    ...process.clasificacion.tema_secundario_ids,
    ...process.clasificacion.subtema_ids,
  ]
    .filter(Boolean)
    .join(' ')}
  data-actor={process.clasificacion.actor_ids.join(' ')}
  data-label={process.clasificacion.etiqueta_ids.join(' ')}
  data-tracking-state={process.estado_seguimiento}
  data-editorial-state={editorialState}
  data-relevance={process.valoraciones.relevancia_geopolitica}
  data-attention={process.valoraciones.atencion_mediatica}
>
  <div class="process-card-main">
    <div class="card-meta">
      {
        contextualGeography &&
          (contextualGeography.id === currentGeographyId ? (
            <span class="meta-link meta-link--geography" aria-current="page">
              {contextualGeography.item.nombre}
            </span>
          ) : (
            <a
              class="meta-link meta-link--geography"
              href={`${contextualGeography.hrefBase}/${contextualGeography.item.slug}/`}
            >
              {contextualGeography.item.nombre}
            </a>
          ))
      }
      {
        primaryTopic &&
          (primaryTopic.id === currentThemeId ? (
            <span
              class="meta-link meta-link--theme meta-link--primary"
              aria-current="page"
            >
              {primaryTopic.item.nombre}
            </span>
          ) : (
            <a
              class="meta-link meta-link--theme meta-link--primary"
              href={topicHref(primaryTopic)}
            >
              {primaryTopic.item.nombre}
            </a>
          ))
      }
      {
        labels.map((label) =>
          label.id === currentLabelId ? (
            <span class="meta-link meta-link--label" aria-current="page">
              {label.item.nombre}
            </span>
          ) : (
            <a class="meta-link meta-link--label" href={labelHref(label)}>
              {label.item.nombre}
            </a>
          ),
        )
      }
      {
        editorialState === currentState ? (
          <span
            class:list={['status-link', `status-link--${editorialState}`]}
            aria-current="page"
          >
            Estado: {editorialStageLabel(editorialState)}
          </span>
        ) : (
          <a
            class:list={['status-link', `status-link--${editorialState}`]}
            href={`/observatorio/estado/${editorialStateSlug(editorialState)}/`}
            aria-label={`Ver expedientes con estado ${editorialStageLabel(editorialState)}`}
          >
            Estado: {editorialStageLabel(editorialState)}
          </a>
        )
      }
    </div>
    <h2>
      {
        publicationHref ? (
          <a href={publicationHref}>{process.titulo}</a>
        ) : (
          <span title="La publicación principal todavía no está publicada">
            {process.titulo}
          </span>
        )
      }
    </h2>
    <p>{process.sintesis}</p>
    {
      relatedPublicationHref && publishedPublication && (
        <p>
          Análisis relacionado: <a href={relatedPublicationHref}>{publishedPublication.data.titulo}</a>
        </p>
      )
    }
    <footer>
      <span>Actualizado {formatDate(process.publicacion.actualizado_el)}</span>
      <a href={`/observatorio/${process.slug}/`}>
        Abrir expediente <span aria-hidden="true">→</span>
      </a>
    </footer>
  </div>
  <RatingPair
    relevance={process.valoraciones.relevancia_geopolitica}
    attention={process.valoraciones.atencion_mediatica}
    compact
    publicationTitle={primaryPublication?.data.titulo || process.titulo}
    methodHref={`/metodologia/relevancia-atencion-mediatica/${process.slug}/`}
  />
</article>
