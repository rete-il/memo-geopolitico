---
const { alerta, slug } = Astro.props;
const { title, region, date, severity } = alerta.data;

const alertDate = new Date(date);
const today = new Date();
const yesterday = new Date(today);
yesterday.setDate(yesterday.getDate() - 1);

let dateDisplay = '';
if (alertDate.toDateString() === today.toDateString()) {
  dateDisplay = 'Hoy';
} else if (alertDate.toDateString() === yesterday.toDateString()) {
  dateDisplay = 'Ayer';
} else {
  dateDisplay = alertDate.toLocaleDateString('es-ES', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
  });
}

const styles = {
  critical: { bg: 'bg-red-500', textGroupHover: 'group-hover:text-red-500' },
  medium: { bg: 'bg-amber-500', textGroupHover: 'group-hover:text-amber-500' },
  low: { bg: 'bg-yellow-400', textGroupHover: 'group-hover:text-yellow-500' },
};

const currentStyle = styles[severity as keyof typeof styles];
---

<a
  href={`/alertas/${slug}`}
  class="alert-card block group relative bg-white border border-slate-200 rounded-lg p-4 transition-all duration-200 hover:shadow-md cursor-pointer"
  data-slug={slug}
>
  <div
    class={`absolute left-0 top-0 bottom-0 w-1 rounded-l-lg ${currentStyle.bg}`}
  >
  </div>
  <div class="flex justify-between items-center mb-2 pl-2">
    <div class="flex items-center gap-1.5">
      <span class={`w-1.5 h-1.5 rounded-full ${currentStyle.bg}`}></span>
      <span
        class="text-[12px] font-medium tracking-[0.05em] text-slate-500 uppercase"
        >{region}</span
      >
    </div>
    <span class="text-[12px] text-slate-400">{dateDisplay}</span>
  </div>
  <h3
    class="text-[16px] font-semibold text-slate-900 leading-[1.2] line-clamp-2 mb-1 pl-2"
  >
    {title}
  </h3>
  <div class="text-[14px] font-normal text-slate-600 line-clamp-2 mb-4 pl-2">
    <slot />
  </div>
  <div class="flex justify-end">
    <span
      class={`text-[13px] font-medium text-slate-500 flex items-center transition-colors duration-200 ${currentStyle.textGroupHover}`}
    >
      Para profundizar
      <i
        class="ph ph-arrow-right ml-1 transition-transform duration-200 group-hover:translate-x-1"
      ></i>
    </span>
  </div>
</a>
