---
const { alerta, slug } = Astro.props;
const { title, region, date, severity, vinculo } = alerta.data;

const alertDate = new Date(date);
const today = new Date();
const yesterday = new Date(today);
yesterday.setDate(yesterday.getDate() - 1);

let dateDisplay = '';
if (alertDate.toDateString() === today.toDateString()) {
  dateDisplay = 'Hoy';
} else if (alertDate.toDateString() === yesterday.toDateString()) {
  dateDisplay = 'Ayer';
} else {
  // Formato: DD MMM YYYY - Prohibido "anteayer"
  const day = alertDate.getDate().toString().padStart(2, '0');
  const month = alertDate
    .toLocaleString('es-ES', { month: 'short' })
    .substring(0, 3);
  const year = alertDate.getFullYear();
  dateDisplay = `${day} ${month.charAt(0).toUpperCase() + month.slice(1)} ${year}`;
}

// Tokens mapeados al Tailwind config
const styles = {
  critical: { bg: 'bg-critical', textGroupHover: 'group-hover:text-critical' },
  high: { bg: 'bg-high', textGroupHover: 'group-hover:text-high' },
  medium: { bg: 'bg-medium', textGroupHover: 'group-hover:text-medium' },
  low: { bg: 'bg-low', textGroupHover: 'group-hover:text-low' },
};

const currentStyle = styles[severity as keyof typeof styles] || styles.low;
---

<article
  class="alert-card block group relative bg-white border border-slate-200 rounded-lg p-4 transition-all duration-300 hover:shadow-[0_10px_15px_-3px_rgba(0,0,0,0.05)]"
  data-slug={slug}
  id={`card-${slug}`}
>
  <!-- Banda vertical sólida conectada a las variables @theme -->
  <div
    class={`absolute left-0 top-0 bottom-0 w-1 rounded-l-lg ${currentStyle.bg}`}
  >
  </div>

  <div class="flex justify-between items-center mb-2 pl-2">
    <div class="flex items-center gap-1.5">
      <span class={`w-1.5 h-1.5 rounded-full ${currentStyle.bg}`}></span>
      <span class="text-[11px] font-semibold text-[#64748B] uppercase"
        >{region}</span
      >
    </div>
    <span class="text-[12px] text-slate-400">{dateDisplay}</span>
  </div>

  <h3 class="text-[15px] font-bold text-slate-900 leading-[1.2] mb-1 pl-2">
    {title}
  </h3>

  <!-- Contenedor del Slot con estilos para habilitar y pintar los enlaces del Markdown -->
  <div
    class="text-[13px] font-normal text-[#475569] mb-4 pl-2 [&>p]:m-0 [&_a]:text-blue-600 [&_a]:underline hover:[&_a]:text-blue-800 [&_a]:transition-colors"
  >
    <slot />
  </div>

  <div class="flex justify-end">
    <!-- La alerta y el dossier son piezas autónomas relacionadas por tema. -->
    <a
      href={`/dossiers/${vinculo}/`}
      class={`text-[13px] font-medium text-slate-500 flex items-center transition-colors duration-200 ${currentStyle.textGroupHover}`}
      aria-label={`Ver dossier relacionado con ${title}`}
    >
      Ver dossier
      <i
        class="ph ph-arrow-right ml-1 transition-transform duration-200 group-hover:translate-x-1"
      ></i>
    </a>
  </div>
</article>

<script>
  import { activeAlertId } from '../store/mapStore';

  const cards = document.querySelectorAll('.alert-card');

  activeAlertId.subscribe((activeId: string | null) => {
    cards.forEach((card) => {
      const htmlCard = card as HTMLElement;
      if (htmlCard.dataset.slug === activeId) {
        htmlCard.classList.add(
          'ring-2',
          'ring-slate-400',
          'shadow-lg',
          'scale-[1.02]',
        );
        htmlCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } else {
        htmlCard.classList.remove(
          'ring-2',
          'ring-slate-400',
          'shadow-lg',
          'scale-[1.02]',
        );
      }
    });
  });

  cards.forEach((card) => {
    card.addEventListener('mouseenter', () =>
      activeAlertId.set((card as HTMLElement).dataset.slug || null),
    );
    card.addEventListener('mouseleave', () => activeAlertId.set(null));
  });
</script>
