---
import HomeSectionHeader from './HomeSectionHeader.astro';
import { homeConfig } from '../../config/home';
const { method, routes } = homeConfig;
---
<section class="home-method" aria-labelledby="home-method-title">
  <HomeSectionHeader id="home-method-title" title={method.title} href={routes.methodology} action={method.action} />
  <ol class="home-method-steps">
    {method.steps.map((step, index) => <li><span aria-hidden="true">{index + 1}</span><p>{step}</p></li>)}
  </ol>
</section>
<style>
  .home-method { margin-top: var(--section-gap); padding-block: var(--space-6); border-block: 1px solid var(--line); }
  .home-method-steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-5); list-style: none; padding: 0; margin: 0; }
  .home-method-steps li { display: grid; grid-template-columns: var(--space-6) minmax(0, 1fr); align-items: start; gap: var(--space-2); }
  .home-method-steps li > span { color: var(--amber-text); font: var(--font-weight-medium) var(--type-subheading-size)/1.2 var(--serif); }
  .home-method-steps p { margin: 0; font-size: var(--type-body-small-size); color: var(--ink-700); }
  @media (max-width: 960px) { .home-method-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 420px) { .home-method-steps { grid-template-columns: 1fr; } }
</style>
