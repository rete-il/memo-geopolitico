---
import monitores from '../data/monitores.json';

type MonitorCategory =
  | 'seguridad_conflicto'
  | 'infraestructura_estrategica'
  | 'comercio_energia_recursos';

interface MonitorItem {
  id: string;
  orden: number;
  activo: boolean;
  titulo: string;
  categoria: MonitorCategory;
  relevancia_nivel: number;
  atencion_nivel: number;
  dato_clave: string;
  insight: string;
  actualizado: string;
  href?: string;
  fuente_url?: string;
}

type GapKey = 'subcubierto' | 'sobrecubierto' | 'equilibrado';

const categoryLabels: Record<MonitorCategory, string> = {
  seguridad_conflicto: 'Seguridad y conflictos',
  infraestructura_estrategica: 'Infraestructura estratégica',
  comercio_energia_recursos: 'Comercio, energía y recursos',
};

const gapConfig: Record<
  GapKey,
  {
    label: string;
    badgeClass: string;
    borderClass: string;
  }
> = {
  subcubierto: {
    label: 'Subcubierto',
    badgeClass: 'bg-red-100 text-red-700',
    borderClass: 'border-l-red-500',
  },
  sobrecubierto: {
    label: 'Sobrecubierto',
    badgeClass: 'bg-blue-100 text-blue-700',
    borderClass: 'border-l-blue-500',
  },
  equilibrado: {
    label: 'Cobertura equilibrada',
    badgeClass: 'bg-slate-100 text-slate-700',
    borderClass: 'border-l-slate-400',
  },
};

const items = (monitores.friccion_narrativa as MonitorItem[])
  .filter((item) => item.activo)
  .sort(
    (a, b) =>
      a.orden - b.orden ||
      a.titulo.localeCompare(b.titulo, 'es'),
  )
  .slice(0, 4);

function gapKey(item: MonitorItem): GapKey {
  const gap = item.atencion_nivel - item.relevancia_nivel;
  if (gap <= -2) return 'subcubierto';
  if (gap >= 2) return 'sobrecubierto';
  return 'equilibrado';
}

function relevanceClass(level: number): string {
  if (level >= 4) return 'bg-red-600';
  if (level >= 3) return 'bg-orange-500';
  return 'bg-amber-400';
}

function formatDate(value: string): string {
  const parsed = new Date(`${value}T00:00:00`);
  if (Number.isNaN(parsed.getTime())) return value;
  return parsed.toLocaleDateString('es-ES', {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
  });
}
---

{
  items.length > 0 && (
    <aside class="lg:col-span-3 flex w-full flex-col gap-4">
      <section aria-labelledby="relevancia-atencion-title">
        <header class="mb-3 border-b border-slate-300 pb-3">
          <div class="flex items-center gap-2">
            <i
              class="ph ph-chart-scatter text-lg text-slate-500"
              aria-hidden="true"
            />
            <h2
              id="relevancia-atencion-title"
              class="text-xs font-bold uppercase tracking-widest text-slate-900"
            >
              Relevancia vs. atención mediática
            </h2>
          </div>
          <p class="mt-1 text-[11px] leading-relaxed text-slate-500">
            Procesos estratégicos comparados con la atención que reciben.
          </p>
        </header>

        <div class="space-y-3">
          {items.map((item) => {
            const key = gapKey(item);
            const gap = item.atencion_nivel - item.relevancia_nivel;
            const presentation = gapConfig[key];

            return (
              <article
                data-monitor-id={item.id}
                class:list={[
                  'relative rounded-xl border border-l-4 border-slate-200 bg-white p-4 shadow-sm transition-shadow hover:shadow-md',
                  presentation.borderClass,
                ]}
              >
                <div class="mb-3 flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <p class="mb-1 text-[9px] font-bold uppercase tracking-[0.12em] text-slate-400">
                      {categoryLabels[item.categoria]}
                    </p>
                    <h3 class="text-sm font-bold leading-snug text-slate-800">
                      {item.href ? (
                        <a
                          href={item.href}
                          class="rounded-sm hover:text-blue-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
                        >
                          {item.titulo}
                        </a>
                      ) : (
                        item.titulo
                      )}
                    </h3>
                  </div>

                  <span
                    class={`shrink-0 rounded-full px-2 py-1 text-[8px] font-bold uppercase tracking-wider ${presentation.badgeClass}`}
                    title={`Brecha editorial: ${gap > 0 ? '+' : ''}${gap}`}
                  >
                    {presentation.label}
                  </span>
                </div>

                <div class="space-y-2.5">
                  <div>
                    <div class="mb-1 flex justify-between text-[10px] font-semibold uppercase text-slate-500">
                      <span>Relevancia geopolítica</span>
                      <span>{item.relevancia_nivel}/5</span>
                    </div>
                    <div
                      class="flex gap-1"
                      role="img"
                      aria-label={`Relevancia geopolítica ${item.relevancia_nivel} de 5`}
                    >
                      {[1, 2, 3, 4, 5].map((step) => (
                        <span
                          class:list={[
                            'h-1.5 flex-1 rounded-sm',
                            step <= item.relevancia_nivel
                              ? relevanceClass(item.relevancia_nivel)
                              : 'bg-slate-100',
                          ]}
                        />
                      ))}
                    </div>
                  </div>

                  <div>
                    <div class="mb-1 flex justify-between text-[10px] font-semibold uppercase text-slate-500">
                      <span>Atención mediática</span>
                      <span>{item.atencion_nivel}/5</span>
                    </div>
                    <div
                      class="flex gap-1"
                      role="img"
                      aria-label={`Atención mediática ${item.atencion_nivel} de 5`}
                    >
                      {[1, 2, 3, 4, 5].map((step) => (
                        <span
                          class:list={[
                            'h-1.5 flex-1 rounded-sm',
                            step <= item.atencion_nivel
                              ? 'bg-blue-500'
                              : 'bg-slate-100',
                          ]}
                        />
                      ))}
                    </div>
                  </div>
                </div>

                <p class="mt-3 rounded-lg bg-slate-50 px-3 py-2 text-[11px] font-semibold leading-relaxed text-slate-600">
                  {item.dato_clave}
                </p>

                <p class="mt-3 text-xs leading-relaxed text-slate-600">
                  {item.insight}
                </p>

                <div class="mt-3 flex flex-wrap items-center justify-between gap-2 border-t border-slate-100 pt-3 text-[10px] text-slate-400">
                  <time datetime={item.actualizado}>
                    Actualizado: {formatDate(item.actualizado)}
                  </time>

                  <div class="flex items-center gap-3">
                    {item.fuente_url && (
                      <a
                        href={item.fuente_url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-semibold text-slate-500 hover:text-slate-800"
                      >
                        Fuente
                        <span class="sr-only"> de {item.titulo}</span>
                      </a>
                    )}

                    {item.href && (
                      <a
                        href={item.href}
                        class="font-semibold text-blue-600 hover:text-blue-800"
                      >
                        Ver ficha →
                      </a>
                    )}
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    </aside>
  )
}
