---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PreviewBanner from '../components/PreviewBanner.astro';
import { editorialPreviewEnabled } from '../lib/data';
import { pageMetaTitle } from '../../tools/lib/seo-policy.mjs';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  article?: Record<string, unknown>;
  redirectPath?: string;
}

const {
  title = 'Memo Geopolítico',
  description = 'Observatorio y publicaciones sobre procesos geopolíticos de mediano y largo plazo.',
  canonicalPath,
  noindex = false,
  article,
  redirectPath,
} = Astro.props;
const preventIndexing = noindex || editorialPreviewEnabled || import.meta.env.PUBLIC_NOINDEX === 'true';

const fullTitle = pageMetaTitle(title, canonicalPath || Astro.url.pathname);
const canonicalURL = new URL(
  canonicalPath || Astro.url.pathname,
  Astro.site || 'https://memogeopolitico.com',
);
---

<!doctype html>
<html lang="es">
  <head>
    {import.meta.env.PROD && !preventIndexing && (
      <>
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-N879PHE7L2"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){window.dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-N879PHE7L2');
        </script>
      </>
    )}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101c2c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    {redirectPath && <meta http-equiv="refresh" content={`0;url=${redirectPath}`} />}
    {redirectPath && <meta name="memo:redirect" content={redirectPath} />}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={preventIndexing ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="Memo Geopolítico" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        { '@type': 'Organization', '@id': 'https://memogeopolitico.com/#organization', name: 'Memo Geopolítico', url: 'https://memogeopolitico.com/' },
        { '@type': 'WebSite', '@id': 'https://memogeopolitico.com/#website', name: 'Memo Geopolítico', url: 'https://memogeopolitico.com/', inLanguage: 'es', publisher: { '@id': 'https://memogeopolitico.com/#organization' } },
        ...(canonicalURL.pathname !== '/' ? [{ '@type': 'BreadcrumbList', itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://memogeopolitico.com/' },
          { '@type': 'ListItem', position: 2, name: title, item: canonicalURL.href },
        ] }] : []),
        ...(article ? [{ '@type': 'Article', ...article, url: canonicalURL.href, mainEntityOfPage: canonicalURL.href, inLanguage: 'es', publisher: { '@id': 'https://memogeopolitico.com/#organization' } }] : []),
      ],
    }).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    {editorialPreviewEnabled && <PreviewBanner />}
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>
