---
// src/layouts/EssayLayout.astro
interface Props {
  title: string;
  author: string;
  date: Date;
}

const { title, author, date } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>{title} | Memo Geopolítico</title>
  </head>
  <body class="bg-slate-100 text-slate-900 font-sans">
    <main class="py-12 px-4 flex justify-center">
      <article class="w-full max-w-[70ch] bg-white p-8 md:p-12 shadow-sm rounded-md">
        <header class="mb-8 border-b border-slate-200 pb-6">
          <h1 class="text-4xl font-serif font-bold text-slate-900 mb-4">{title}</h1>
          <p class="text-slate-500 text-sm">{author} • {date.toLocaleDateString('es-ES')}</p>
        </header>
        <div class="leading-[1.6] font-serif text-lg text-slate-900">
          <slot />
        </div>
      </article>
    </main>
  </body>
</html>