---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import SupportCTA from '../../components/SupportCTA.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const dossiers = await getCollection('profundidad');
  return dossiers.map((dossier) => ({
    params: { slug: dossier.id },
    props: { dossier },
  }));
}

const { dossier } = Astro.props;
const { Content } = await render(dossier);
const severityConfig = {
  critical: { color: 'bg-red-100 text-red-700 border-red-200', icon: '🔴', label: 'CRÍTICO' },
  high: { color: 'bg-orange-100 text-orange-700 border-orange-200', icon: '🟠', label: 'ALTO' },
  medium: { color: 'bg-amber-100 text-amber-700 border-amber-200', icon: '🟡', label: 'MEDIO' },
  low: { color: 'bg-blue-100 text-blue-700 border-blue-200', icon: '🔵', label: 'BAJO' },
};
const meta = severityConfig[dossier.data.severity as keyof typeof severityConfig];
const absoluteDate = dossier.data.date.toLocaleDateString('es-ES', { day: '2-digit', month: 'long', year: 'numeric' });
---

<Layout title={`${dossier.data.title} | Memo Geopolítico`} description={dossier.data.description}>
  <Header />
  <main class="mx-auto mt-6 mb-12 min-h-screen max-w-3xl rounded-t-xl border-x border-slate-200 bg-white px-6 py-12 shadow-sm">
    <header class="mb-8 border-b border-slate-200 pb-8">
      <div class="mb-5 flex flex-wrap items-center gap-2">
        <span class="rounded-sm bg-slate-800 px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-white">Dossier</span>
        <span class={`ml-2 rounded-full border px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider ${meta.color}`}>{meta.icon} {meta.label}</span>
      </div>
      <h1 class="mb-5 text-4xl font-sans font-bold leading-tight text-slate-900 md:text-5xl">{dossier.data.title}</h1>
      <p class="mb-6 text-lg leading-7 text-slate-600">{dossier.data.description}</p>
      <div class="my-6 flex items-center rounded-xl border border-slate-100 bg-slate-50 p-4 text-sm text-slate-500">
        <time class="font-bold text-slate-700" datetime={dossier.data.date.toISOString()}>{absoluteDate}</time>
      </div>
    </header>
    <div class="prose prose-slate mb-10 max-w-none text-slate-700"><Content /></div>
    {dossier.data.sources && dossier.data.sources.length > 0 && (
      <section class="mt-8 border-t border-slate-200 pt-8">
        <h2 class="mb-6 flex items-center gap-2 text-lg font-bold text-slate-800"><i class="ph ph-article" /> Fuentes</h2>
        <div class="flex flex-col">
          {dossier.data.sources.map((source, index) => (
            <article class="group">
              <a href={source.url} target="_blank" rel="noopener noreferrer" class="mb-2 inline-flex items-center text-[16px] font-semibold text-blue-600 underline transition-colors hover:text-blue-800">
                {source.title}<i class="ph ph-arrow-up-right ml-1 text-blue-500 group-hover:text-blue-800" />
              </a>
              <p class="text-[15px] font-normal leading-[1.6] text-slate-700">{source.summary}</p>
              {index !== dossier.data.sources!.length - 1 && <hr class="my-6 border-slate-100" />}
            </article>
          ))}
        </div>
      </section>
    )}
    <SupportCTA placement="alert" />
  </main>
</Layout>
