---
import { getCollection } from 'astro:content';
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';

const dossiers = (await getCollection('profundidad')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="Dossiers | Memo Geopolítico" description="Análisis autónomos que aportan contexto, actores y escenarios a temas vinculados con las alertas.">
  <Header />
  <main class="mx-auto w-full max-w-5xl px-4 py-10 lg:px-6">
    <header class="mb-8 border-b border-slate-300 pb-6">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-blue-700">Contexto y escenarios</p>
      <h1 class="mt-2 text-4xl font-serif font-bold text-slate-950">Dossiers</h1>
      <p class="mt-3 max-w-3xl text-base leading-7 text-slate-600">
        Profundizaciones autónomas sobre temas de las alertas. No son la continuación de un texto truncado, sino piezas completas con contexto propio.
      </p>
    </header>

    {dossiers.length ? (
      <div class="grid gap-6 md:grid-cols-2">
        {dossiers.map((dossier) => (
          <a href={`/dossiers/${dossier.id}/`} class="group block rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600">
            <article class="h-full rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition-shadow group-hover:shadow-md">
              <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Dossier</p>
              <h2 class="mt-3 text-2xl font-serif font-bold leading-snug text-slate-900 group-hover:text-blue-800">{dossier.data.title}</h2>
              <p class="mt-3 text-sm leading-6 text-slate-600">{dossier.data.listingSummary}</p>
              <span class="mt-5 inline-flex text-sm font-semibold text-blue-700">Abrir dossier →</span>
            </article>
          </a>
        ))}
      </div>
    ) : (
      <p class="rounded-xl border border-slate-200 bg-white p-8 text-slate-600">No hay dossiers publicados.</p>
    )}
  </main>
</Layout>
