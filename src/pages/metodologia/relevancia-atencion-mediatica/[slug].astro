---
import ActionLink from '../../../components/ActionLink.astro';
import PageTitle from '../../../components/PageTitle.astro';
import RatingPair from '../../../components/RatingPair.astro';
import RatingEvidence from '../../../components/RatingEvidence.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { processes, sourceById } from '../../../lib/data';
import { formatDate } from '../../../lib/text';
import {
  getPublicationEntries,
  type PublicationEntry,
} from '../../../lib/publications';
import type { PublicProcess } from '../../../lib/types';

export async function getStaticPaths() {
  const publicationEntries = await getPublicationEntries({
    includePreview: true,
  });
  return processes.map((process) => {
    const publication = publicationEntries.find(
      ({ data }) =>
        data.macroevento_principal_id === process.macroevento_id ||
        data.macroevento_secundario_ids.includes(process.macroevento_id),
    );

    return {
      params: { slug: process.slug },
      props: {
        process,
        publication: publication?.data || null,
      },
    };
  });
}

interface Props {
  process: PublicProcess;
  publication: PublicationEntry['data'] | null;
}

const { process, publication } = Astro.props as Props;
const publicationTitle = publication?.titulo || process.titulo;
const isPublished = publication?.publicacion.estado === 'publicado';
const unassigned = process.estado_evaluacion === 'no_asignada';
const basis = process.fundamento_evaluacion;
---

<SiteLayout
  noindex={true}
  title={`Cómo interpretar los valores de ${publicationTitle}`}
  description={`Estado de desarrollo de los criterios de relevancia, atención mediática y brecha para ${publicationTitle}.`}
>
  <div class="page-shell">
    <header class="methodology-note-hero">
      <p class="eyebrow">{basis ? 'Fundamento de la valoración' : 'Interpretación en desarrollo'}</p>
      <PageTitle>Cómo interpretar los valores de «{publicationTitle}»</PageTitle>
      {basis ? <p class="lead">Fuentes, criterios y límites de la valoración editorial de este proceso.</p> : <p class="lead">
        Esta página reserva un espacio específico para documentar cómo se
        asignaron y cómo deberán leerse las valoraciones de esta publicación.
        Las indicaciones y la evidencia cuantitativa todavía están en
        desarrollo.
      </p>}
      <div class="hero-meta">
        <span>Actualizado {formatDate(basis?.fecha || process.publicacion.actualizado_el)}</span>
        <span>Escala editorial provisional de 1 a 5</span>
      </div>
    </header>

    <div class="methodology-note-layout">
      <article>
        {basis ? <RatingEvidence process={process} sourceById={sourceById} /> : <>
        <aside class="editorial-note development-note">
          <strong>Metodología en desarrollo.</strong>
          <span>
            {unassigned
              ? 'Este expediente todavía no tiene una evaluación numérica asignada. La ausencia de puntuación no representa una valoración baja ni cobertura nula.'
              : 'Estos números son evaluaciones editoriales provisionales. Todavía no constituyen un índice cuantitativo definitivo ni una medición automatizada de cobertura.'}
          </span>
        </aside>

        <section class="content-section">
          <h2>Relevancia</h2>
          <p>
            Expresa una evaluación editorial de la importancia estructural del
            proceso: su impacto potencial, alcance, persistencia y capacidad de
            alterar relaciones de poder, seguridad, conectividad, comercio o
            acceso a recursos.
          </p>
        </section>

        <section class="content-section">
          <h2>Atención mediática</h2>
          <p>
            Expresa la atención periodística observada, considerando no solo el
            volumen sino también la continuidad, diversidad y profundidad de la
            cobertura. En esta etapa todavía depende de revisión editorial y no
            de un recuento exhaustivo.
          </p>
        </section>

        <section class="content-section">
          <h2>Brecha</h2>
          <p>
            Es la diferencia entre Relevancia y Atención mediática. Una brecha
            positiva señala que el proceso parece recibir menos atención que la
            que justificaría su importancia; una brecha negativa puede indicar
            una exposición relativa mayor.
          </p>
        </section>

        <section class="content-section">
          <h2>Qué falta implementar para esta publicación</h2>
          <p>
            Se incorporarán los cortes de cobertura utilizados, el universo de
            fuentes observado, los criterios aplicados a cada dimensión, la
            fecha de medición y las incertidumbres que afecten la comparación.
            La página se actualizará junto con la publicación y su expediente.
          </p>
        </section>

        </>}

        <nav class="methodology-note-actions" aria-label="Enlaces relacionados">
          {
            isPublished && publication && (
              <ActionLink arrow href={`/publicaciones/${publication.slug}/`}>
                Leer publicación
              </ActionLink>
            )
          }
          <ActionLink arrow href={`/observatorio/${process.slug}/`}>
            Abrir expediente
          </ActionLink>
          <ActionLink arrow href="/metodologia/relevancia-atencion-mediatica/">
            Ver metodología general
          </ActionLink>
        </nav>
      </article>

      <aside class="methodology-note-rating">
        <p class="eyebrow">Valores actuales</p>
        <RatingPair
          relevance={process.valoraciones.relevancia_geopolitica}
          attention={process.valoraciones.atencion_mediatica}
          publicationTitle={publicationTitle}
          showMethodLink={false}
        />
        <p>{basis ? `Evaluación documentada al ${formatDate(basis.fecha)}. Las puntuaciones se revisan cuando cambia la evidencia.` : 'Se conservará un historial de cambios cuando la metodología de respaldo quede implementada.'}</p>
      </aside>
    </div>
  </div>
</SiteLayout>
