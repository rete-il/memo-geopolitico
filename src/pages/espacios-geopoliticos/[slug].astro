---
import ProcessCard from '../../components/ProcessCard.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import {
  catalog,
  editorialPreviewEnabled,
  processesForRegion,
} from '../../lib/data';
import type { CatalogItem } from '../../lib/types';

export function getStaticPaths() {
  return catalog('espacios_geopoliticos')
    .filter((item) => processesForRegion(item.id).length > 0)
    .map((item) => ({
      params: { slug: item.slug },
      props: { item },
    }));
}

interface Props {
  item: CatalogItem;
}

const { item } = Astro.props;
const related = processesForRegion(item.id);
---

<SiteLayout title={item.nombre} description={`Procesos vinculados con ${item.nombre}.`}>
  <div class="page-shell">
    <header class="page-intro">
      <div>
        <p class="eyebrow">Espacio geopolítico</p>
        <h1>{item.nombre}</h1>
      </div>
      <p>{related.length} procesos del Observatorio vinculados con este espacio.</p>
    </header>
    <section class="section-shell">
      <div class="process-grid">
        {related.map((process) => (
          <ProcessCard process={process} editorialPreview={editorialPreviewEnabled} />
        ))}
      </div>
    </section>
  </div>
</SiteLayout>
