---
import PageTitle from '../../components/PageTitle.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { mediaRecords } from '../../lib/data';
import { assessedMediaScore } from '../../../tools/lib/media-assessment.mjs';

const unique = (values: string[]) =>
  [...new Set(values.filter(Boolean))].sort((a, b) => a.localeCompare(b, 'es'));

const regions = unique(mediaRecords.map((item) => item.region));
const functions = unique(mediaRecords.map((item) => item.funcion));
const perspectives = unique(mediaRecords.map((item) => item.perspectiva));
const mediaRows = mediaRecords.map(item => ({ ...item, displayScore: assessedMediaScore(item) }));
---

<SiteLayout
  title="Medios"
  description="Directorio profesional de medios y fuentes para análisis geopolítico."
>
  <div class="page-shell">
    <header class="page-intro">
      <div>
        <p class="eyebrow">Directorio de medios</p>
        <PageTitle>Fuentes clasificadas para una lectura crítica</PageTitle>
      </div>
      <p>
        Un directorio de medios, organismos y centros de investigación para
        contrastar información. Permite buscar por región, tipo de cobertura
        y perspectiva, y consultar el uso recomendado de cada fuente.
      </p>
    </header>

    {
      mediaRecords.length ? (
        <>
          <form class="media-toolbar" data-media-filters>
            <label class="sr-only" for="media-search">Buscar medio</label>
            <input id="media-search" type="search" name="q" placeholder="Buscar medio, sede o uso" />
            <label class="sr-only" for="media-region">Región</label>
            <select id="media-region" name="region">
              <option value="">Todas las regiones</option>
              {regions.map((item) => <option value={item}>{item}</option>)}
            </select>
            <label class="sr-only" for="media-function">Función</label>
            <select id="media-function" name="function">
              <option value="">Todas las funciones</option>
              {functions.map((item) => <option value={item}>{item}</option>)}
            </select>
            <label class="sr-only" for="media-perspective">Perspectiva</label>
            <select id="media-perspective" name="perspective">
              <option value="">Todas las perspectivas</option>
              {perspectives.map((item) => <option value={item}>{item}</option>)}
            </select>
          </form>
          <p class="media-summary" data-media-count role="status" aria-live="polite" aria-atomic="true">{mediaRecords.length} medios</p>
          <div class="media-table-wrap">
            <table class="media-table">
              <thead>
                <tr>
                  <th>Medio</th>
                  <th>Región</th>
                  <th>Función</th>
                  <th>Perspectiva</th>
                  <th>Puntuación</th>
                  <th>Uso recomendado</th>
                </tr>
              </thead>
              <tbody>
                {mediaRows.map((item) => (
                  <tr
                    data-media-row
                    data-search={[
                      item.nombre,
                      item.sede,
                      item.region,
                      item.uso,
                      item.perspectiva,
                    ].join(' ').toLowerCase()}
                    data-region={item.region}
                    data-function={item.funcion}
                    data-perspective={item.perspectiva}
                  >
                    <td>
                      <a href={item.url} target="_blank" rel="noopener noreferrer">
                        {item.nombre}
                      </a>
                    </td>
                    <td>{item.region}</td>
                    <td>{item.funcion}</td>
                    <td>{item.perspectiva}</td>
                    <td>{item.displayScore === null ? 'Evaluación pendiente' : <><span class="media-score">{item.displayScore.toFixed(1)}</span>/5</>}</td>
                    <td>{item.uso}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      ) : (
        <section class="section-shell">
          <div class="empty-state">
            <h2>Directorio en preparación</h2>
            <p>Las fuentes se incorporarán a medida que se complete su revisión.</p>
          </div>
        </section>
      )
    }
  </div>

  <script>
    import '../../scripts/media-filters';
  </script>
</SiteLayout>
