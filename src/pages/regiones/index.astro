---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { catalog, processesForRegion } from '../../lib/data';

const items = [
  ...catalog('regiones'),
  ...catalog('subregiones'),
  ...catalog('paises_territorios'),
  ...catalog('espacios_geopoliticos'),
].filter((item) => processesForRegion(item.id).length > 0);
---

<SiteLayout title="Regiones" description="Exploración geográfica del Observatorio.">
  <div class="page-shell">
    <header class="page-intro">
      <div>
        <p class="eyebrow">Explorar</p>
        <h1>Regiones, países y espacios geopolíticos.</h1>
      </div>
      <p>
        La geografía no se reduce a Estados: mares, corredores y zonas
        transfronterizas también organizan procesos.
      </p>
    </header>
    <section class="section-shell">
      <div class="explore-grid">
        {items.map((item) => (
          <article class="explore-card">
            <h2>{item.nombre}</h2>
            <p>{processesForRegion(item.id).length} procesos relacionados.</p>
            <a href={`/regiones/${item.slug}/`}>Abrir</a>
          </article>
        ))}
      </div>
    </section>
  </div>
</SiteLayout>
