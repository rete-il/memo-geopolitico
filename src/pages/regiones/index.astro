---
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';
import { regionNavigation } from '../../config/regions';
---

<Layout title="Regiones | Memo Geopolítico" description="Exploración geográfica de los contenidos de Memo Geopolítico.">
  <Header />
  <main class="mx-auto w-full max-w-5xl px-4 py-10 lg:px-6">
    <header class="mb-8 border-b border-slate-300 pb-6">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-500">Explorar</p>
      <h1 class="mt-2 text-4xl font-serif font-bold text-slate-950">Regiones</h1>
      <p class="mt-3 max-w-3xl leading-7 text-slate-600">
        Una puerta de entrada geográfica a alertas, focos y dossiers. Por el momento,
        las subregiones con contenido publicado enlazan directamente a los focos existentes.
      </p>
    </header>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {regionNavigation.map((region) => (
        <article id={region.id} class="scroll-mt-32 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <h2 class="text-xl font-serif font-bold text-slate-900">{region.label}</h2>
          <p class="mt-3 text-sm leading-6 text-slate-600">{region.description}</p>

          {region.children?.length ? (
            <ul class="mt-5 space-y-2 border-t border-slate-100 pt-4">
              {region.children.map((child) => (
                <li>
                  <a
                    href={child.href}
                    class="inline-flex items-center gap-1 text-sm font-semibold text-blue-700 transition-colors hover:text-blue-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2"
                  >
                    {child.label}
                    <i class="ph ph-arrow-right" aria-hidden="true"></i>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-5 border-t border-slate-100 pt-4 text-xs text-slate-400">
              Sin subregiones publicadas todavía.
            </p>
          )}
        </article>
      ))}
    </div>
  </main>
</Layout>
