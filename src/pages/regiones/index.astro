---
import PageTitle from '../../components/PageTitle.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { processesForRegion } from '../../lib/data';
import { geographicEntries } from '../../lib/seo';

const items = geographicEntries;
---

<SiteLayout title="Regiones" description="Exploración geográfica del Observatorio.">
  <div class="page-shell">
    <header class="page-intro">
      <div>
        <p class="eyebrow">Explorar</p>
        <PageTitle>Regiones, países y espacios geopolíticos</PageTitle>
      </div>
      <p>
        La geografía no se reduce a Estados: mares, corredores y zonas
        transfronterizas también organizan procesos.
      </p>
    </header>
    <section class="section-shell">
      <div class="explore-grid">
        {items.map(({ item, path }) => (
          <article class="explore-card">
            <h2>{item.nombre}</h2>
            <p>{processesForRegion(item.id).length} procesos relacionados.</p>
            <a href={path}>Abrir</a>
          </article>
        ))}
      </div>
    </section>
  </div>
</SiteLayout>
