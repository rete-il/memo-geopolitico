---
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';

const regions = [
  ['África', 'Norte, Sahel, África Occidental, Central, Oriental y Austral.'],
  ['Asia', 'Asia Oriental, Meridional, Central y Sudoriental.'],
  ['Europa', 'Europa occidental, central, oriental, nórdica y balcánica.'],
  ['Medio Oriente', 'Levante, península arábiga, Irán y espacios transregionales.'],
  ['Américas', 'América del Norte, América Latina y el Caribe.'],
  ['Oceanía', 'Australia, Nueva Zelanda y el Pacífico insular.'],
];
---

<Layout title="Regiones | Memo Geopolítico" description="Exploración geográfica de los contenidos de Memo Geopolítico.">
  <Header />
  <main class="mx-auto w-full max-w-5xl px-4 py-10 lg:px-6">
    <header class="mb-8 border-b border-slate-300 pb-6">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-500">Explorar</p>
      <h1 class="mt-2 text-4xl font-serif font-bold text-slate-950">Regiones</h1>
      <p class="mt-3 max-w-3xl leading-7 text-slate-600">Una puerta de entrada geográfica a alertas, focos y dossiers. La taxonomía se ampliará sin confundir continentes, subregiones y teatros transregionales.</p>
    </header>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {regions.map(([name, description]) => (
        <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <h2 class="text-xl font-serif font-bold text-slate-900">{name}</h2>
          <p class="mt-3 text-sm leading-6 text-slate-600">{description}</p>
        </article>
      ))}
    </div>
  </main>
</Layout>
