---
import PageTitle from '../../components/PageTitle.astro';
import CanonicalRedirect from '../../components/CanonicalRedirect.astro';
import ProcessCard from '../../components/ProcessCard.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import {
  editorialPreviewEnabled,
  processesForRegion,
} from '../../lib/data';
import type { CatalogItem } from '../../lib/types';
import { geographicEntries } from '../../lib/seo';

export function getStaticPaths() {
  return geographicEntries.flatMap(({ item, path, aliases }) =>
    [path, ...aliases].filter(route => route.startsWith('/regiones/')).map(route => ({
      params: { slug: route.split('/')[2] },
      props: { item, canonicalPath: path },
    })),
  );
}

interface Props {
  item: CatalogItem;
  canonicalPath: string;
}

const { item, canonicalPath } = Astro.props;
const related = processesForRegion(item.id);
---

{canonicalPath !== Astro.url.pathname ? (
  <CanonicalRedirect title={item.nombre} destination={canonicalPath} />
) : (
<SiteLayout title={item.nombre} description={`Procesos vinculados con ${item.nombre}.`}>
  <div class="page-shell">
    <header class="page-intro">
      <div>
        <p class="eyebrow">Geografía</p>
        <PageTitle>{item.nombre}</PageTitle>
      </div>
      <p>{related.length} procesos del Observatorio vinculados con esta geografía.</p>
    </header>
    <section class="section-shell">
      <div class="process-grid">
        {related.map((process) => (
          <ProcessCard
            process={process}
            editorialPreview={editorialPreviewEnabled}
            currentGeographyId={item.id}
          />
        ))}
      </div>
    </section>
  </div>
</SiteLayout>
)}
