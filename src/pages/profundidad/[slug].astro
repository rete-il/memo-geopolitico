---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const paginas = await getCollection('profundidad');
  return paginas.map((pagina) => ({
    params: { slug: pagina.id },
    props: { pagina },
  }));
}

const { pagina } = Astro.props;
const { Content } = await render(pagina);

const severityConfig = {
  critical: {
    color: 'bg-red-100 text-red-700 border-red-200',
    icon: '🔴',
    label: 'CRÍTICO',
  },
  high: {
    color: 'bg-orange-100 text-orange-700 border-orange-200',
    icon: '🟠',
    label: 'ALTO',
  },
  medium: {
    color: 'bg-amber-100 text-amber-700 border-amber-200',
    icon: '🟡',
    label: 'MEDIO',
  },
  low: {
    color: 'bg-blue-100 text-blue-700 border-blue-200',
    icon: '🔵',
    label: 'BAJO',
  },
};
const meta =
  severityConfig[pagina.data.severity as keyof typeof severityConfig];
const absoluteDate = new Date(pagina.data.date).toLocaleDateString('es-ES', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});
---

<Layout>
  <!-- Barra de navegación superior unificada -->
  <header class="bg-slate-900 text-white sticky top-0 z-50 shadow-md">
    <div
      class="max-w-screen-2xl mx-auto px-4 lg:px-6 h-16 flex items-center justify-between"
    >
      <a
        href="/"
        class="flex items-center gap-2 hover:opacity-80 transition-opacity"
      >
        <span
          class="text-xl font-bold tracking-tight uppercase font-sans flex items-center gap-2"
        >
          <span class="text-red-600 text-2xl">🌍</span> Memo Geopolítico
        </span>
      </a>
      <a
        href="/"
        class="text-sm font-medium text-gray-300 hover:text-white transition-colors"
      >
        &larr; Volver al Panorama
      </a>
    </div>
  </header>

  <!-- Contenedor principal estandarizado -->
  <main
    class="max-w-3xl mx-auto px-6 py-12 bg-white min-h-screen shadow-sm border-x border-slate-200 mt-6 mb-12 rounded-t-xl"
  >
    <header class="mb-8 border-b border-slate-200 pb-8">
      <div class="flex items-center gap-2 mb-5">
        <span
          class="px-3 py-1 bg-slate-800 text-white text-[10px] font-bold rounded-sm uppercase tracking-widest"
        >
          Alerta en Profundidad
        </span>
        <span
          class={`px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider border ${meta.color} ml-2`}
        >
          {meta.icon}
          {meta.label}
        </span>
      </div>

      <h1
        class="text-4xl md:text-5xl font-sans font-bold text-slate-900 mb-6 leading-tight"
      >
        {pagina.data.title}
      </h1>

      <div
        class="flex items-center text-sm text-slate-500 font-sans bg-slate-50 p-4 rounded-xl border border-slate-100 my-6"
      >
        <time
          class="font-bold text-slate-700"
          datetime={pagina.data.date.toISOString()}
        >
          {absoluteDate}
        </time>
      </div>
    </header>

    <div class="prose prose-slate max-w-none mb-10 text-slate-700">
      <Content />
    </div>

    {
      pagina.data.sources && pagina.data.sources.length > 0 && (
        <section class="border-t border-slate-200 pt-8 mt-8">
          <h2 class="text-lg font-bold text-slate-800 mb-6 flex items-center gap-2">
            <i class="ph ph-article" /> Fuentes de Inteligencia
          </h2>
          <div class="flex flex-col">
            {pagina.data.sources.map((source, index) => (
              <article class="group">
                <a
                  href={source.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center text-[16px] font-semibold text-blue-600 underline hover:text-blue-800 transition-colors mb-2"
                >
                  {source.title}
                  <i class="ph ph-arrow-up-right ml-1 text-blue-500 group-hover:text-blue-800" />
                </a>
                <p class="text-[15px] font-normal text-slate-700 leading-[1.6]">
                  {source.summary}
                </p>
                {index !== pagina.data.sources!.length - 1 && (
                  <hr class="border-slate-100 my-6" />
                )}
              </article>
            ))}
          </div>
        </section>
      )
    }

    <section
      class="mt-12 p-6 bg-white border border-slate-200 rounded-lg text-center shadow-sm"
    >
      <h3 class="text-lg font-bold text-slate-900 mb-2">
        ¿Valorás este análisis?
      </h3>
      <p class="text-[15px] text-slate-600 mb-6">
        El contenido de Memo Geopolítico es independiente. Tu apoyo permite
        mantener el servidor y las fuentes activas.
      </p>
      <a
        href="https://ko-fi.com/tu_usuario"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center px-6 py-2.5 rounded-md font-semibold text-white bg-slate-900 hover:bg-slate-800 transition-colors"
      >
        Apoyar en Ko-fi
      </a>
    </section>
  </main>
</Layout>
