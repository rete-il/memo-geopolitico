---
import PageTitle from '../../../components/PageTitle.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import {
  catalog,
  catalogMaps,
  processes,
  sources,
} from '../../../lib/data';
import { effectiveEditorialState } from '../../../lib/editorial';
import {
  editorialStageLabel,
  formatDate,
  humanize,
} from '../../../lib/text';
import { getPublicationEntries } from '../../../lib/publications';
import { processSearchText } from '../../../../tools/lib/search-policy.mjs';
import { groupMatrixProcesses } from '../../../../tools/lib/matrix-groups.mjs';

const publicationEntries = await getPublicationEntries({
  includePreview: true,
});
const stateFor = (process: (typeof processes)[number]) =>
  effectiveEditorialState(process, publicationEntries);

const regions = catalog('regiones').filter((region) =>
  processes.some((process) =>
    process.clasificacion.geografia.region_ids.includes(region.id),
  ),
);
const themes = catalog('temas').filter((theme) =>
  processes.some(
    (process) =>
      process.clasificacion.tema_principal_id === theme.id ||
      process.clasificacion.tema_secundario_ids.includes(theme.id),
  ),
);
const signals = processes
  .flatMap((process) =>
    process.senales.map((signal) => ({
      ...signal,
      processSlug: process.slug,
      processTitle: process.titulo,
    })),
  )
  .sort((a, b) => b.fecha.localeCompare(a.fecha));
const ranked = [...processes].sort(
  (a, b) =>
    b.valoraciones.relevancia_geopolitica -
      a.valoraciones.relevancia_geopolitica ||
    b.valoraciones.brecha - a.valoraciones.brecha,
);
const publishedCount = processes.filter(
  (process) => stateFor(process) === 'publicado',
).length;
const inProgressCount = processes.length - publishedCount;
const verifiedSources = sources.filter(
  (source) => source.estado_verificacion === 'verificada',
);
const lastProcessUpdate = formatDate(
  [...processes]
    .map((process) => process.publicacion.actualizado_el)
    .sort()
    .at(-1),
);
const taxonomySections = [
  { label: 'Temas', items: catalog('temas'), href: '/temas/' },
  { label: 'Regiones', items: catalog('regiones'), href: '/regiones/' },
  {
    label: 'Espacios geopolíticos',
    items: catalog('espacios_geopoliticos'),
    href: '/espacios-geopoliticos/',
  },
  { label: 'Actores', items: catalog('actores'), href: '/actores/' },
];

const dashboardSections = [
  ['panorama', 'Panorama'], ['procesos', 'Procesos'], ['matriz', 'Matriz'],
  ['senales', 'Señales'], ['fuentes', 'Fuentes'], ['expedientes', 'Expedientes'],
  ['taxonomia', 'Clasificaciones'],
];
const matrixGroups = groupMatrixProcesses(processes);
const pointPosition = (value: number) => 6 + ((value - 1) / 4) * 88;
---

<SiteLayout
  title="Panel del Observatorio"
  description="Vista pública de consulta del Observatorio de Memo Geopolítico: procesos, señales, fuentes, matriz y avance editorial."
>
  <div class="dashboard-page-shell">
    <header class="dashboard-page-intro">
      <div>
        <p class="eyebrow">Observatorio</p>
        <PageTitle>Panel de seguimiento</PageTitle>
        <p>
          Procesos geopolíticos, acontecimientos y fuentes reunidos para
          comparar su importancia, su atención mediática y el avance de la investigación.
        </p>
      </div>
      <a class="button-secondary" href="/observatorio/">Volver al Observatorio</a>
    </header>

    <aside class="dashboard-readonly-notice">
      <strong>Cómo consultar el panel.</strong>
      <span>
        Las pestañas permiten explorar los procesos y sus fuentes. Cada expediente
        reúne el seguimiento del tema y los análisis disponibles.
      </span>
    </aside>

    <div class="public-observatory-dashboard" data-public-dashboard>
      <aside class="dashboard-sidebar">
        <div class="dashboard-brand">
          <span aria-hidden="true">MG</span>
          <div>
            <strong>Observatorio</strong>
            <small>Consulta pública</small>
          </div>
        </div>
        <nav
          class="dashboard-navigation"
          aria-label="Secciones del panel"
          role="tablist"
          aria-orientation="vertical"
          data-dashboard-tabs
        >
          {dashboardSections.map(([id, label], index) => (
            <button type="button" role="tab" id={`dashboard-tab-${id}`}
              aria-controls={id} aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1} data-dashboard-nav={id} data-tab={id}>
              {label}
            </button>
          ))}
        </nav>
        <footer>
          <strong>Última revisión de procesos</strong>
          <small>{lastProcessUpdate}</small>
        </footer>
      </aside>

      <div class="dashboard-workspace">
        <header class="dashboard-topbar">
          <div>
            <p class="eyebrow">Panel de seguimiento</p>
            <h2 data-dashboard-title>Panorama</h2>
          </div>
          <span class="readonly-badge">Solo consulta</span>
        </header>

        <section
          class="dashboard-view"
          data-dashboard-view="panorama"
          id="panorama" role="tabpanel" aria-labelledby="dashboard-tab-panorama" tabindex="0"
        >
          <div class="dashboard-heading">
            <div>
              <p class="eyebrow">Investigaciones del Observatorio</p>
              <h3>Panorama editorial</h3>
            </div>
            <p>Procesos en seguimiento y análisis publicados.</p>
          </div>

          <div class="dashboard-metrics">
            <article>
              <span>Procesos</span>
              <strong>{processes.length}</strong>
              <small>expedientes visibles</small>
            </article>
            <article>
              <span>Procesos con análisis</span>
              <strong>{publishedCount}</strong>
              <small>cuentan con una publicación</small>
            </article>
            <article>
              <span>En curso</span>
              <strong>{inProgressCount}</strong>
              <small>documentación y revisión</small>
            </article>
            <article>
              <span>Señales</span>
              <strong>{signals.length}</strong>
              <small>con fuente vinculada</small>
            </article>
            <article>
              <span>Fuentes</span>
              <strong>{verifiedSources.length}</strong>
              <small>verificadas y expuestas</small>
            </article>
          </div>

          <div class="dashboard-grid">
            <article class="dashboard-panel">
              <header>
                <div>
                  <p class="eyebrow">Prioridad estructural</p>
                  <h3>Mayor relevancia</h3>
                </div>
              </header>
              <ol class="dashboard-ranking">
                {
                  ranked.slice(0, 6).map((process, index) => (
                    <li>
                      <span>{index + 1}</span>
                      <a href={`/observatorio/${process.slug}/`}>
                        <strong>{process.titulo}</strong>
                        <small>{editorialStageLabel(stateFor(process))}</small>
                      </a>
                      <b>{process.valoraciones.relevancia_geopolitica.toFixed(1)}</b>
                    </li>
                  ))
                }
              </ol>
            </article>

            <article class="dashboard-panel">
              <header>
                <div>
                  <p class="eyebrow">Estado de las investigaciones</p>
                  <h3>Avance editorial</h3>
                </div>
              </header>
              <div class="dashboard-status-list">
                {
                  [
                    ['borrador', 'En documentación'],
                    ['en_revision', 'En revisión editorial'],
                    ['listo', 'Listo para publicación'],
                    ['publicado', 'Publicado'],
                  ].map(([state, label]) => {
                    const count = processes.filter(
                      (process) => stateFor(process) === state,
                    ).length;
                    const width = processes.length
                      ? `${Math.max(2, (count / processes.length) * 100)}%`
                      : '0%';
                    return (
                      <div>
                        <span>{label}</span>
                        <i><b style={`width:${width}`}></b></i>
                        <strong>{count}</strong>
                      </div>
                    );
                  })
                }
              </div>
            </article>
          </div>
        </section>

        <section
          class="dashboard-view"
          data-dashboard-view="procesos"
          id="procesos" role="tabpanel" aria-labelledby="dashboard-tab-procesos" tabindex="0"
          hidden
        >
          <div class="dashboard-heading">
            <div>
              <p class="eyebrow">Macroeventos</p>
              <h3>Procesos geopolíticos</h3>
            </div>
            <p data-dashboard-results-count role="status" aria-live="polite" aria-atomic="true">{processes.length} procesos</p>
          </div>

          <form class="dashboard-filters" data-dashboard-filters>
            <label class="grow">
              <span>Buscar</span>
              <input type="search" name="q" placeholder="Título, actor, región o tema" />
            </label>
            <label>
              <span>Estado editorial</span>
              <select name="state">
                <option value="">Todos</option>
                <option value="borrador">En documentación</option>
                <option value="en_revision">En revisión editorial</option>
                <option value="listo">Listo para publicación</option>
                <option value="publicado">Publicado</option>
              </select>
            </label>
            <label>
              <span>Región</span>
              <select name="region">
                <option value="">Todas</option>
                {regions.map((region) => <option value={region.id}>{region.nombre}</option>)}
              </select>
            </label>
            <label>
              <span>Tema</span>
              <select name="theme">
                <option value="">Todos</option>
                {themes.map((theme) => <option value={theme.id}>{theme.nombre}</option>)}
              </select>
            </label>
            <button type="reset">Restablecer</button>
          </form>

          <div class="dashboard-table-panel">
            <div class="dashboard-table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Proceso</th>
                    <th>Estado</th>
                    <th>Región</th>
                    <th>Tema</th>
                    <th>Relevancia</th>
                    <th>Atención</th>
                    <th>Brecha</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    processes.map((process) => {
                      const themeId = process.clasificacion.tema_principal_id || '';
                      const regionIds = process.clasificacion.geografia.region_ids;
                      const regionNames = regionIds
                        .map((id) => catalogMaps.regiones.get(id)?.nombre)
                        .filter(Boolean)
                        .join(', ');
                      const themeName = themeId
                        ? catalogMaps.temas.get(themeId)?.nombre || 'Sin tema'
                        : 'Sin tema';
                      const state = stateFor(process);
                      const search = processSearchText(process, catalogMaps);
                      return (
                        <tr
                          data-dashboard-process
                          data-search={search}
                          data-state={state}
                          data-region={regionIds.join(' ')}
                          data-theme={[
                            themeId,
                            ...process.clasificacion.tema_secundario_ids,
                            ...process.clasificacion.subtema_ids,
                          ].filter(Boolean).join(' ')}
                        >
                          <td>
                            <a href={`/observatorio/${process.slug}/`}>
                              <strong>{process.titulo}</strong>
                            </a>
                            <small>{process.sintesis}</small>
                          </td>
                          <td><span class={`dashboard-state dashboard-state--${state}`}>{editorialStageLabel(state)}</span></td>
                          <td>{regionNames || 'Global'}</td>
                          <td>{themeName}</td>
                          <td><b class="dashboard-score">{process.valoraciones.relevancia_geopolitica.toFixed(1)}</b></td>
                          <td><b class="dashboard-score">{process.valoraciones.atencion_mediatica.toFixed(1)}</b></td>
                          <td><b class:list={['dashboard-score', { 'dashboard-score--gap': process.valoraciones.brecha > 0 }]}>{process.valoraciones.brecha > 0 ? '+' : ''}{process.valoraciones.brecha.toFixed(1)}</b></td>
                        </tr>
                      );
                    })
                  }
                </tbody>
              </table>
            </div>
          </div>
          <p class="dashboard-empty" data-dashboard-filter-empty hidden>
            Ningún proceso coincide con los filtros.
          </p>
        </section>

        <section
          class="dashboard-view"
          data-dashboard-view="matriz"
          id="matriz" role="tabpanel" aria-labelledby="dashboard-tab-matriz" tabindex="0"
          hidden
        >
          <div class="dashboard-heading">
            <div>
              <p class="eyebrow">Comparación editorial</p>
              <h3>Matriz de relevancia y atención</h3>
            </div>
            <p>Escala de 1 a 5. Cada círculo indica cuántos procesos comparten una valoración.</p>
          </div>
          <div class="dashboard-matrix" aria-label="Matriz de procesos">
            <span class="matrix-label matrix-label--top-left">Alta relevancia · baja atención</span>
            <span class="matrix-label matrix-label--top-right">Alta relevancia · alta atención</span>
            <span class="matrix-label matrix-label--bottom-left">Baja relevancia · baja atención</span>
            <span class="matrix-label matrix-label--bottom-right">Baja relevancia · alta atención</span>
            {
              matrixGroups.map((group) => (
                <button type="button"
                  class="dashboard-matrix-point"
                  data-matrix-group={group.id} aria-controls={group.id} aria-expanded="false"
                  style={`left:${pointPosition(group.attention)}%;bottom:${pointPosition(group.relevance)}%`}
                  aria-label={`${group.processes.length} ${group.processes.length === 1 ? 'proceso' : 'procesos'}: relevancia ${group.relevance}, atención ${group.attention}. Ver lista`}
                >
                  {group.processes.length}
                </button>
              ))
            }
          </div>
          <div class="dashboard-axis dashboard-axis--x">Atención mediática 1 → 5</div>
          <div class="dashboard-matrix-groups">
            <h4>Procesos por valoración</h4>
            <p>Los mismos grupos se pueden consultar en esta lista.</p>
            {matrixGroups.map(group => (
              <details id={group.id}>
                <summary>Relevancia {group.relevance} · Atención {group.attention} — {group.processes.length} {group.processes.length === 1 ? 'proceso' : 'procesos'}</summary>
                <ul>{group.processes.map(process => <li><a href={`/observatorio/${process.slug}/`}>{process.titulo}</a></li>)}</ul>
              </details>
            ))}
          </div>
          <div class="dashboard-matrix-note">
            <a href="/metodologia/relevancia-atencion-mediatica/">
              Cómo se están definiendo estas valoraciones
            </a>
          </div>
        </section>

        <section
          class="dashboard-view"
          data-dashboard-view="senales"
          id="senales" role="tabpanel" aria-labelledby="dashboard-tab-senales" tabindex="0"
          hidden
        >
          <div class="dashboard-heading">
            <div>
              <p class="eyebrow">Evidencia trazable</p>
              <h3>Señales expuestas</h3>
            </div>
            <p>{signals.length} señales con fuente vinculada</p>
          </div>
          <div class="dashboard-table-panel">
            <div class="dashboard-table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Fecha</th>
                    <th>Señal</th>
                    <th>Proceso</th>
                    <th>Verificación</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    signals.map((signal) => (
                      <tr>
                        <td>{formatDate(signal.fecha)}</td>
                        <td>
                          <strong>{signal.titulo}</strong>
                          <small>{signal.resumen}</small>
                        </td>
                        <td><a href={`/observatorio/${signal.processSlug}/`}>{signal.processTitle}</a></td>
                        <td><span class="dashboard-state dashboard-state--publicado">{humanize(signal.estado_verificacion)}</span></td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <section
          class="dashboard-view"
          data-dashboard-view="fuentes"
          id="fuentes" role="tabpanel" aria-labelledby="dashboard-tab-fuentes" tabindex="0"
          hidden
        >
          <div class="dashboard-heading">
            <div>
              <p class="eyebrow">Fuentes públicas</p>
              <h3>Documentación expuesta</h3>
            </div>
            <p>{sources.length} fuentes aptas para consulta pública</p>
          </div>
          <div class="dashboard-table-panel">
            <div class="dashboard-table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Medio</th>
                    <th>Publicación</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    sources.map((source) => (
                      <tr>
                        <td>{source.medio}</td>
                        <td>
                          <a href={source.url} target="_blank" rel="noopener noreferrer">
                            <strong>{source.titulo || source.medio}</strong>
                          </a>
                          <small>{source.tipo} · {source.idioma}</small>
                        </td>
                        <td>{formatDate(source.fecha)}</td>
                        <td><span class="dashboard-state dashboard-state--publicado">{humanize(source.estado_verificacion)}</span></td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <section
          class="dashboard-view"
          data-dashboard-view="expedientes"
          id="expedientes" role="tabpanel" aria-labelledby="dashboard-tab-expedientes" tabindex="0"
          hidden
        >
          <div class="dashboard-heading">
            <div>
              <p class="eyebrow">Seguimiento público</p>
              <h3>Expedientes y próximos pasos</h3>
            </div>
            <p>{processes.length} expedientes</p>
          </div>
          <div class="dashboard-expedients">
            {
              processes.map((process) => {
                const state = stateFor(process);
                return (
                  <article>
                    <div>
                      <span class={`dashboard-state dashboard-state--${state}`}>
                        {editorialStageLabel(state)}
                      </span>
                      <h4><a href={`/observatorio/${process.slug}/`}>{process.titulo}</a></h4>
                      <p>{process.progreso_publico.proximo_paso}</p>
                    </div>
                    <dl>
                      <div>
                        <dt>Actualizado</dt>
                        <dd>{formatDate(process.publicacion.actualizado_el)}</dd>
                      </div>
                      <div>
                        <dt>Hitos</dt>
                        <dd>{process.progreso_publico.hitos_completados.length}</dd>
                      </div>
                    </dl>
                  </article>
                );
              })
            }
          </div>
        </section>

        <section
          class="dashboard-view"
          data-dashboard-view="taxonomia"
          id="taxonomia" role="tabpanel" aria-labelledby="dashboard-tab-taxonomia" tabindex="0"
          hidden
        >
          <div class="dashboard-heading">
            <div>
              <p class="eyebrow">Clasificación</p>
              <h3>Clasificaciones del Observatorio</h3>
            </div>
            <p>Ejes utilizados por los expedientes visibles.</p>
          </div>
          <div class="dashboard-taxonomy">
            {
              taxonomySections.map(({ label, items, href }) => (
                <article>
                  <span>{items.length}</span>
                  <h4>{label}</h4>
                  <p>Categorías utilizadas en los expedientes.</p>
                  <a href={href}>Explorar</a>
                </article>
              ))
            }
          </div>
        </section>
      </div>
    </div>
  </div>

  <script>
    import '../../../scripts/public-observatory-dashboard';
  </script>
</SiteLayout>
