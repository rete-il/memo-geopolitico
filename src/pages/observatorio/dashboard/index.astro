---
import ActionLink from '../../../components/ActionLink.astro';
import { compareProcessRatings, hasAssignedRatings } from '../../../../tools/lib/editorial-ratings.mjs';
import PageTitle from '../../../components/PageTitle.astro';
import DashboardOverview from '../../../components/observatory/DashboardOverview.astro';
import DashboardProcesses from '../../../components/observatory/DashboardProcesses.astro';
import DashboardMatrix from '../../../components/observatory/DashboardMatrix.astro';
import DashboardSignals from '../../../components/observatory/DashboardSignals.astro';
import DashboardSources from '../../../components/observatory/DashboardSources.astro';
import DashboardExpedients from '../../../components/observatory/DashboardExpedients.astro';
import DashboardTaxonomy from '../../../components/observatory/DashboardTaxonomy.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import {
  catalog,
  processes,
  sources,
} from '../../../lib/data';
import { effectiveEditorialState } from '../../../lib/editorial';
import { formatDate } from '../../../lib/text';
import { getPublicationEntries } from '../../../lib/publications';

const publicationEntries = await getPublicationEntries({
  includePreview: true,
});
const stateFor = (process: (typeof processes)[number]) =>
  effectiveEditorialState(process, publicationEntries);

const regions = catalog('regiones').filter((region) =>
  processes.some((process) =>
    process.clasificacion.geografia.region_ids.includes(region.id),
  ),
);
const themes = catalog('temas').filter((theme) =>
  processes.some(
    (process) =>
      process.clasificacion.tema_principal_id === theme.id ||
      process.clasificacion.tema_secundario_ids.includes(theme.id),
  ),
);
const signals = processes
  .flatMap((process) =>
    process.senales.map((signal) => ({
      ...signal,
      processSlug: process.slug,
      processTitle: process.titulo,
    })),
  )
  .sort((a, b) => b.fecha.localeCompare(a.fecha));
const ranked = processes.filter(hasAssignedRatings).sort(compareProcessRatings);
const unassignedCount = processes.length - ranked.length;
const publishedCount = processes.filter(
  (process) => stateFor(process) === 'publicado',
).length;
const inProgressCount = processes.length - publishedCount;
const verifiedSources = sources.filter(
  (source) => source.estado_verificacion === 'verificada',
);
const lastProcessUpdate = formatDate(
  [...processes]
    .map((process) => process.publicacion.actualizado_el)
    .sort()
    .at(-1),
);
const taxonomySections = [
  { label: 'Temas', items: catalog('temas'), href: '/temas/' },
  { label: 'Regiones', items: catalog('regiones'), href: '/regiones/' },
  {
    label: 'Espacios geopolíticos',
    items: catalog('espacios_geopoliticos'),
    href: '/espacios-geopoliticos/',
  },
  { label: 'Actores', items: catalog('actores'), href: '/actores/' },
];

const dashboardSections = [
  ['panorama', 'Panorama'], ['procesos', 'Procesos'], ['matriz', 'Matriz'],
  ['senales', 'Señales'], ['fuentes', 'Fuentes'], ['expedientes', 'Expedientes'],
  ['taxonomia', 'Clasificaciones'],
];
---

<SiteLayout
  title="Panel del Observatorio"
  description="Vista pública de consulta del Observatorio de Memo Geopolítico: procesos, señales, fuentes, matriz y avance editorial."
>
  <div class="dashboard-page-shell">
    <header class="dashboard-page-intro">
      <div>
        <p class="eyebrow">Observatorio</p>
        <PageTitle>Panel de seguimiento</PageTitle>
        <p>
          Procesos geopolíticos, acontecimientos y fuentes reunidos para
          comparar su importancia, su atención mediática y el avance de la investigación.
        </p>
      </div>
      <ActionLink arrow href="/observatorio/">Volver al Observatorio</ActionLink>
    </header>

    <aside class="dashboard-readonly-notice">
      <strong>Cómo consultar el panel.</strong>
      <span>
        Las pestañas permiten explorar los procesos y sus fuentes. Cada expediente
        reúne el seguimiento del tema y los análisis disponibles.
      </span>
    </aside>

    <div class="public-observatory-dashboard" data-public-dashboard>
      <aside class="dashboard-sidebar">
        <div class="dashboard-brand">
          <span aria-hidden="true">MG</span>
          <div>
            <strong>Observatorio</strong>
            <small>Consulta pública</small>
          </div>
        </div>
        <nav
          class="dashboard-navigation"
          aria-label="Secciones del panel"
          role="tablist"
          aria-orientation="vertical"
          data-dashboard-tabs
        >
          {dashboardSections.map(([id, label], index) => (
            <button type="button" role="tab" id={`dashboard-tab-${id}`}
              aria-controls={id} aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1} data-dashboard-nav={id} data-tab={id}>
              {label}
            </button>
          ))}
        </nav>
        <footer>
          <strong>Última revisión de procesos</strong>
          <small>{lastProcessUpdate}</small>
        </footer>
      </aside>

      <div class="dashboard-workspace">
        <header class="dashboard-topbar">
          <div>
            <p class="eyebrow">Panel de seguimiento</p>
            <h2 data-dashboard-title>Panorama</h2>
          </div>
          <span class="readonly-badge">Solo consulta</span>
        </header>

        <DashboardOverview processes={processes} stateFor={stateFor} ranked={ranked}
          publishedCount={publishedCount} inProgressCount={inProgressCount}
          signalCount={signals.length} verifiedSourceCount={verifiedSources.length} />

        <DashboardProcesses processes={processes} stateFor={stateFor} regions={regions} themes={themes} />

        <DashboardMatrix processes={processes} unassignedCount={unassignedCount} />

        <DashboardSignals signals={signals} />

        <DashboardSources sources={sources} />

        <DashboardExpedients processes={processes} stateFor={stateFor} />

        <DashboardTaxonomy taxonomySections={taxonomySections} />

      </div>
    </div>
  </div>

  <script>
    import '../../../scripts/public-observatory-dashboard';
  </script>
</SiteLayout>
