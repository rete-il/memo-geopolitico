---
import { compareProcessRelevance } from '../../../../tools/lib/editorial-ratings.mjs';
import RectorCard from '../../../components/observatory/RectorCard.astro';
import EditorialImage from '../../../components/EditorialImage.astro';
import ActionLink from '../../../components/ActionLink.astro';
import PageTitle from '../../../components/PageTitle.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { processes } from '../../../lib/data';
import {
  effectiveEditorialState,
  relatedPublicationForProcess,
} from '../../../lib/editorial';
import { getPublicationEntries } from '../../../lib/publications';
import { groupRectorProcesses } from '../../../lib/process-relations';
import { siteRoutes } from '../../../config/routes';

const publicationEntries = await getPublicationEntries({
  includePreview: true,
});

const publicationFor = (process: (typeof processes)[number]) =>
  publicationEntries.find(
    ({ data }) =>
      data.macroevento_principal_id === process.macroevento_id,
  ) || relatedPublicationForProcess(process, publicationEntries);

const rectorGroups = processes
  .filter((process) => process.es_macroevento_rector)
  .map((rector) => {
    const publication = publicationFor(rector);
    const links = groupRectorProcesses(rector, processes);
    const complementaries = links.complementaries
      .sort(
        (a, b) =>
          compareProcessRelevance(a, b) ||
          a.titulo.localeCompare(b.titulo, 'es'),
      )
      .map((process) => ({
        process,
        publication: publicationFor(process),
        editorialState: effectiveEditorialState(
          process,
          publicationEntries,
        ),
      }));

    return {
      rector,
      publication,
      editorialState: effectiveEditorialState(rector, publicationEntries),
      complementaries,
      transversals: links.transversals,
    };
  });

const rectorCountLabel =
  rectorGroups.length === 1
    ? '1 macroevento rector'
    : `${rectorGroups.length} macroeventos rectores`;
---

<SiteLayout
  title="Macroeventos rectores"
  description="Hipótesis estructurales que organizan procesos geopolíticos complementarios y permiten seguir sus relaciones, evidencias y límites."
>
  <div class="page-shell">
    <header class="page-intro page-intro--illustrated">
      <div class="page-intro__copy">
        <p class="eyebrow">Macroeventos rectores</p>
        <PageTitle>Procesos que organizan otros procesos</PageTitle>
        <p>
          Un macroevento rector reúne varios procesos complementarios dentro de
          una misma hipótesis estructural. Permite observar qué dinámicas se
          refuerzan, cuáles siguen condicionadas y qué evidencia puede debilitar
          la interpretación general.
        </p>
      </div>
      <EditorialImage asset="rectores" />
    </header>

    <div class="rector-summary">
      <strong>{rectorCountLabel}</strong>
      <span>
        Cada rector conduce a su expediente, su análisis y los procesos que
        organiza.
      </span>
      <ActionLink href={siteRoutes.observatory} size="compact" arrow>Volver al Observatorio</ActionLink>
    </div>

    {
      rectorGroups.length ? (
        <section class="rector-list" aria-label="Macroeventos rectores disponibles">
          {rectorGroups.map((group) => (
            <RectorCard {...group} initiallyOpen={rectorGroups.length === 1} />
          ))}
        </section>
      ) : (
        <section class="empty-state">
          <h2>No hay macroeventos rectores disponibles</h2>
          <p>
            Cuando un proceso sea clasificado como rector aparecerá aquí con
            sus ramificaciones.
          </p>
        </section>
      )
    }
  </div>
</SiteLayout>

<script>
  document.querySelectorAll<HTMLDetailsElement>('[data-branch-details]').forEach((details) => {
    const label = details.querySelector<HTMLElement>('[data-branch-toggle-label]');

    const updateLabel = () => {
      if (label) {
        label.textContent = details.open
          ? details.dataset.openLabel || 'Cerrar'
          : details.dataset.closedLabel || 'Ver';
      }
    };

    updateLabel();
    details.addEventListener('toggle', updateLabel);
    details.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !details.open) return;
      event.preventDefault();
      event.stopPropagation();
      details.open = false;
      updateLabel();
      details.querySelector('summary')?.focus();
    });
  });
</script>

<style>

  .rector-summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-4);
    border-block: 1px solid var(--line);
  }

  .rector-summary strong {
    font-family: var(--serif);
    font-size: var(--type-card-size);
    font-weight: var(--font-weight-medium);
    line-height: 1.2;
  }

  .rector-summary span {
    color: var(--ink-600);
    font-size: var(--type-meta-size);
  }

  .rector-list {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

</style>
