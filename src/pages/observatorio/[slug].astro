---
import PageTitle from '../../components/PageTitle.astro';
import ReadingLinks from '../../components/ReadingLinks.astro';
import { sameText } from '../../../tools/lib/navigation-policy.mjs';
import ClassificationFooter from '../../components/ClassificationFooter.astro';
import SignalTimeline from '../../components/SignalTimeline.astro';
import ProcessDefinition from '../../components/observatory/ProcessDefinition.astro';
import ProcessRelations from '../../components/observatory/ProcessRelations.astro';
import ProcessReferencedSignals from '../../components/observatory/ProcessReferencedSignals.astro';
import ProcessOutlook from '../../components/observatory/ProcessOutlook.astro';
import ProcessForecasts from '../../components/observatory/ProcessForecasts.astro';
import ProcessSidebar from '../../components/observatory/ProcessSidebar.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import {
  catalogMaps,
  editorialPreviewEnabled,
  processes,
  sourceById,
} from '../../lib/data';
import {
  effectiveEditorialState,
  relatedPublicationForProcess,
} from '../../lib/editorial';
import {
  editorialStageLabel,
  formatDate,
  humanize,
} from '../../lib/text';
import type { PublicProcess } from '../../lib/types';
import { getPublicationEntries } from '../../lib/publications';
import { topicHref, topicReferences } from '../../lib/taxonomy';

export function getStaticPaths() {
  return processes.map((process) => ({
    params: { slug: process.slug },
    props: { process },
  }));
}

interface Props {
  process: PublicProcess;
}

const { process } = Astro.props as Props;
const processSources = process.fuente_ids
  .map((id) => sourceById.get(id))
  .filter(Boolean);

const publicationEntries = await getPublicationEntries({ includePreview: true });
const publications = publicationEntries.filter(({ data }) => editorialPreviewEnabled || data.publicacion.estado === 'publicado').filter(
  ({ data }) =>
    data.macroevento_principal_id === process.macroevento_id ||
    data.macroevento_secundario_ids.includes(process.macroevento_id),
);
const publicationMetadata = relatedPublicationForProcess(
  process,
  publicationEntries,
);
const editorialState = effectiveEditorialState(process, publicationEntries);
const topics = topicReferences(process.clasificacion, catalogMaps);
const primaryTopic = topics.find((topic) => topic.primary);
---

<SiteLayout
  title={process.titulo}
  description={process.sintesis}
>
  <div class="page-shell">
    <header class="process-hero">
      <p class="eyebrow detail-kicker">
        <span>Expediente del Observatorio</span>
        {
          primaryTopic && (
            <>
              <span aria-hidden="true">·</span>
              <a href={topicHref(primaryTopic)}>
                {primaryTopic.item.nombre}
              </a>
            </>
          )
        }
      </p>
      <PageTitle>{process.titulo}</PageTitle>
      <p class="lead">{process.sintesis}</p>
      <div class="hero-meta">
        <span>Actualizado {formatDate(process.publicacion.actualizado_el)}</span>
        <span>{humanize(process.estado_seguimiento)}</span>
        {
          editorialState !== 'publicado' && (
            <span class="draft-chip">
              {editorialStageLabel(editorialState)}
            </span>
          )
        }
      </div>
    </header>

    <div class="process-layout">
      <article class="process-content">
        {
          editorialState !== 'publicado' && (
            <aside class="editorial-note development-note">
              <strong>Expediente en desarrollo.</strong>
              <span>
                Esta ficha permite seguir el trabajo editorial en curso. Su
                documentación, valoraciones y contenido pueden cambiar durante
                la investigación y revisión.
              </span>
            </aside>
          )
        }

        {process.que_esta_ocurriendo && !sameText(process.que_esta_ocurriendo, process.sintesis) && <section class="content-section">
          <h2>Qué está ocurriendo</h2>
          <p>{process.que_esta_ocurriendo}</p>
        </section>}

        <section class="content-section">
          <h2>Por qué importa</h2>
          <p>
            {
              process.por_que_importa ||
                'Esta sección permanece pendiente de revisión editorial.'
            }
          </p>
        </section>

        <ProcessDefinition process={process} />

        <ProcessRelations process={process} publicationEntries={publicationEntries} />

        {
          process.claves_estructurales.length > 0 && (
            <section class="content-section">
              <h2>Claves estructurales</h2>
              <ul>
                {process.claves_estructurales.map((item) => <li>{item}</li>)}
              </ul>
            </section>
          )
        }

        <section class="content-section" id="cronologia">
          <h2>Señales y cronología</h2>
          {
            process.senales.length ? (
              <SignalTimeline signals={process.senales} processSlug={process.slug} />
            ) : (
              <p>
                Aún no hay señales con fuentes vinculadas aptas para esta
                proyección.
              </p>
            )
          }
        </section>

        <ProcessReferencedSignals process={process} />

        {
          process.indicadores_seguimiento.length > 0 && (
            <section class="content-section">
              <h2>Indicadores para seguir</h2>
              <ul>
                {process.indicadores_seguimiento.map((item) => <li>{item}</li>)}
              </ul>
            </section>
          )
        }

        <ProcessOutlook process={process} />

        <ProcessForecasts process={process} />

        <section class="content-section" id="fuentes">
          <h2>Fuentes</h2>
          {
            processSources.length ? (
              <ol class="source-list">
                {processSources.map((source) => (
                  <li>
                    <a href={source?.url} target="_blank" rel="noopener noreferrer">
                      {source?.titulo || source?.medio}
                    </a>
                    <p>
                      {source?.medio} · {formatDate(source?.fecha)} ·{' '}
                      {source?.estado_verificacion}
                    </p>
                  </li>
                ))}
              </ol>
            ) : (
              <p>No hay fuentes proyectadas para este expediente.</p>
            )
          }
        </section>

        <ClassificationFooter classification={process.clasificacion} />

        <ReadingLinks title="Análisis de este expediente" items={publications.map(({ data }) => ({
          href: `/publicaciones/${data.slug}/`,
          label: `Leer el análisis: ${data.titulo}`,
        }))} />
      </article>

      <ProcessSidebar
        process={process}
        editorialState={editorialState}
        publicationTitle={publicationMetadata?.data.titulo || process.titulo}
      />
    </div>
  </div>
</SiteLayout>
