---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const ensayos = await getCollection('ensayos');
  return ensayos.map((ensayo) => ({
    params: { id: ensayo.id },
    props: { ensayo },
  }));
}

const { ensayo } = Astro.props;
const { Content } = await render(ensayo);
---

<Layout
  title={`${ensayo.data.title} | Memo Geopolítico`}
  description={ensayo.data.description}
  image={ensayo.data.coverImage || '/default-og.png'}
>
  <!-- Barra de navegación superior -->
  <header class="bg-slate-900 text-white sticky top-0 z-50 shadow-md">
    <div
      class="max-w-screen-2xl mx-auto px-4 lg:px-6 h-16 flex items-center justify-between"
    >
      <a
        href="/"
        class="flex items-center gap-2 hover:opacity-80 transition-opacity"
      >
        <span
          class="text-xl font-bold tracking-tight uppercase font-sans flex items-center gap-2"
        >
          <span class="text-red-600 text-2xl">🌍</span> Memo Geopolítico
        </span>
      </a>
      <a
        href="/"
        class="text-sm font-medium text-gray-300 hover:text-white transition-colors"
      >
        &larr; Volver al Panorama
      </a>
    </div>
  </header>

  <!-- Contenedor principal de lectura -->
  <main
    class="max-w-3xl mx-auto px-6 py-12 bg-white min-h-screen shadow-sm border-x border-slate-200 mt-6 mb-12 rounded-t-xl"
  >
    <article>
      <header class="mb-10 pb-8 border-b border-slate-200">
        <!-- Contenedor de Etiquetas y Tipo de Documento -->
        <div class="flex items-center gap-2 mb-5">
          <!-- Etiqueta identificadora del tipo de documento -->
          <span
            class="px-3 py-1 bg-slate-800 text-white text-[10px] font-bold rounded-sm uppercase tracking-widest"
          >
            Ensayo
          </span>

          <!-- Etiquetas geográficas/temáticas -->
          {
            ensayo.data.tags && ensayo.data.tags.length > 0 && (
              <div class="flex gap-2 border-l border-slate-300 pl-2">
                {ensayo.data.tags.map((t: string) => (
                  <span class="px-2.5 py-1 bg-slate-100 text-slate-600 text-[10px] font-bold rounded-full uppercase tracking-wider">
                    {t}
                  </span>
                ))}
              </div>
            )
          }
        </div>

        <h1
          class="text-4xl md:text-5xl font-serif font-bold text-slate-900 mb-6 leading-tight"
        >
          {ensayo.data.title}
        </h1>

        <p
          class="text-xl text-slate-600 mb-8 font-serif italic leading-relaxed"
        >
          {ensayo.data.description}
        </p>

        <div
          class="flex items-center text-sm text-slate-500 font-sans bg-slate-50 p-4 rounded-xl border border-slate-100 my-6"
        >
          <div
            class="w-10 h-10 shrink-0 rounded-full bg-slate-200 flex items-center justify-center text-slate-700 font-bold text-lg"
          >
            {ensayo.data.author.charAt(0)}
          </div>
          <div class="ml-4">
            <div class="font-bold text-slate-900">{ensayo.data.author}</div>
            <time datetime={ensayo.data.date.toISOString()}>
              {
                ensayo.data.date.toLocaleDateString('es-ES', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })
              }
            </time>
          </div>
        </div>
      </header>
    </article>

    <!-- Contenedor donde se inyecta el Markdown -->
    <div
      class="prose max-w-none font-serif text-lg text-slate-800 prose-headings:font-serif"
    >
      <Content />
    </div>
  </main>
</Layout>
