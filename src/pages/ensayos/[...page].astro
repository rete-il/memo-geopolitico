---
import { getCollection } from 'astro:content';
import type { PaginateFunction } from 'astro';

import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths({
  paginate,
}: {
  paginate: PaginateFunction;
}) {
  const ensayos = await getCollection('ensayos');

  const ensayosOrdenados = ensayos.sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );

  return paginate(ensayosOrdenados, {
    pageSize: 9,
  });
}

const { page } = Astro.props;

const formatearFecha = (fecha: Date) =>
  fecha.toLocaleDateString('es-ES', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
---

<Layout
  title="Ensayos | Memo Geopolítico"
  description="Ensayos de interpretación geopolítica, poder, recursos, tecnología y transformaciones del orden internacional."
>
  <Header />

  <main class="flex-1">
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-14">
      <header class="max-w-3xl mb-10">
        <div
          class="flex items-center gap-2 mb-3 text-xs font-bold uppercase tracking-widest text-slate-500"
        >
          <i class="ph-fill ph-article text-slate-700" aria-hidden="true"></i>
          Archivo editorial
        </div>

        <h1
          class="text-4xl md:text-5xl font-serif font-bold text-slate-900 leading-tight"
        >
          Ensayos
        </h1>

        <p class="mt-4 text-lg text-slate-600 leading-relaxed">
          Interpretaciones de largo alcance sobre regiones, actores, recursos,
          tecnología y transformaciones del poder internacional.
        </p>
      </header>

      {
        page.data.length === 0 ? (
          <div class="rounded-xl border border-slate-200 bg-white px-6 py-12 text-center">
            <h2 class="text-xl font-bold text-slate-900">
              Todavía no hay ensayos publicados
            </h2>

            <p class="mt-2 text-slate-600">
              Los nuevos contenidos aparecerán aquí cuando sean publicados.
            </p>
          </div>
        ) : (
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {page.data.map((ensayo) => (
              <a
                href={`/ensayos/${ensayo.id}/`}
                class="group block rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2"
              >
                <article class="h-full flex flex-col rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
                  <div class="flex flex-wrap items-center gap-2 mb-4">
                    <span class="rounded-sm bg-slate-800 px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest text-white">
                      Ensayo
                    </span>

                    {ensayo.data.tags?.slice(0, 2).map((tag) => (
                      <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-slate-600">
                        {tag}
                      </span>
                    ))}
                  </div>

                  <h2 class="text-2xl font-serif font-bold leading-tight text-slate-900 transition-colors group-hover:text-blue-700">
                    {ensayo.data.title}
                  </h2>

                  <p class="mt-3 flex-1 text-sm leading-6 text-slate-600">
                    {ensayo.data.description}
                  </p>

                  <footer class="mt-6 flex items-center justify-between border-t border-slate-100 pt-4 text-xs text-slate-500">
                    <time datetime={ensayo.data.date.toISOString()}>
                      {formatearFecha(ensayo.data.date)}
                    </time>

                    <span class="font-semibold text-slate-700 group-hover:text-blue-700">
                      Leer ensayo →
                    </span>
                  </footer>
                </article>
              </a>
            ))}
          </div>
        )
      }

      {
        page.lastPage > 1 && (
          <nav
            class="mt-10 flex items-center justify-between border-t border-slate-300 pt-6"
            aria-label="Paginación de ensayos"
          >
            <div>
              {page.url.prev && (
                <a
                  href={page.url.prev}
                  class="inline-flex min-h-11 items-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
                >
                  ← Anteriores
                </a>
              )}
            </div>

            <span class="text-sm text-slate-500">
              Página {page.currentPage} de {page.lastPage}
            </span>

            <div>
              {page.url.next && (
                <a
                  href={page.url.next}
                  class="inline-flex min-h-11 items-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
                >
                  Siguientes →
                </a>
              )}
            </div>
          </nav>
        )
      }
    </section>
  </main>
</Layout>
