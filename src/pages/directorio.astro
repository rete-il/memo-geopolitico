---
import Layout from '../layouts/Layout.astro';
import mediosData from '../data/medios.json';
import Header from '../components/Header.astro';

// Eliminamos la importación problemática del CSS
---

<Layout>
  <!-- Barra de navegación global del sitio -->
  <Header />
  <!-- Contenedor Encapsulado del Dashboard -->
  <div class="dashboard-root" data-theme="light">
    <a class="skip-link" href="#resultados">Saltar a resultados</a>

    <div class="topbar">
      <div class="topbar__inner">
        <div>
          <p class="eyebrow">Inteligencia de fuentes abiertas</p>
          <h1 class="db-title">Directorio de medios geopolíticos</h1>
          <p class="subtitle">
            Explore y compare fuentes por región, función epistemológica,
            perspectiva, credibilidad, utilidad analítica y necesidad de
            corroboración.
          </p>
        </div>
        <div class="top-actions">
          <a
            id="excel-download"
            class="btn btn--light"
            href="/data/Medios_Geopolitica.xlsx"
            download="Medios_Geopolitica.xlsx">⬇ Descargar Excel</a
          >
          <button id="export-csv" class="btn btn--light" type="button"
            >⇩ Exportar filtrados</button
          >
          <button id="theme-toggle" class="btn btn--light" type="button"
            >🌙 Tema oscuro</button
          >
        </div>
      </div>
    </div>

    <main class="container">
      <section class="panel filters" aria-label="Filtros">
        <div class="field">
          <label for="search">Buscar</label>
          <input
            id="search"
            type="search"
            placeholder="Medio, región, uso, perspectiva…"
            autocomplete="off"
          />
        </div>
        <div class="field">
          <label for="region">Región</label>
          <select id="region"></select>
        </div>
        <div class="field">
          <label for="familia">Familia</label>
          <select id="familia"></select>
        </div>
        <div class="field">
          <label for="funcion">Función epistemológica</label>
          <select id="funcion"></select>
        </div>
        <div class="field">
          <label for="perspectiva">Perspectiva geopolítica</label>
          <select id="perspectiva"></select>
        </div>
        <div class="field">
          <label for="confianza">Confianza</label>
          <select id="confianza"></select>
        </div>
        <div class="field">
          <label for="estado">Estado de uso</label>
          <select id="estado"></select>
        </div>
        <div class="field range-field">
          <label for="min-score">Puntuación mínima</label>
          <div class="range-row">
            <input
              id="min-score"
              type="range"
              min="0"
              max="5"
              step="0.1"
              value="0"
            />
            <span id="min-score-value" class="range-value">0.0</span>
          </div>
        </div>
        <div class="filter-actions">
          <button id="reset-filters" class="btn btn--ghost" type="button"
            >Limpiar filtros</button
          >
        </div>
        <div
          id="filtered-text"
          class="active-filter-summary"
          aria-live="polite"
        >
        </div>
      </section>

      <section class="kpis" aria-label="Indicadores">
        <article class="panel kpi">
          <div class="kpi__label">Fuentes visibles</div>
          <div id="kpi-total" class="kpi__value">0</div>
          <div class="kpi__note">Resultado de los filtros actuales</div>
        </article>
        <article class="panel kpi">
          <div class="kpi__label">Puntuación media</div>
          <div id="kpi-score" class="kpi__value">0.0</div>
          <div class="kpi__note">Promedio sobre 5</div>
        </article>
        <article class="panel kpi">
          <div class="kpi__label">Confianza alta</div>
          <div id="kpi-high" class="kpi__value">0</div>
          <div class="kpi__note">Fuentes con nivel “Alta”</div>
        </article>
        <article class="panel kpi">
          <div class="kpi__label">Activas o recomendadas</div>
          <div id="kpi-usable" class="kpi__value">0</div>
          <div class="kpi__note">Uso inmediato o incorporación sugerida</div>
        </article>
        <article class="panel kpi">
          <div class="kpi__label">Foco africano</div>
          <div id="kpi-africa" class="kpi__value">0</div>
          <div class="kpi__note">Regiones cuyo nombre incluye África</div>
        </article>
      </section>

      <section class="charts" aria-label="Resumen visual">
        <article class="panel chart-card">
          <h2 class="card-title">Distribución regional</h2>
          <div class="card-subtitle">
            Principales regiones en el resultado actual
          </div>
          <div id="region-bars" class="bar-list"></div>
        </article>
        <article class="panel chart-card">
          <h2 class="card-title">Familias de fuente</h2>
          <div class="card-subtitle">
            Tipos institucionales más representados
          </div>
          <div id="family-bars" class="bar-list"></div>
        </article>
        <article class="panel chart-card">
          <h2 class="card-title">Nivel de confianza</h2>
          <div class="card-subtitle">Distribución de la evaluación global</div>
          <div class="donut-wrap">
            <div id="confidence-donut" class="donut"></div>
          </div>
          <div id="confidence-legend" class="legend"></div>
        </article>
        <article class="panel chart-card">
          <h2 class="card-title">Estado de uso</h2>
          <div class="card-subtitle">
            Clasificación operacional de las fuentes
          </div>
          <div class="donut-wrap">
            <div id="status-donut" class="donut"></div>
          </div>
          <div id="status-legend" class="legend"></div>
        </article>
      </section>

      <section id="resultados" class="panel results-panel">
        <div class="results-head">
          <div>
            <h2 class="results-title">Fuentes</h2>
            <div id="results-meta" class="results-meta"></div>
          </div>
          <div class="field">
            <label for="page-size">Filas por página</label>
            <select id="page-size">
              <option value="10">10</option>
              <option value="25" selected>25</option>
              <option value="50">50</option>
              <option value="100">100</option>
            </select>
          </div>
        </div>

        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th><button type="button" data-sort="nombre">Medio</button></th>
                <th><button type="button" data-sort="region">Región</button></th
                >
                <th
                  ><button type="button" data-sort="familia">Familia</button
                  ></th
                >
                <th
                  ><button type="button" data-sort="funcion">Función</button
                  ></th
                >
                <th
                  ><button type="button" data-sort="perspectiva"
                    >Perspectiva</button
                  ></th
                >
                <th
                  ><button type="button" data-sort="puntuacion"
                    >Puntuación</button
                  ></th
                >
                <th
                  ><button type="button" data-sort="confianza">Confianza</button
                  ></th
                >
                <th><button type="button" data-sort="estado">Estado</button></th
                >
                <th>Detalle</th>
              </tr>
            </thead>
            <tbody id="results-body"></tbody>
          </table>
          <div id="empty-state" class="empty" hidden>
            No hay medios que coincidan con la combinación de filtros.
          </div>
        </div>

        <div class="pagination">
          <div id="page-info" class="results-meta">Página 1 de 1</div>
          <div class="pagination__buttons">
            <button
              id="prev-page"
              class="btn btn--ghost btn--small"
              type="button">← Anterior</button
            >
            <button
              id="next-page"
              class="btn btn--ghost btn--small"
              type="button">Siguiente →</button
            >
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div id="data-updated"></div>
      <div class="mt-2">
        Las calificaciones son orientativas y contextuales. Una fuente oficial o
        estatal puede ser valiosa como fuente primaria sin constituir
        verificación independiente.
      </div>
    </footer>

    <div
      id="modal-backdrop"
      class="modal-backdrop"
      role="dialog"
      aria-modal="true"
      aria-hidden="true"
      aria-labelledby="modal-title"
    >
      <article class="modal">
        <header class="modal-head">
          <h2 id="modal-title" class="modal-title">Ficha</h2>
          <button
            id="modal-close"
            class="close-btn"
            type="button"
            aria-label="Cerrar">×</button
          >
        </header>
        <div id="modal-body" class="modal-body"></div>
      </article>
    </div>

    <div id="toast" class="toast" role="status" aria-live="polite"></div>
  </div>

  <!-- ESTILOS INYECTADOS DIRECTAMENTE PARA EVITAR ERRORES DE RUTAS -->
  <style is:global>
    .dashboard-root {
      --bg: #f4f7fb;
      --surface: #ffffff;
      --surface-alt: #edf3f9;
      --text: #172033;
      --muted: #607086;
      --line: #dbe4ee;
      --primary: #17365d;
      --primary-2: #2f75b5;
      --accent: #1f6d70;
      --gold: #b98725;
      --good: #3f7d20;
      --warn: #a85a0a;
      --danger: #b42318;
      --shadow: 0 10px 30px rgba(23, 54, 93, 0.1);
      --radius: 16px;
      --focus: 0 0 0 3px rgba(47, 117, 181, 0.23);

      background: var(--bg);
      color: var(--text);
      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        'Segoe UI',
        sans-serif;
      line-height: 1.45;
      min-height: 100vh;
      width: 100%;
    }
    .dashboard-root[data-theme='dark'] {
      --bg: #0f1722;
      --surface: #172131;
      --surface-alt: #202d40;
      --text: #eef4fb;
      --muted: #a9b8c9;
      --line: #334258;
      --primary: #8fc1f1;
      --primary-2: #65a9e9;
      --accent: #65c0bb;
      --gold: #e6b75a;
      --good: #8ecf72;
      --warn: #ffb45e;
      --danger: #ff8f86;
      --shadow: 0 10px 30px rgba(0, 0, 0, 0.24);
    }
    .dashboard-root a {
      color: var(--primary-2);
    }
    .dashboard-root button,
    .dashboard-root input,
    .dashboard-root select {
      font: inherit;
      border-radius: 10px;
    }
    .dashboard-root button:focus-visible,
    .dashboard-root input:focus-visible,
    .dashboard-root select:focus-visible,
    .dashboard-root a:focus-visible {
      outline: none;
      box-shadow: var(--focus);
    }
    .dashboard-root .topbar {
      background: linear-gradient(
        135deg,
        #102c4e 0%,
        #17365d 48%,
        #1f6d70 100%
      );
      color: #fff;
      padding: 26px clamp(18px, 4vw, 56px) 34px;
    }
    .dashboard-root .topbar__inner {
      max-width: 1500px;
      margin: 0 auto;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 22px;
    }
    .dashboard-root .eyebrow {
      margin: 0 0 8px;
      font-size: 0.82rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      opacity: 0.82;
    }
    .dashboard-root .db-title {
      margin: 0;
      font-size: clamp(1.85rem, 4vw, 3rem);
      line-height: 1.08;
      font-family: Inter, sans-serif;
    }
    .dashboard-root .subtitle {
      margin: 12px 0 0;
      max-width: 800px;
      color: rgba(255, 255, 255, 0.83);
      font-size: 1.03rem;
    }
    .dashboard-root .top-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      justify-content: flex-end;
    }
    .dashboard-root .btn {
      appearance: none;
      border: 1px solid transparent;
      background: var(--surface);
      color: var(--text);
      padding: 10px 14px;
      cursor: pointer;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-decoration: none;
      transition:
        transform 0.15s ease,
        background 0.15s ease,
        border-color 0.15s ease;
    }
    .dashboard-root .btn:hover {
      transform: translateY(-1px);
    }
    .dashboard-root .btn--light {
      background: rgba(255, 255, 255, 0.12);
      color: white;
      border-color: rgba(255, 255, 255, 0.32);
    }
    .dashboard-root .btn--primary {
      background: var(--primary-2);
      color: #fff;
    }
    .dashboard-root .btn--ghost {
      background: transparent;
      border-color: var(--line);
      color: var(--text);
    }
    .dashboard-root .btn--small {
      padding: 7px 10px;
      font-size: 0.88rem;
    }
    .dashboard-root .container {
      max-width: 1500px;
      margin: -18px auto 50px;
      padding: 0 clamp(14px, 3vw, 36px);
    }
    .dashboard-root .panel {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }
    .dashboard-root .filters {
      padding: 18px;
      display: grid;
      grid-template-columns: minmax(240px, 2fr) repeat(5, minmax(160px, 1fr));
      gap: 12px;
      align-items: end;
    }
    .dashboard-root .field {
      display: grid;
      gap: 6px;
    }
    .dashboard-root .field label {
      font-size: 0.78rem;
      font-weight: 800;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .dashboard-root .field input,
    .dashboard-root .field select {
      width: 100%;
      min-height: 42px;
      padding: 9px 11px;
      border: 1px solid var(--line);
      background: var(--surface);
      color: var(--text);
    }
    .dashboard-root .range-field {
      grid-column: span 2;
    }
    .dashboard-root .range-row {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .dashboard-root .range-row input {
      flex: 1;
    }
    .dashboard-root .range-value {
      min-width: 48px;
      padding: 6px 8px;
      text-align: center;
      border-radius: 9px;
      background: var(--surface-alt);
      font-weight: 800;
    }
    .dashboard-root .filter-actions {
      display: flex;
      gap: 9px;
      flex-wrap: wrap;
    }
    .dashboard-root .active-filter-summary {
      grid-column: 1 / -1;
      color: var(--muted);
      font-size: 0.9rem;
      min-height: 1.4em;
    }
    .dashboard-root .kpis {
      margin-top: 18px;
      display: grid;
      grid-template-columns: repeat(5, minmax(150px, 1fr));
      gap: 14px;
    }
    .dashboard-root .kpi {
      padding: 18px;
    }
    .dashboard-root .kpi__label {
      color: var(--muted);
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-weight: 800;
    }
    .dashboard-root .kpi__value {
      margin-top: 8px;
      font-size: clamp(1.6rem, 3vw, 2.35rem);
      font-weight: 850;
      line-height: 1;
      color: var(--primary);
    }
    .dashboard-root .kpi__note {
      margin-top: 8px;
      color: var(--muted);
      font-size: 0.84rem;
    }
    .dashboard-root .charts {
      margin-top: 18px;
      display: grid;
      grid-template-columns: 1.35fr 1.35fr 0.8fr 0.8fr;
      gap: 14px;
    }
    .dashboard-root .chart-card {
      padding: 18px;
      min-height: 310px;
    }
    .dashboard-root .card-title {
      margin: 0 0 4px;
      font-size: 1rem;
      font-family: Inter, sans-serif;
    }
    .dashboard-root .card-subtitle {
      color: var(--muted);
      font-size: 0.84rem;
      margin-bottom: 16px;
    }
    .dashboard-root .bar-list {
      display: grid;
      gap: 10px;
    }
    .dashboard-root .bar-item {
      display: grid;
      grid-template-columns: minmax(100px, 1fr) 2fr 36px;
      gap: 9px;
      align-items: center;
    }
    .dashboard-root .bar-label {
      font-size: 0.82rem;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }
    .dashboard-root .bar-track {
      height: 10px;
      background: var(--surface-alt);
      border-radius: 99px;
      overflow: hidden;
    }
    .dashboard-root .bar-fill {
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(90deg, var(--primary-2), var(--accent));
      min-width: 2px;
    }
    .dashboard-root .bar-count {
      text-align: right;
      font-weight: 800;
      font-size: 0.82rem;
    }
    .dashboard-root .donut-wrap {
      height: 176px;
      display: grid;
      place-items: center;
    }
    .dashboard-root .donut {
      width: 152px;
      height: 152px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      position: relative;
    }
    .dashboard-root .donut::after {
      content: '';
      width: 88px;
      height: 88px;
      border-radius: 50%;
      background: var(--surface);
      position: absolute;
    }
    .dashboard-root .donut-center {
      z-index: 1;
      text-align: center;
      font-weight: 900;
      font-size: 1.35rem;
    }
    .dashboard-root .donut-center small {
      display: block;
      font-size: 0.68rem;
      color: var(--muted);
      font-weight: 700;
    }
    .dashboard-root .legend {
      display: grid;
      gap: 7px;
      margin-top: 8px;
    }
    .dashboard-root .legend-item {
      display: grid;
      grid-template-columns: 10px 1fr auto;
      gap: 8px;
      align-items: center;
      font-size: 0.8rem;
    }
    .dashboard-root .legend-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
    }
    .dashboard-root .results-panel {
      margin-top: 18px;
      overflow: hidden;
    }
    .dashboard-root .results-head {
      padding: 16px 18px;
      display: flex;
      gap: 14px;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--line);
    }
    .dashboard-root .results-title {
      margin: 0;
      font-size: 1.05rem;
      font-family: Inter, sans-serif;
    }
    .dashboard-root .results-meta {
      color: var(--muted);
      font-size: 0.88rem;
    }
    .dashboard-root .table-wrap {
      overflow: auto;
      max-height: 68vh;
    }
    .dashboard-root table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      min-width: 1260px;
    }
    .dashboard-root thead th {
      position: sticky;
      top: 0;
      z-index: 3;
      background: var(--primary);
      color: white;
      text-align: left;
      padding: 11px 12px;
      font-size: 0.77rem;
      letter-spacing: 0.02em;
      border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    }
    .dashboard-root thead th button {
      width: 100%;
      border: 0;
      padding: 0;
      background: transparent;
      color: inherit;
      cursor: pointer;
      text-align: inherit;
      font-weight: 800;
    }
    .dashboard-root tbody td {
      padding: 11px 12px;
      border-bottom: 1px solid var(--line);
      vertical-align: top;
      font-size: 0.87rem;
    }
    .dashboard-root tbody tr:hover {
      background: var(--surface-alt);
    }
    .dashboard-root .source-name {
      font-weight: 850;
      color: var(--primary);
    }
    .dashboard-root .source-link {
      display: inline-flex;
      margin-top: 3px;
      font-size: 0.78rem;
    }
    .dashboard-root .score {
      display: inline-flex;
      justify-content: center;
      min-width: 42px;
      padding: 5px 8px;
      border-radius: 99px;
      font-weight: 900;
      background: var(--surface-alt);
    }
    .dashboard-root .badge {
      display: inline-flex;
      align-items: center;
      padding: 4px 8px;
      border-radius: 99px;
      font-size: 0.73rem;
      font-weight: 850;
      white-space: nowrap;
      border: 1px solid transparent;
    }
    .dashboard-root .badge--high,
    .dashboard-root .badge--active {
      background: rgba(63, 125, 32, 0.13);
      color: var(--good);
      border-color: rgba(63, 125, 32, 0.25);
    }
    .dashboard-root .badge--medium {
      background: rgba(185, 135, 37, 0.14);
      color: var(--gold);
      border-color: rgba(185, 135, 37, 0.28);
    }
    .dashboard-root .badge--warning {
      background: rgba(168, 90, 10, 0.14);
      color: var(--warn);
      border-color: rgba(168, 90, 10, 0.26);
    }
    .dashboard-root .badge--danger {
      background: rgba(180, 35, 24, 0.12);
      color: var(--danger);
      border-color: rgba(180, 35, 24, 0.24);
    }
    .dashboard-root .badge--info {
      background: rgba(47, 117, 181, 0.13);
      color: var(--primary-2);
      border-color: rgba(47, 117, 181, 0.25);
    }
    .dashboard-root .pagination {
      padding: 14px 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      border-top: 1px solid var(--line);
    }
    .dashboard-root .pagination__buttons {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .dashboard-root .empty {
      padding: 50px 20px;
      text-align: center;
      color: var(--muted);
    }
    .dashboard-root .footer {
      max-width: 1500px;
      margin: 0 auto;
      padding: 0 30px 40px;
      color: var(--muted);
      font-size: 0.83rem;
    }
    .dashboard-root .modal-backdrop {
      position: fixed;
      inset: 0;
      z-index: 20;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 18px;
      background: rgba(4, 12, 24, 0.66);
    }
    .dashboard-root .modal-backdrop.is-open {
      display: flex;
    }
    .dashboard-root .modal {
      width: min(1050px, 100%);
      max-height: 92vh;
      overflow: auto;
      background: var(--surface);
      border-radius: 18px;
      box-shadow: 0 25px 80px rgba(0, 0, 0, 0.35);
    }
    .dashboard-root .modal-head {
      position: sticky;
      top: 0;
      z-index: 2;
      background: var(--surface);
      display: flex;
      justify-content: space-between;
      gap: 16px;
      padding: 18px 20px;
      border-bottom: 1px solid var(--line);
    }
    .dashboard-root .modal-title {
      margin: 0;
      color: var(--primary);
      font-family: Inter, sans-serif;
    }
    .dashboard-root .modal-body {
      padding: 20px;
      display: grid;
      gap: 18px;
    }
    .dashboard-root .detail-section h3 {
      margin: 0 0 10px;
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted);
      font-family: Inter, sans-serif;
    }
    .dashboard-root .detail-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
    }
    .dashboard-root .detail {
      padding: 11px;
      background: var(--surface-alt);
      border-radius: 11px;
      min-height: 68px;
      margin: 0;
    }
    .dashboard-root .detail dt {
      font-size: 0.72rem;
      font-weight: 850;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .dashboard-root .detail dd {
      margin: 5px 0 0;
      overflow-wrap: anywhere;
    }
    .dashboard-root .metric-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 9px;
    }
    .dashboard-root .metric {
      padding: 12px 8px;
      text-align: center;
      border: 1px solid var(--line);
      border-radius: 12px;
    }
    .dashboard-root .metric b {
      display: block;
      font-size: 1.35rem;
      color: var(--primary);
    }
    .dashboard-root .metric span {
      font-size: 0.68rem;
      color: var(--muted);
    }
    .dashboard-root .close-btn {
      appearance: none;
      border: 1px solid var(--line);
      background: var(--surface-alt);
      color: var(--text);
      width: 38px;
      height: 38px;
      border-radius: 50%;
      cursor: pointer;
      font-size: 1.15rem;
    }
    .dashboard-root .toast {
      position: fixed;
      right: 18px;
      bottom: 18px;
      z-index: 30;
      background: var(--text);
      color: var(--surface);
      padding: 11px 14px;
      border-radius: 11px;
      box-shadow: var(--shadow);
      opacity: 0;
      transform: translateY(12px);
      pointer-events: none;
      transition: 0.2s ease;
    }
    .dashboard-root .toast.show {
      opacity: 1;
      transform: translateY(0);
    }
    .dashboard-root .skip-link {
      position: absolute;
      top: -50px;
      left: 10px;
      z-index: 50;
      background: white;
      color: #111;
      padding: 9px 12px;
      border-radius: 8px;
    }
    .dashboard-root .skip-link:focus {
      top: 10px;
    }
    @media (max-width: 1180px) {
      .dashboard-root .filters {
        grid-template-columns: repeat(3, minmax(180px, 1fr));
      }
      .dashboard-root .charts {
        grid-template-columns: repeat(2, 1fr);
      }
      .dashboard-root .kpis {
        grid-template-columns: repeat(3, 1fr);
      }
    }
    @media (max-width: 760px) {
      .dashboard-root .topbar__inner {
        flex-direction: column;
      }
      .dashboard-root .top-actions {
        justify-content: flex-start;
      }
      .dashboard-root .container {
        margin-top: -12px;
      }
      .dashboard-root .filters {
        grid-template-columns: 1fr;
      }
      .dashboard-root .range-field {
        grid-column: auto;
      }
      .dashboard-root .kpis {
        grid-template-columns: repeat(2, 1fr);
      }
      .dashboard-root .charts {
        grid-template-columns: 1fr;
      }
      .dashboard-root .detail-grid {
        grid-template-columns: 1fr;
      }
      .dashboard-root .metric-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .dashboard-root .results-head,
      .dashboard-root .pagination {
        align-items: flex-start;
        flex-direction: column;
      }
    }
    @media print {
      .dashboard-root .top-actions,
      .dashboard-root .filters,
      .dashboard-root .pagination,
      .dashboard-root .btn,
      .dashboard-root .modal-backdrop {
        display: none !important;
      }
      .dashboard-root {
        background: white;
        color: black;
      }
      .dashboard-root .container {
        margin: 0;
        max-width: none;
      }
      .dashboard-root .panel {
        box-shadow: none;
        border: 1px solid #ccc;
      }
      .dashboard-root .table-wrap {
        max-height: none;
        overflow: visible;
      }
      .dashboard-root table {
        min-width: 0;
      }
    }
  </style>

  <!-- Inyección de Datos a Vanilla JS -->
  <script is:inline define:vars={{ mediosData }}>
    window.MEDIA_DASHBOARD_DATA = mediosData;
  </script>

  <!-- Ejecución de la lógica -->
  <script src="/js/directorio.js" is:inline></script>
</Layout>
