---
import Layout from '../layouts/Layout.astro';
import SidebarAlertas from '../components/SidebarAlertas.astro';
import MapaGlobal from '../components/MapaGlobal.astro';
import ListaEnsayos from '../components/ListaEnsayos.astro';
import PanelDerecho from '../components/PanelDerecho.astro';
import { getCollection, render } from 'astro:content';

const ensayos = await getCollection('ensayos');
const alertasBrutas = await getCollection('alertas');

// 1. Resolver asincronía
const alertas = await Promise.all(
  alertasBrutas.map(async (alerta) => {
    const { Content } = await render(alerta);
    return { ...alerta, Content };
  }),
);

// 2. Ordenamiento Ensayos
const ensayosOrdenados = ensayos.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const ensayosRecientes = ensayosOrdenados.slice(0, 5);

// 3. Reglas de Renderizado Map Data (TTL Filter de 14 días)
const FOURTEEN_DAYS_MS = 14 * 24 * 60 * 60 * 1000;
const nowMs = Date.now();

const mapAlertasData = alertas
  .filter((alerta) => {
    if (alerta.data.en_mapa === false) return false;
    const eventTime = new Date(alerta.data.date).getTime();
    return nowMs - eventTime <= FOURTEEN_DAYS_MS;
  })
  .flatMap((alerta) => {
    const coords = alerta.data.coordenadas;

    // Le indicamos explícitamente a TypeScript la estructura del array
    const arrayDeCoords = Array.isArray(coords[0])
      ? (coords as [number, number][])
      : ([coords] as [number, number][]);

    return arrayDeCoords.map((coord) => ({
      id: alerta.id,
      lat: coord[0],
      lng: coord[1],
      severity: alerta.data.severity,
    }));
  });
---

<Layout>
  <!-- Dependencias Cartográficas (Leaflet & MarkerCluster) -->
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  />
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css"
  />
  <script src="https://unpkg.com/@phosphor-icons/web" is:inline></script>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" is:inline
  ></script>
  <script
    src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"
    is:inline></script>

  <!-- Estilos globales específicos del tablero -->
  <style is:global>
    h1,
    h2,
    h3,
    h4,
    h5,
    h6,
    .font-serif {
      font-family: 'Playfair Display', serif;
    }
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    /* Personalización Spiderfy y Leaflet */
    .leaflet-container {
      background: #e2e8f0;
      font-family: inherit;
    }
    .leaflet-spiderfied-leg {
      stroke: #cbd5e1 !important;
      stroke-width: 1.5px !important;
    }

    @keyframes leaflet-pulse {
      0% {
        transform: scale(0.8);
        opacity: 0.8;
        box-shadow: 0 0 0 0 rgba(inherit, 0.7);
      }
      70% {
        transform: scale(1.5);
        opacity: 0;
        box-shadow: 0 0 0 15px rgba(inherit, 0);
      }
      100% {
        transform: scale(0.8);
        opacity: 0;
      }
    }
    .marker-pulse::after {
      content: '';
      position: absolute;
      left: -100%;
      top: -100%;
      width: 300%;
      height: 300%;
      border-radius: 50%;
      border: 2px solid currentColor;
      animation: leaflet-pulse 1.5s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
      pointer-events: none;
    }
  </style>

  <header
    class="bg-slate-900 text-white sticky top-0 z-50 shadow-md border-b border-slate-800"
  >
    <div
      class="max-w-screen-2xl mx-auto px-4 lg:px-6 h-16 flex items-center justify-between"
    >
      <!-- Logo y Título -->
      <div class="flex items-center gap-2">
        <i class="ph-fill ph-globe-hemisphere-west text-2xl text-red-600"></i>
        <h1 class="text-xl font-bold tracking-tight uppercase font-sans">
          Memo Geopolítico
        </h1>
      </div>

      <!-- Menú de Navegación rediseñado -->
      <nav class="flex items-center gap-1">
        <a href="/" class="px-4 py-2 ...">Inicio</a>
        <a href="/escenarios" class="px-4 py-2 ...">Proyecciones</a>
        <a href="/catalizadores" class="px-4 py-2 ...">Catalizadores</a>
        <a href="/contacto" class="px-4 py-2 ...">Contacto</a>
      </nav>
    </div>
  </header>

  <main
    class="flex-1 max-w-screen-2xl mx-auto w-full px-4 lg:px-6 py-6 grid grid-cols-1 lg:grid-cols-12 gap-6 bg-slate-100"
  >
    <!-- 1. COLUMNA IZQUIERDA -->
    <SidebarAlertas alertas={alertas} />

    <!-- 2. COLUMNA CENTRAL -->
    <section class="lg:col-span-6 flex flex-col gap-6">
      <MapaGlobal mapData={mapAlertasData} />
      <ListaEnsayos ensayos={ensayosRecientes} />
    </section>

    <!-- 3. COLUMNA DERECHA -->
    <PanelDerecho />
  </main>
</Layout>
