---
import PublicationCard from '../components/PublicationCard.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { editorialPreviewEnabled } from '../lib/data';
import { formatDate } from '../lib/text';
import { getPublicationEntries } from '../lib/publications';

const publications = await getPublicationEntries({
  includePreview: false,
  publishedOnly: true,
});
const latestPublications = publications.slice(0, 4);
const hasMorePublications = publications.length > latestPublications.length;
const latestUpdate = publications[0]?.data.publicacion.actualizado_el;
---

<SiteLayout>
  <div class="page-shell">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">Prospectiva geopolítica</p>
        <h1>Analizar procesos</h1>
        <p>
          Más allá de la actualidad inmediata, examinamos transformaciones de
          mediano y largo plazo mediante expedientes, señales verificadas y
          fuentes trazables.
        </p>
        <div class="hero-actions">
          <a class="button-primary" href="/publicaciones/">Leer publicaciones</a
          >
          <a class="button-secondary" href="/observatorio/"
            >Abrir el Observatorio</a
          >
        </div>
      </div>
      <aside class="hero-panel" aria-label="Archivo de publicaciones">
        <p class="eyebrow">Archivo público</p>
        <h2>Análisis disponibles para lectura</h2>
        <div class="hero-metric">
          <span>Publicaciones</span>
          <strong>{publications.length}</strong>
          <small>textos completos</small>
        </div>
        <div class="hero-metric">
          <span>Última actualización</span>
          <strong class="hero-metric-date">
            {latestUpdate ? formatDate(latestUpdate) : '—'}
          </strong>
          <small>corte del archivo</small>
        </div>
      </aside>
    </section>
  </div>

  <section class="section-shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Últimas publicaciones</p>
        <h2>Análisis completos, conectados con evidencia</h2>
      </div>
      {
        hasMorePublications && (
          <a href="/publicaciones/">Ver más…</a>
        )
      }
    </div>
    {
      latestPublications.length ? (
        <div class="publication-grid">
          {latestPublications.map((publication) => (
            <PublicationCard
              publication={publication.data}
              editorialPreview={editorialPreviewEnabled}
            />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <h2>Las primeras publicaciones están en preparación</h2>
          <p>
            Los borradores permanecen fuera de Inicio hasta completar la
            revisión editorial y factual.
          </p>
        </div>
      )
    }
  </section>
</SiteLayout>
