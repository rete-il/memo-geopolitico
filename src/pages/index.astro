---
import SiteLayout from '../layouts/SiteLayout.astro';
import { processes } from '../lib/data';
import { getPublicationEntries } from '../lib/publications';

const publications = await getPublicationEntries({
  includePreview: false,
  publishedOnly: true,
});

const trackedProcessCount = processes.filter(
  (process) => process.estado_seguimiento === 'en_seguimiento',
).length;

const publicationCountLabel =
  publications.length === 0
    ? 'Sin publicaciones disponibles'
    : publications.length === 1
      ? '1 publicación disponible'
      : `${publications.length} publicaciones disponibles`;

const processCountLabel =
  trackedProcessCount === 0
    ? 'Sin procesos en seguimiento'
    : trackedProcessCount === 1
      ? '1 proceso en seguimiento'
      : `${trackedProcessCount} procesos en seguimiento`;
---

<SiteLayout>
  <div class="home-shell">
    <header class="home-intro">
      <p class="eyebrow">ANÁLISIS GEOPOLÍTICO INDEPENDIENTE</p>
      <h1>Comprender los procesos que transforman el mundo.</h1>
      <p class="home-lead">
        Más allá de la noticia inmediata, Memo Geopolítico sigue dinámicas de
        mediano y largo plazo mediante análisis completos, señales verificadas y
        fuentes trazables.
      </p>
    </header>

    <section class="home-paths" aria-label="Áreas principales">
      <article
        class="home-path home-path--publications"
        aria-labelledby="publications-title"
      >
        <p class="home-path-category">Publicaciones</p>
        <h2 id="publications-title">Leer análisis completos</h2>
        <p class="home-path-description">
          Ensayos, explicadores y comparaciones preparados para una lectura
          completa.
        </p>
        <p class="home-path-count">{publicationCountLabel}</p>
        <a class="home-path-link" href="/publicaciones/">
          Leer publicaciones <span aria-hidden="true">→</span>
        </a>
      </article>

      <article
        class="home-path home-path--observatory"
        aria-labelledby="observatory-title"
      >
        <p class="home-path-category">Observatorio</p>
        <h2 id="observatory-title">Seguir procesos en evolución</h2>
        <p class="home-path-description">
          Expedientes con señales fechadas, actores, fuentes y valoraciones
          editoriales.
        </p>
        <p class="home-path-count">{processCountLabel}</p>
        <a class="home-path-link" href="/observatorio/">
          Explorar el Observatorio <span aria-hidden="true">→</span>
        </a>
      </article>
    </section>
  </div>
</SiteLayout>

<style>
  .home-shell {
    width: var(--content);
    margin-inline: auto;
    padding-block: clamp(2.5rem, 6vw, 5.5rem);
  }

  .home-intro {
    max-width: 58rem;
  }

  .home-intro h1 {
    max-width: 15ch;
    margin: 0.6rem 0 0;
    font-family: var(--serif);
    font-size: clamp(2.75rem, 6vw, 5.4rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .home-lead {
    max-width: 47rem;
    margin: 1.6rem 0 0;
    color: var(--ink-700);
    font-size: clamp(1.05rem, 1.7vw, 1.25rem);
    text-wrap: pretty;
  }

  .home-paths {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.4vw, 1.75rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .home-path {
    display: flex;
    min-width: 0;
    min-height: 20rem;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--line);
    border-top: 3px solid var(--amber);
    border-radius: var(--radius);
  }

  .home-path--publications {
    background:
      linear-gradient(145deg, rgb(255 240 216 / 38%), transparent 58%),
      var(--surface);
  }

  .home-path--observatory {
    background:
      linear-gradient(145deg, rgb(229 240 245 / 88%), transparent 72%),
      var(--surface);
  }

  .home-path-category {
    margin: 0;
    color: var(--amber);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .home-path h2 {
    max-width: 18ch;
    margin: 0.55rem 0 0;
    font-family: var(--serif);
    font-size: clamp(1.8rem, 3vw, 2.55rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .home-path-description {
    max-width: 38rem;
    margin: 1rem 0 0;
    color: var(--ink-700);
    font-size: 0.95rem;
  }

  .home-path-count {
    margin: 1.5rem 0 0;
    color: var(--ink-600);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .home-path-link {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    min-height: 2.75rem;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1.5rem;
    color: var(--ink-950);
    font-size: 0.86rem;
    font-weight: 800;
    text-decoration-line: underline;
    text-decoration-color: var(--amber);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  .home-path-link span {
    transition: transform 160ms ease;
  }

  .home-path-link:hover span {
    transform: translateX(0.2rem);
  }

  .home-path-link:active {
    transform: translateY(1px);
  }

  @media (max-width: 760px) {
    .home-shell {
      padding-block: 2.25rem 3.5rem;
    }

    .home-intro h1 {
      font-size: clamp(2.35rem, 12vw, 3.7rem);
    }

    .home-paths {
      grid-template-columns: 1fr;
    }

    .home-path {
      min-height: 18rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-path-link span {
      transition: none;
    }
  }
</style>
