---
import { getRelativeTime } from '../utils/time';
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import macroData from '../data/macro.json';

// Consultas a las Content Collections
const ensayos = await getCollection('ensayos');
const alertasBrutas = await getCollection('alertas');

// 1. Resolvemos el contenido asíncrono AQUÍ ARRIBA usando Promise.all
const alertas = await Promise.all(
  alertasBrutas.map(async (alerta) => {
    const { Content } = await render(alerta);
    return { ...alerta, Content };
  }),
);

// Ordenamiento de ensayos
const ensayosOrdenados = ensayos.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Limitar a los 5 más recientes
const ensayosRecientes = ensayosOrdenados.slice(0, 5);

// Mapear datos para el script del cliente
const mapAlertasData = alertas.map((alerta) => ({
  lat: alerta.data.lat,
  lng: alerta.data.lng,
  severity: alerta.data.severity,
}));
---

<Layout>
  <script src="https://unpkg.com/@phosphor-icons/web" is:inline></script>
  <script src="https://cdn.jsdelivr.net/npm/d3@7.9.0" is:inline></script>
  <script src="https://cdn.jsdelivr.net/npm/@observablehq/plot@0.6.16" is:inline
  ></script>

  <style is:global>
    h1,
    h2,
    h3,
    h4,
    h5,
    h6,
    .font-serif {
      font-family: 'Playfair Display', serif;
    }
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    @keyframes pulse-ring {
      0% {
        transform: scale(0.8);
        opacity: 0.5;
      }
      100% {
        transform: scale(2.5);
        opacity: 0;
      }
    }
    .pulse-dot {
      position: relative;
    }
    .pulse-dot::before {
      content: '';
      position: absolute;
      left: -50%;
      top: -50%;
      width: 200%;
      height: 200%;
      background-color: inherit;
      border-radius: 50%;
      z-index: -1;
      animation: pulse-ring 2s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
    }
    .map-bg {
      background-color: #e2e8f0;
      background-image: radial-gradient(#cbd5e1 1px, transparent 1px);
      background-size: 20px 20px;
    }
  </style>

  <header class="bg-slate-900 text-white sticky top-0 z-50 shadow-md">
    <div
      class="max-w-screen-2xl mx-auto px-4 lg:px-6 h-16 flex items-center justify-between"
    >
      <div class="flex items-center gap-2">
        <i class="ph-fill ph-globe-hemisphere-west text-2xl text-red-600"></i>
        <h1 class="text-xl font-bold tracking-tight uppercase font-sans">
          Memo Geopolítico
        </h1>
        <span
          class="ml-2 px-2 py-0.5 text-[10px] bg-white/10 text-white rounded border border-white/20"
          >BETA</span
        >
      </div>
      <div class="hidden md:flex items-center gap-6">
        <div class="relative">
          <i
            class="ph ph-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"
          ></i>
          <input
            type="text"
            placeholder="Buscar región o tema..."
            class="bg-white/10 border border-white/20 rounded-full py-1.5 pl-9 pr-4 text-sm text-white placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-red-600 w-64 transition-all"
          />
        </div>
        <nav class="flex gap-4 text-sm font-medium">
          <a href="#" class="text-white hover:text-red-600 transition-colors"
            >Panorama Global</a
          >
          <a href="#" class="text-gray-300 hover:text-white transition-colors"
            >Ensayos</a
          >
          <a href="#" class="text-gray-300 hover:text-white transition-colors"
            >Datos Macro</a
          >
        </nav>
      </div>
      <button
        class="bg-red-600 hover:bg-red-700 text-white text-sm font-medium py-1.5 px-4 rounded transition-colors hidden sm:block"
        >Suscribirse</button
      >
    </div>
  </header>

  <main
    class="flex-1 max-w-screen-2xl mx-auto w-full px-4 lg:px-6 py-6 grid grid-cols-1 lg:grid-cols-12 gap-6 bg-slate-100"
  >
    <aside class="lg:col-span-3 flex flex-col gap-4">
      <div
        class="flex items-center justify-between border-b border-slate-300 pb-2"
      >
        <h2
          class="text-xs font-bold uppercase tracking-wider text-slate-500 flex items-center gap-2"
        >
          <i class="ph-fill ph-warning-circle text-red-600"></i> Alertas y Focos
        </h2>
        <span class="text-[10px] text-slate-400">Actualizado 09:00</span>
      </div>
      <div
        id="alertas-container"
        class="flex flex-col gap-3 overflow-y-auto max-h-[calc(100vh-140px)] no-scrollbar pb-10"
      >
        {
          alertas.map((alerta) => {
            const { Content } = alerta;

            // Diccionario de estilos según el nivel de severity
            const style = {
              critical: {
                border: 'border-red-200',
                bg: 'bg-red-50',
                bar: 'bg-red-600',
                text: 'text-red-700',
              },
              medium: {
                border: 'border-orange-200',
                bg: 'bg-orange-50',
                bar: 'bg-orange-500',
                text: 'text-orange-700',
              },
              low: {
                border: 'border-yellow-200',
                bg: 'bg-yellow-50',
                bar: 'bg-yellow-400',
                text: 'text-yellow-700',
              },
            }[alerta.data.severity];

            return (
              <article
                class={`p-4 rounded-lg border ${style.border} ${style.bg} hover:shadow-md transition-shadow duration-200 cursor-pointer relative`}
              >
                <div
                  class={`absolute left-0 top-0 bottom-0 w-1 ${style.bar} rounded-l-lg`}
                />

                <div class="flex justify-between items-center mb-1.5 pl-1">
                  <span
                    class={`text-[10px] font-bold uppercase tracking-wider ${style.text}`}
                  >
                    {alerta.data.region}
                  </span>
                  <span class="text-[10px] text-slate-400 font-medium">
                    <span class="text-[10px] text-slate-400 font-medium">
                      {getRelativeTime(alerta.data.date)}
                    </span>
                  </span>
                </div>

                <h3 class="text-sm font-bold text-slate-900 mb-1.5 pl-1">
                  {alerta.data.title}
                </h3>

                <div class="text-xs text-slate-600 leading-snug pl-1">
                  <Content />
                </div>
              </article>
            );
          })
        }
      </div>
    </aside>

    <section class="lg:col-span-6 flex flex-col gap-6">
      <div
        class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden flex flex-col"
      >
        <div
          class="px-4 py-3 border-b border-slate-100 flex justify-between items-center bg-slate-50"
        >
          <h2 class="text-sm font-semibold text-slate-800">
            Termómetro Global
          </h2>
          <div class="flex gap-2">
            <span
              class="flex items-center gap-1 text-[10px] text-slate-500 font-medium"
              ><div class="w-2 h-2 rounded-full bg-red-600"></div> Crítico</span
            >
            <span
              class="flex items-center gap-1 text-[10px] text-slate-500 font-medium"
              ><div class="w-2 h-2 rounded-full bg-orange-500"></div> Medio</span
            >
            <span
              class="flex items-center gap-1 text-[10px] text-slate-500 font-medium"
              ><div class="w-2 h-2 rounded-full bg-yellow-400"></div> Bajo</span
            >
          </div>
        </div>
        <div
          class="w-full h-64 map-bg relative flex items-center justify-center overflow-hidden"
        >
          <img
            src="https://upload.wikimedia.org/wikipedia/commons/8/80/World_map_-_low_resolution.svg"
            class="absolute w-[120%] max-w-none h-auto opacity-20 pointer-events-none grayscale"
            style="top: -20%;"
            alt="Mapamundi"
          />
          <div id="map-markers-container" class="absolute inset-0"></div>
        </div>
      </div>

      <div
        class="flex items-center justify-between border-b border-slate-300 pb-2 mt-2"
      >
        <h2
          class="text-xs font-bold uppercase tracking-wider text-slate-500 flex items-center gap-2"
        >
          <i class="ph-fill ph-article text-slate-700"></i> Análisis a Fondo
        </h2>
      </div>
      <div id="ensayos-container" class="flex flex-col gap-5">
        {
          ensayosRecientes.map((ensayo) => (
            <a
              href={`/ensayos/${ensayo.id}`}
              data-astro-prefetch
              class="block group"
            >
              <article class="border border-slate-200 bg-white rounded-xl p-5 transition-shadow duration-200 hover:shadow-md">
                <h3 class="text-xl font-serif font-bold text-slate-900 mb-2 group-hover:text-slate-700 transition-colors">
                  {ensayo.data.title}
                </h3>
                <p class="text-sm text-slate-600 mb-4 line-clamp-3">
                  {ensayo.data.description}
                </p>
                <div class="flex items-center justify-between">
                  <div class="flex gap-2">
                    {ensayo.data.tags?.map((t) => (
                      <span class="px-2 py-1 bg-slate-100 text-slate-600 text-[10px] font-medium rounded-full">
                        {t}
                      </span>
                    ))}
                  </div>
                  <div class="text-xs text-slate-500 font-sans">
                    <time datetime={ensayo.data.date.toISOString()}>
                      {ensayo.data.date.toLocaleDateString('es-ES', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                      })}
                    </time>
                    <span class="mx-1">&bull;</span>
                    <span>{ensayo.data.author}</span>
                  </div>
                </div>
              </article>
            </a>
          ))
        }
      </div>
    </section>

    <aside class="lg:col-span-3 flex flex-col gap-6">
      <div
        class="flex items-center justify-between border-b border-slate-300 pb-2"
      >
        <h2
          class="text-xs font-bold uppercase tracking-wider text-slate-500 flex items-center gap-2"
        >
          <i class="ph-fill ph-chart-bar text-slate-700"></i> Indicadores Macro
        </h2>
      </div>
      <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200">
        <h3 class="text-xs font-semibold text-slate-800 mb-1">
          Gasto en Defensa Regional
        </h3>
        <div id="chart-defensa" class="w-full mt-3"></div>
      </div>
      <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200">
        <h3 class="text-xs font-semibold text-slate-800 mb-1">
          Vulnerabilidad Energética
        </h3>
        <div id="chart-energia" class="w-full mt-3"></div>
      </div>
    </aside>
  </main>

  <!-- Inyectar las variables de servidor al script del cliente y aplicar defer -->
  <script
    is:inline
    define:vars={{ alertasData: mapAlertasData, datosGraficos: macroData }}
    defer
  >
    document.addEventListener('DOMContentLoaded', () => {
      const mapContainer = document.getElementById('map-markers-container');

      alertasData.forEach((alerta) => {
        // Definir los colores para los marcadores
        const markerColors = {
          critical: 'bg-red-600',
          medium: 'bg-orange-500',
          low: 'bg-yellow-400',
        };

        const markerColor = markerColors[alerta.severity] || 'bg-gray-500';

        const marker = document.createElement('div');
        marker.className = `absolute w-3 h-3 rounded-full pulse-dot ${markerColor} shadow-lg border border-white`;

        const topPerc = 50 - (alerta.lat / 90) * 50;
        const leftPerc = 50 + (alerta.lng / 180) * 50;

        marker.style.top = `${topPerc}%`;
        marker.style.left = `${leftPerc}%`;

        if (mapContainer) mapContainer.appendChild(marker);
      });

      // IntersectionObserver para los gráficos
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            if (
              entry.target.id === 'chart-defensa' &&
              !entry.target.hasChildNodes() &&
              window.Plot
            ) {
              entry.target.appendChild(
                window.Plot.plot({
                  width: 280,
                  height: 120,
                  marginLeft: 80,
                  x: { grid: true },
                  marks: [
                    window.Plot.barX(datosGraficos.gasto_defensa, {
                      x: 'valor',
                      y: 'region',
                      fill: '#0f172a',
                      sort: { y: 'x', reverse: true },
                    }),
                  ],
                }),
              );
            }
            if (
              entry.target.id === 'chart-energia' &&
              !entry.target.hasChildNodes() &&
              window.Plot
            ) {
              entry.target.appendChild(
                window.Plot.plot({
                  width: 280,
                  height: 120,
                  marginLeft: 70,
                  x: { grid: true, domain: [0, 100] },
                  marks: [
                    window.Plot.ruleY(datosGraficos.energia, {
                      y: 'pais',
                      strokeOpacity: 0.2,
                    }),
                    window.Plot.dot(datosGraficos.energia, {
                      x: 'score',
                      y: 'pais',
                      // Nueva lógica de 3 colores coherente con el mapa
                      fill: (d) =>
                        d.score >= 80
                          ? '#dc2626'
                          : d.score >= 50
                            ? '#f97316'
                            : '#facc15',
                      r: 5,
                      sort: { y: 'x', reverse: true },
                    }),
                  ],
                }),
              );
            }
          }
        });
      });

      const chartDefensa = document.getElementById('chart-defensa');
      const chartEnergia = document.getElementById('chart-energia');

      if (chartDefensa) observer.observe(chartDefensa);
      if (chartEnergia) observer.observe(chartEnergia);
    });
  </script>
</Layout>
