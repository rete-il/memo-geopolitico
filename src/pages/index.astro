---
import SiteLayout from '../layouts/SiteLayout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeFeatured from '../components/home/HomeFeatured.astro';
import HomeMethod from '../components/home/HomeMethod.astro';
import HomeTopics from '../components/home/HomeTopics.astro';
import HomeLatest from '../components/home/HomeLatest.astro';
import HomePaths from '../components/home/HomePaths.astro';
import HomeOpinion from '../components/HomeOpinion.astro';
import { homeConfig } from '../config/home';
import { catalog, publicProcesses, sourceById } from '../lib/data';
import { getPublicationEntries } from '../lib/publications';
import { selectHomeContent } from '../lib/home';
import { opinionReadings } from '../lib/opinion';

const publications = await getPublicationEntries({
  includePreview: false,
  publishedOnly: true,
});
const home = selectHomeContent({
  publications,
  processes: publicProcesses,
  themes: catalog('temas'),
  sourceById,
}, homeConfig);
---

<SiteLayout description={homeConfig.description}>
  <div class="home-shell">
    <HomeHero hasThemes={home.themes.length > 0} />
    <HomePaths counts={home.counts} />
    {home.featured && <HomeFeatured featured={home.featured} evaluation={home.evaluation} />}
    <HomeMethod />
    <HomeTopics themes={home.themes} />
    <HomeLatest publications={home.latest} />
    <HomeOpinion readings={opinionReadings} />
  </div>
</SiteLayout>

<style>
  .home-shell {
    width: var(--content);
    margin-inline: auto;
    padding-block: var(--section-padding);
    overflow-wrap: anywhere;
  }
</style>
