---
import { getRelativeTime } from '../utils/time';
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import macroData from '../data/macro.json';
import AlertCard from '../components/AlertCard.astro';

const ensayos = await getCollection('ensayos');
const alertasBrutas = await getCollection('alertas');

const alertas = await Promise.all(
  alertasBrutas.map(async (alerta) => {
    const { Content } = await render(alerta);
    return { ...alerta, Content };
  }),
);

const ensayosOrdenados = ensayos.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const ensayosRecientes = ensayosOrdenados.slice(0, 5);

const mapAlertasData = alertas.map((alerta) => ({
  id: alerta.id,
  lat: alerta.data.lat,
  lng: alerta.data.lng,
  severity: alerta.data.severity,
}));
---

<Layout>
  <!-- Inclusión de librerías D3 y TopoJSON requeridas para el mapa -->
  <script src="https://unpkg.com/@phosphor-icons/web" is:inline></script>
  <script src="https://cdn.jsdelivr.net/npm/d3@7.9.0" is:inline></script>
  <script src="https://unpkg.com/topojson-client@3" is:inline></script>
  <script src="https://cdn.jsdelivr.net/npm/@observablehq/plot@0.6.16" is:inline
  ></script>

  <style is:global>
    h1,
    h2,
    h3,
    h4,
    h5,
    h6,
    .font-serif {
      font-family: 'Playfair Display', serif;
    }
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .map-bg {
      background-color: #e2e8f0;
      background-image: radial-gradient(#cbd5e1 1px, transparent 1px);
      background-size: 20px 20px;
    }
    /* Estilos de cursor para el Panning del mapa */
    .map-grabbing {
      cursor: grabbing !important;
    }
    /* Animación de pulso optimizada para SVG */
    @keyframes pulse-ring-svg {
      0% {
        r: 4px;
        opacity: 0.8;
        stroke-width: 2px;
      }
      100% {
        r: 18px;
        opacity: 0;
        stroke-width: 0px;
      }
    }
    .pulse-animation-svg {
      animation: pulse-ring-svg 1.5s cubic-bezier(0.215, 0.61, 0.355, 1)
        infinite;
    }
  </style>

  <header class="bg-slate-900 text-white sticky top-0 z-50 shadow-md">
    <div
      class="max-w-screen-2xl mx-auto px-4 lg:px-6 h-16 flex items-center justify-between"
    >
      <div class="flex items-center gap-2">
        <i class="ph-fill ph-globe-hemisphere-west text-2xl text-red-600"></i>
        <h1 class="text-xl font-bold tracking-tight uppercase font-sans">
          Memo Geopolítico
        </h1>
        <span
          class="ml-2 px-2 py-0.5 text-[10px] bg-white/10 text-white rounded border border-white/20"
          >BETA</span
        >
      </div>
      <div class="hidden md:flex items-center gap-6">
        <div class="relative">
          <i
            class="ph ph-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"
          ></i>
          <input
            type="text"
            placeholder="Buscar región o tema..."
            class="bg-white/10 border border-white/20 rounded-full py-1.5 pl-9 pr-4 text-sm text-white placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-red-600 w-64 transition-all"
          />
        </div>
        <nav class="flex gap-4 text-sm font-medium">
          <a href="#" class="text-white hover:text-red-600 transition-colors"
            >Panorama Global</a
          >
          <a href="#" class="text-gray-300 hover:text-white transition-colors"
            >Ensayos</a
          >
          <a href="#" class="text-gray-300 hover:text-white transition-colors"
            >Datos Macro</a
          >
        </nav>
      </div>
      <button
        class="bg-red-600 hover:bg-red-700 text-white text-sm font-medium py-1.5 px-4 rounded transition-colors hidden sm:block"
        >Suscribirse</button
      >
    </div>
  </header>

  <main
    class="flex-1 max-w-screen-2xl mx-auto w-full px-4 lg:px-6 py-6 grid grid-cols-1 lg:grid-cols-12 gap-6 bg-slate-100"
  >
    <aside class="lg:col-span-3 flex flex-col gap-4">
      <div
        class="flex items-center justify-between border-b border-slate-300 pb-2"
      >
        <h2
          class="text-xs font-bold uppercase tracking-wider text-slate-500 flex items-center gap-2"
        >
          <i class="ph-fill ph-warning-circle text-red-600"></i> Alertas y Focos
        </h2>
        <span class="text-[10px] text-slate-400">Actualizado 09:00</span>
      </div>
      <div
        id="alertas-container"
        class="flex flex-col gap-3 overflow-y-auto max-h-[calc(100vh-140px)] no-scrollbar pb-10"
      >
        {
          alertas.map((alerta) => {
            const { Content } = alerta;
            return (
              <AlertCard alerta={alerta} slug={alerta.id}>
                <Content />
              </AlertCard>
            );
          })
        }
      </div>
    </aside>

    <section class="lg:col-span-6 flex flex-col gap-6">
      <div
        class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden flex flex-col"
      >
        <div
          class="px-4 py-3 border-b border-slate-100 flex justify-between items-center bg-slate-50"
        >
          <h2 class="text-sm font-semibold text-slate-800">
            Termómetro Global
          </h2>
          <div class="flex gap-2">
            <span
              class="flex items-center gap-1 text-[10px] text-slate-500 font-medium"
              ><div class="w-2 h-2 rounded-full bg-red-500"></div> Crítico</span
            >
            <span
              class="flex items-center gap-1 text-[10px] text-slate-500 font-medium"
              ><div class="w-2 h-2 rounded-full bg-amber-500"></div> Medio</span
            >
            <span
              class="flex items-center gap-1 text-[10px] text-slate-500 font-medium"
              ><div class="w-2 h-2 rounded-full bg-yellow-400"></div> Bajo</span
            >
          </div>
        </div>
        <!-- Contenedor del Mapa D3 interactivo con proporción fluida -->
        <div
          id="map-wrapper"
          class="w-full relative map-bg overflow-hidden"
          style="aspect-ratio: 2/1; cursor: grab;"
        >
          <!-- Overlay de alerta para scroll -->
          <div
            id="zoom-overlay"
            class="absolute inset-0 bg-slate-900/60 text-white flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300 z-20"
          >
            <span
              class="px-4 py-2 bg-slate-900/90 rounded font-medium shadow-lg"
              >Presiona Ctrl + Scroll para hacer zoom</span
            >
          </div>

          <!-- Controles UI de Zoom -->
          <div class="absolute bottom-4 right-4 flex flex-col gap-1 z-10">
            <button
              id="zoom-in"
              class="w-8 h-8 bg-white border border-slate-200 rounded text-slate-700 hover:bg-slate-50 shadow-sm flex items-center justify-center text-lg font-bold transition-colors"
              >+</button
            >
            <button
              id="zoom-out"
              class="w-8 h-8 bg-white border border-slate-200 rounded text-slate-700 hover:bg-slate-50 shadow-sm flex items-center justify-center text-lg font-bold transition-colors"
              >-</button
            >
          </div>
        </div>
      </div>

      <div
        class="flex items-center justify-between border-b border-slate-300 pb-2 mt-2"
      >
        <h2
          class="text-xs font-bold uppercase tracking-wider text-slate-500 flex items-center gap-2"
        >
          <i class="ph-fill ph-article text-slate-700"></i> Análisis a Fondo
        </h2>
      </div>
      <div id="ensayos-container" class="flex flex-col gap-5">
        {
          ensayosRecientes.map((ensayo) => (
            <a
              href={`/ensayos/${ensayo.id}`}
              data-astro-prefetch
              class="block group"
            >
              <article class="border border-slate-200 bg-white rounded-xl p-5 transition-shadow duration-200 hover:shadow-md">
                <h3 class="text-xl font-serif font-bold text-slate-900 mb-2 group-hover:text-slate-700 transition-colors">
                  {ensayo.data.title}
                </h3>
                <p class="text-sm text-slate-600 mb-4 line-clamp-3">
                  {ensayo.data.description}
                </p>
                <div class="flex items-center justify-between">
                  <div class="flex gap-2">
                    {ensayo.data.tags?.map((t) => (
                      <span class="px-2 py-1 bg-slate-100 text-slate-600 text-[10px] font-medium rounded-full">
                        {t}
                      </span>
                    ))}
                  </div>
                  <div class="text-xs text-slate-500 font-sans">
                    <time datetime={ensayo.data.date.toISOString()}>
                      {ensayo.data.date.toLocaleDateString('es-ES', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                      })}
                    </time>
                    <span class="mx-1">&bull;</span>
                    <span>{ensayo.data.author}</span>
                  </div>
                </div>
              </article>
            </a>
          ))
        }
      </div>
    </section>

    <aside class="lg:col-span-3 flex flex-col gap-6">
      <div
        class="flex items-center justify-between border-b border-slate-300 pb-2"
      >
        <h2
          class="text-xs font-bold uppercase tracking-wider text-slate-500 flex items-center gap-2"
        >
          <i class="ph-fill ph-chart-bar text-slate-700"></i> Indicadores Macro
        </h2>
      </div>
      <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200">
        <h3 class="text-xs font-semibold text-slate-800 mb-1">
          Gasto en Defensa Regional
        </h3>
        <div id="chart-defensa" class="w-full mt-3"></div>
      </div>
      <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200">
        <h3 class="text-xs font-semibold text-slate-800 mb-1">
          Vulnerabilidad Energética
        </h3>
        <div id="chart-energia" class="w-full mt-3"></div>
      </div>
    </aside>
  </main>

  <script
    is:inline
    define:vars={{ alertasData: mapAlertasData, datosGraficos: macroData }}
    defer
  >
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Configuración Base del Mapa D3
      const wrapper = document.getElementById('map-wrapper');
      const overlay = document.getElementById('zoom-overlay');
      let width = wrapper.clientWidth;
      let height = wrapper.clientHeight;

      const svg = window.d3
        .select('#map-wrapper')
        .insert('svg', ':first-child')
        .attr('width', width)
        .attr('height', height);

      const g = svg.append('g');

      // Proyección Mercator ajustada automáticamente al tamaño del contenedor
      const projection = window.d3
        .geoMercator()
        .fitSize([width, height], { type: 'Sphere' });
      const path = window.d3.geoPath().projection(projection);

      // Comportamiento del Zoom y Panning (Límites de Traslación aplicados en el ResizeObserver)
      const zoom = window.d3
        .zoom()
        .scaleExtent([1, 8])
        .wheelDelta((event) => {
          // Anulamos el multiplicador x10 de D3 al presionar Ctrl para suavizar la rueda del ratón
          return (
            -event.deltaY *
            (event.deltaMode === 1 ? 0.05 : event.deltaMode ? 1 : 0.0015)
          );
        })
        .filter((event) => {
          // Bloquear zoom con rueda del ratón si no se presiona Ctrl
          if (event.type === 'wheel') return event.ctrlKey || event.metaKey;
          return !event.button; // Permitir arrastre con click izquierdo
        })
        .on('zoom', (event) => {
          g.attr('transform', event.transform);
        });

      svg.call(zoom);

      // Clases para el estado de arrastre (grab/grabbing)
      svg
        .on('mousedown', () => wrapper.classList.add('map-grabbing'))
        .on('mouseup', () => wrapper.classList.remove('map-grabbing'))
        .on('mouseleave', () => wrapper.classList.remove('map-grabbing'));

      // Interceptar scroll en el contenedor para mostrar advertencia del Ctrl
      let overlayTimeout;
      wrapper.addEventListener(
        'wheel',
        (e) => {
          if (!e.ctrlKey && !e.metaKey) {
            e.preventDefault();
            overlay.classList.remove('opacity-0');
            clearTimeout(overlayTimeout);
            overlayTimeout = setTimeout(
              () => overlay.classList.add('opacity-0'),
              1500,
            );
          }
        },
        { passive: false },
      );

      // Botones de Zoom UI
      document.getElementById('zoom-in').addEventListener('click', () => {
        svg.transition().duration(400).call(zoom.scaleBy, 1.5);
      });
      document.getElementById('zoom-out').addEventListener('click', () => {
        svg.transition().duration(400).call(zoom.scaleBy, 0.75);
      });

      // 2. Cargar Cartografía e inyectar Marcadores
      window.d3
        .json('https://unpkg.com/world-atlas@2.0.2/countries-110m.json')
        .then((world) => {
          const countries = window.topojson.feature(
            world,
            world.objects.countries,
          ).features;

          // Dibujar países
          const pathGroup = g.append('g');
          pathGroup
            .selectAll('path')
            .data(countries)
            .join('path')
            .attr('fill', '#cbd5e1')
            .attr('stroke', '#f8fafc')
            .attr('stroke-width', 0.5)
            .attr('d', path);

          // Configurar y dibujar marcadores (Alertas)
          const markerGroup = g.append('g');
          const markerColors = {
            critical: '#ef4444',
            medium: '#f59e0b',
            low: '#facc15',
          };

          const markers = markerGroup
            .selectAll('g.marker')
            .data(alertasData)
            .join('g')
            .attr('class', 'marker')
            .attr('data-marker-id', (d) => d.id)
            .attr('transform', (d) => {
              const [x, y] = projection([d.lng, d.lat]) || [0, 0];
              return `translate(${x},${y})`;
            });

          // Círculo base para la animación del pulso
          markers
            .append('circle')
            .attr('class', 'pulse-ring-target')
            .attr('r', 4)
            .attr('fill', 'transparent')
            .attr('stroke', (d) => markerColors[d.severity] || '#64748b')
            .attr('stroke-width', 2)
            .style('pointer-events', 'none');

          // Círculo sólido (Centro)
          markers
            .append('circle')
            .attr('r', 4)
            .attr('fill', (d) => markerColors[d.severity] || '#64748b')
            .attr('stroke', '#ffffff')
            .attr('stroke-width', 1.5);

          // ResizeObserver para mantener la proporción y las coordenadas al redimensionar
          const resizeObserver = new ResizeObserver((entries) => {
            for (let entry of entries) {
              width = entry.contentRect.width;
              height = entry.contentRect.height;

              svg.attr('width', width).attr('height', height);

              // Recalcular proyección (Centrado y zoom 1 base)
              projection.fitSize([width, height], { type: 'Sphere' });
              pathGroup.selectAll('path').attr('d', path);

              // Recalcular límite (Boundary Box) del paneo
              zoom.translateExtent([
                [0, 0],
                [width, height],
              ]);

              // Reposicionar anclaje de los marcadores usando matemáticas cartográficas
              markers.attr('transform', (d) => {
                const [x, y] = projection([d.lng, d.lat]) || [0, 0];
                return `translate(${x},${y})`;
              });
            }
          });
          resizeObserver.observe(wrapper);
        });

      // 3. Sincronización Interactiva (Hover de Tarjeta -> Animación en Mapa)
      const alertCards = document.querySelectorAll('.alert-card');
      alertCards.forEach((card) => {
        card.addEventListener('mouseenter', () => {
          const slug = card.dataset.slug;
          const markerRing = document.querySelector(
            `g.marker[data-marker-id="${slug}"] .pulse-ring-target`,
          );
          if (markerRing) markerRing.classList.add('pulse-animation-svg');
        });

        card.addEventListener('mouseleave', () => {
          const slug = card.dataset.slug;
          const markerRing = document.querySelector(
            `g.marker[data-marker-id="${slug}"] .pulse-ring-target`,
          );
          if (markerRing) markerRing.classList.remove('pulse-animation-svg');
        });
      });

      // 4. Observador de Gráficos (Plot/D3) ya existente
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            if (
              entry.target.id === 'chart-defensa' &&
              !entry.target.hasChildNodes() &&
              window.Plot
            ) {
              entry.target.appendChild(
                window.Plot.plot({
                  width: 280,
                  height: 120,
                  marginLeft: 80,
                  x: { grid: true },
                  marks: [
                    window.Plot.barX(datosGraficos.gasto_defensa, {
                      x: 'valor',
                      y: 'region',
                      fill: '#0f172a',
                      sort: { y: 'x', reverse: true },
                    }),
                  ],
                }),
              );
            }
            if (
              entry.target.id === 'chart-energia' &&
              !entry.target.hasChildNodes() &&
              window.Plot
            ) {
              entry.target.appendChild(
                window.Plot.plot({
                  width: 280,
                  height: 120,
                  marginLeft: 70,
                  x: { grid: true, domain: [0, 100] },
                  marks: [
                    window.Plot.ruleY(datosGraficos.energia, {
                      y: 'pais',
                      strokeOpacity: 0.2,
                    }),
                    window.Plot.dot(datosGraficos.energia, {
                      x: 'score',
                      y: 'pais',
                      fill: (d) =>
                        d.score >= 80
                          ? '#ef4444'
                          : d.score >= 50
                            ? '#f59e0b'
                            : '#facc15',
                      r: 5,
                      sort: { y: 'x', reverse: true },
                    }),
                  ],
                }),
              );
            }
          }
        });
      });

      const chartDefensa = document.getElementById('chart-defensa');
      const chartEnergia = document.getElementById('chart-energia');

      if (chartDefensa) observer.observe(chartDefensa);
      if (chartEnergia) observer.observe(chartEnergia);
    });
  </script>
</Layout>
