---
import PageTitle from '../../components/PageTitle.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { visualResources, visualResourcesAvailable } from '../../lib/visual-resources';
---

<SiteLayout
  title="Recursos visuales"
  description="Mapas, cronologías, gráficos e infografías vinculados con los procesos del Observatorio."
  noindex={!visualResourcesAvailable}
>
  <div class="page-shell">
    <header class="page-intro">
      <div>
        <p class="eyebrow">Recursos visuales</p>
        <PageTitle>Ver relaciones que el texto no muestra de inmediato</PageTitle>
      </div>
      <p>
        Mapas, cronologías, gráficos e infografías para comprender los procesos
        del Observatorio. Cada recurso conserva su contexto y sus fuentes.
      </p>
    </header>

    <section class="section-shell">
      {visualResourcesAvailable ? <div class="publication-grid">
        {visualResources.map(resource => <article class="publication-card">
          <h2><a href={resource.url}>{resource.titulo}</a></h2>
          {resource.descripcion && <p>{resource.descripcion}</p>}
        </article>)}
      </div> : <div class="empty-state">
        <h2>Próximamente</h2>
        <p>
          Los recursos visuales se incorporarán a medida que estén disponibles.
          Mientras tanto, pueden consultarse los <a href="/publicaciones/">análisis publicados</a>.
        </p>
      </div>}
    </section>
  </div>
</SiteLayout>
