---
import ActionLink from '../../components/ActionLink.astro';
import type { GetStaticPaths } from 'astro';
import ReadingLinks from '../../components/ReadingLinks.astro';
import { destinationKey } from '../../../tools/lib/navigation-policy.mjs';
import OpinionCard from '../../components/OpinionCard.astro';
import EditorialImage from '../../components/EditorialImage.astro';
import PageTitle from '../../components/PageTitle.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { opinionReadings, type OpinionReading } from '../../lib/opinion';
import { formatDate } from '../../lib/text';

export const getStaticPaths = (() => {
  if (!opinionReadings.length) return [];
  return [
    { params: { slug: undefined }, props: { reading: null } },
    ...opinionReadings.map((reading) => ({
      params: { slug: reading.slug },
      props: { reading },
    })),
  ];
}) satisfies GetStaticPaths;

interface Props { reading: OpinionReading | null; }
const { reading } = Astro.props;
const localDraft = reading
  ? reading.estado === 'borrador'
  : opinionReadings.some((item) => item.estado === 'borrador');
---

<SiteLayout
  title={reading ? `${reading.titulo} · Opinión` : 'Opinión'}
  description={reading?.descripcion || 'Firmas y perspectivas sobre las transformaciones del mundo. Lecturas seleccionadas por Memo Geopolítico.'}
  noindex={localDraft}
>
  <div class="opinion-shell">
    {localDraft && <p class="local-notice" role="status">Vista local · Pendiente de publicación</p>}
    {reading ? (
      <>
        <nav class="reading-breadcrumb" aria-label="Ruta de lectura">
          <a href="/opinion/">Opinión</a><span aria-hidden="true">/</span><span>{reading.formato === 'entrevista' ? 'Entrevista recomendada' : 'Lectura recomendada'}</span>
        </nav>
        <article>
          <header class="reading-header">
            <p class="eyebrow">Opinión · {reading.origen.medio}</p>
            <PageTitle class="reading-title">{reading.titulo}</PageTitle>
            <p class="reading-deck">{reading.descripcion}</p>
            <div class="reading-byline">
              <div>
                <span>{reading.formato === 'entrevista' ? 'Persona entrevistada' : 'Autor del artículo original'}</span>
                <strong>{reading.autor.nombre}</strong>
              </div>
              <div>
                <span>Publicado en {reading.origen.medio}</span>
                <time datetime={reading.origen.fecha}>{formatDate(reading.origen.fecha)}</time>
              </div>
            </div>
            {reading.entrevistador && <p>Entrevista de {reading.entrevistador}.</p>}
            {reading.origen.fecha_emision && <p>Fecha del programa: <time datetime={reading.origen.fecha_emision}>{formatDate(reading.origen.fecha_emision)}</time>.</p>}
            {reading.incorporado_el && <p>Incorporado a Memo Geopolítico: <time datetime={reading.incorporado_el}>{formatDate(reading.incorporado_el)}</time>.</p>}
          </header>
          {reading.perfil_entrevistador && <aside class="interviewer-note" aria-labelledby="interviewer-title">
            <p class="eyebrow">El periodista detrás de la entrevista</p>
            <h2 id="interviewer-title">{reading.entrevistador}</h2>
            <p class="interviewer-intro">{reading.perfil_entrevistador.presentacion}</p>
            <dl class="interviewer-milestones">{reading.perfil_entrevistador.hitos.map(hito => <div><dt>{hito.titulo}</dt><dd>{hito.texto}</dd></div>)}</dl>
            <p class="interviewer-sources">Fuentes de la reseña: {reading.perfil_entrevistador.fuentes.map((fuente, i) => <>{i > 0 && ' · '}<a href={fuente.url} target="_blank" rel="noopener noreferrer">{fuente.titulo}<span class="sr-only"> (abre otra pestaña)</span></a></>)}</p>
          </aside>}
          <div class="reading-columns">
            <section class="reading-summary" aria-labelledby="summary-title">
              <p class="eyebrow">Presentación de Memo Geopolítico</p>
              <h2 id="summary-title">Claves de esta lectura</h2>
              {reading.resumen.map((paragraph) => <p>{paragraph}</p>)}
              {reading.nota_revision && <aside class="editorial-note"><p>{reading.nota_revision}</p></aside>}
              <div class="source-action">
                <ActionLink arrow href={reading.origen.url} target="_blank" rel="noopener noreferrer">{reading.formato === 'entrevista' ? 'Ver nota y acceso a la entrevista' : `Leer artículo completo en ${reading.origen.medio}`}<span class="sr-only"> (abre otra pestaña)</span></ActionLink>
                {reading.origen.audio_url && <p><a href={reading.origen.audio_url} target="_blank" rel="noopener noreferrer">Escuchar episodio en Spotify</a></p>}
                <p>{reading.formato === 'entrevista' ? 'Presentación propia basada en la nota de Canal Net. El material original se consulta en el medio de origen.' : 'El texto íntegro se lee en el medio de origen.'}</p>
              </div>
              <ReadingLinks title="Análisis y documentación asociados" items={reading.relacionados.map(item => ({
                href: item.url.startsWith('/observatorio/') && !item.url.includes('#') ? `${item.url}#fuentes` : item.url,
                label: item.titulo,
              }))} />
            </section>
            <aside class="author-note" aria-labelledby="author-title">
              <p class="eyebrow">{reading.formato === 'entrevista' ? 'Sobre la persona entrevistada' : 'Sobre el autor'}</p>
              <h2 id="author-title">{reading.autor.nombre}</h2>
              <p>{reading.autor.biografia}</p>
              {destinationKey(reading.autor.url) !== destinationKey(reading.origen.url) && <a href={reading.autor.url} target="_blank" rel="noopener noreferrer">{reading.formato === 'entrevista' ? 'Consultar fuente original' : 'Más artículos del autor'}<span class="sr-only"> (abre otra pestaña)</span></a>}
            </aside>
          </div>
        </article>
      </>
    ) : (
      <>
        <header class="page-intro page-intro--illustrated">
          <div class="page-intro__copy">
            <p class="eyebrow">Memo Geopolítico</p>
            <PageTitle>Opinión</PageTitle>
            <p>Firmas y perspectivas sobre las transformaciones del mundo.</p>
            <p class="opinion-intro-note">Las últimas opiniones incorporadas al sitio aparecen primero. Cada ficha distingue la fecha de incorporación de la publicación original.</p>
          </div>
          <EditorialImage asset="opinion" />
        </header>
        <section class="opinion-readings" aria-label="Lecturas recomendadas">
          {opinionReadings.map((item) => <OpinionCard reading={item} />)}
        </section>
      </>
    )}
  </div>
</SiteLayout>

<style>
  .interviewer-note { margin-block: 2rem 3rem; padding: clamp(1.5rem, 4vw, 2.5rem); background: var(--amber-pale); border: 1px solid var(--line-strong); border-left: 4px solid var(--amber); }
  .interviewer-note h2 { margin: .6rem 0 1rem; font: var(--font-weight-medium) var(--type-section-size)/1.2 var(--serif); letter-spacing: -.025em; }
  .interviewer-intro { max-width: 62rem; color: var(--ink-700); line-height: 1.7; }
  .interviewer-milestones { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem 2.5rem; margin-block: 1.75rem; }
  .interviewer-milestones dt { font-weight: var(--font-weight-bold); color: var(--ink-800); }
  .interviewer-milestones dd { margin: .4rem 0 0; color: var(--ink-700); line-height: 1.65; }
  .interviewer-sources { margin-bottom: 0; font-size: var(--type-meta-size); line-height: 1.7; }
  .interviewer-sources a { text-decoration: underline; text-underline-offset: .2em; }
  @media (max-width: 600px) { .interviewer-milestones { grid-template-columns: 1fr; } }
  .opinion-shell { width: var(--content); margin-inline: auto; padding-block: clamp(2rem, 5vw, 4rem); }
  .local-notice { width: fit-content; margin: 0 0 2rem; padding: 0.45rem 0.75rem; border-left: 3px solid var(--amber); background: var(--amber-pale); color: var(--ink-800); font-size: var(--type-meta-size); }
  .page-intro__copy > p.opinion-intro-note { margin-top: var(--space-3); }
  .reading-breadcrumb { display: flex; flex-wrap: wrap; gap: 0.65rem; margin-bottom: 2rem; color: var(--ink-600); font-size: var(--type-meta-size); }
  .reading-header { max-width: 65rem; }
  :global(.reading-title) { max-width: 25ch; }
  .reading-deck { max-width: 48rem; margin-top: 1rem; color: var(--ink-700); font: var(--type-lead-size)/1.6 var(--sans); }
  .reading-byline { display: flex; flex-wrap: wrap; gap: 1.25rem 3rem; margin-block: 2rem; }
  .reading-byline > div { display: grid; gap: 0.3rem; }
  .reading-byline > div > span { color: var(--ink-600); font-size: var(--type-meta-size); }
  .reading-byline a, .reading-byline time { font-weight: var(--font-weight-bold); }
  .reading-columns { display: grid; grid-template-columns: minmax(0, 1fr) 18rem; align-items: start; gap: clamp(2rem, 6vw, 6rem); border-top: 1px solid var(--line-strong); padding-top: 2.5rem; }
  .reading-summary { max-width: 46rem; }
  .reading-summary h2 { margin-block: 0.55rem 1.25rem; font: var(--font-weight-medium) var(--type-section-size)/1.2 var(--serif); letter-spacing: -.025em; }
  .reading-summary > p:not(.eyebrow) { font: var(--type-reading-size)/1.82 var(--serif); }
  .source-action { margin-top: 2rem; }
  .source-action p { color: var(--ink-600); font-size: var(--type-meta-size); }
  .author-note { padding: 1.5rem; background: var(--blue-pale); border-top: 3px solid var(--blue); }
  .author-note h2 { margin-block: 0.7rem; font: var(--font-weight-medium) var(--type-subheading-size)/1.2 var(--serif); }
  .author-note > p:not(.eyebrow) { color: var(--ink-700); }
  .author-note a { font-size: var(--type-meta-size); text-decoration: underline; text-underline-offset: .2em; }
  @media (max-width: 800px) { .reading-columns { grid-template-columns: 1fr; } .author-note { max-width: 46rem; } }
</style>
