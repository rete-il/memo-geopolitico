---
import PageTitle from '../../components/PageTitle.astro';
import { render } from 'astro:content';
import ClassificationFooter from '../../components/ClassificationFooter.astro';
import ReadingLinks from '../../components/ReadingLinks.astro';
import { evidenceHref } from '../../../tools/lib/navigation-policy.mjs';
import SupportCTA from '../../components/SupportCTA.astro';
import CorrectionLink from '../../components/CorrectionLink.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import {
  catalogMaps,
  catalog,
  editorialPreviewEnabled,
  processes,
} from '../../lib/data';
import { topicHref, topicReferences } from '../../lib/taxonomy';
import {
  editorialStageLabel,
  formatDate,
  humanize,
} from '../../lib/text';
import {
  getPublicationEntries,
  type PublicationEntry,
} from '../../lib/publications';
import { processRectorIds } from '../../lib/process-relations';

export async function getStaticPaths() {
  const entries = await getPublicationEntries();
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

interface Props {
  entry: PublicationEntry;
}

const { entry } = Astro.props;
const showFullPublication =
  editorialPreviewEnabled || entry.data.publicacion.estado === 'publicado';
const rendered = showFullPublication ? await render(entry) : null;
const Content = rendered?.Content;
const process = processes.find(
  (item) => item.macroevento_id === entry.data.macroevento_principal_id,
);
const rectorProcesses = process
  ? processRectorIds(process)
      .map((id) => processes.find((item) => item.macroevento_id === id))
      .filter((item): item is (typeof processes)[number] => Boolean(item))
  : [];
const topics = topicReferences(entry.data.clasificacion, catalogMaps);
const primaryTopic = topics.find((topic) => topic.primary);
---

<SiteLayout
  title={entry.data.titulo}
  description={entry.data.resumen}
  article={entry.data.publicacion.estado === 'publicado' ? {
    headline: entry.data.titulo,
    description: entry.data.resumen,
    datePublished: entry.data.publicacion.publicado_el,
    dateModified: entry.data.publicacion.actualizado_el,
    author: entry.data.autor_ids.map((id) => ({ '@type': 'Person', name: catalog('autores').find(author => author.id === id)?.nombre || id })),
  } : undefined}
  noindex={entry.data.publicacion.estado !== 'publicado'}
>
  <div class="page-shell publication-page-shell">
    <header class="publication-hero publication-hero--editorial">
      <div class="publication-hero__primary">
        <p class="eyebrow detail-kicker">
          <span>{humanize(entry.data.tipo_publicacion)}</span>
          {
            primaryTopic && (
              <>
                <span aria-hidden="true">·</span>
                <a href={topicHref(primaryTopic)}>
                  {primaryTopic.item.nombre}
                </a>
              </>
            )
          }
        </p>
        <PageTitle>{entry.data.titulo}</PageTitle>
      </div>

      <div class="publication-hero__secondary">
        {entry.data.subtitulo && <p class="lead">{entry.data.subtitulo}</p>}
        <div class="hero-meta">
          {
            entry.data.publicacion.publicado_el && (
              <span>Publicado {formatDate(entry.data.publicacion.publicado_el)}</span>
            )
          }
          <span>Actualizado {formatDate(entry.data.publicacion.actualizado_el)}</span>
          <span>Por {entry.data.autor_ids.map(id => catalog('autores').find(author => author.id === id)?.nombre || id).join(', ')}</span>
          {
            entry.data.publicacion.estado !== 'publicado' && (
              <span class="draft-chip">
                {editorialPreviewEnabled && 'Vista local · '}
                {editorialStageLabel(entry.data.publicacion.estado)}
              </span>
            )
          }
        </div>
      </div>
    </header>
  </div>

  <article class="article-shell">
    {
      entry.data.publicacion.estado !== 'publicado' && (
        <p class="editorial-note">
          {
            editorialPreviewEnabled
              ? 'Vista editorial local: el texto completo todavía puede cambiar antes de su autorización.'
              : 'Publicación en preparación. Esta página permite seguir su estado, pero el texto completo permanecerá reservado hasta completar la revisión editorial.'
          }
        </p>
      )
    }

    {
      showFullPublication && Content ? (
        <div class="prose prose-slate max-w-none">
          <Content />
        </div>
      ) : (
        <section class="content-section publication-progress">
          <h2>Sobre el análisis en preparación</h2>
          <p>{entry.data.resumen}</p>
          <p>
            Estado actual: <strong>{editorialStageLabel(entry.data.publicacion.estado)}</strong>.
            La fecha de actualización y el expediente relacionado permiten
            seguir el avance sin presentar un borrador como texto publicado.
          </p>
        </section>
      )
    }

    {process && <ReadingLinks title="Consultar la evidencia y el seguimiento" items={[
      { href: evidenceHref(process.slug), label: 'Ver cronología y seguimiento en el Observatorio' },
      ...rectorProcesses.map(rector => ({ href: `/observatorio/${rector.slug}/`, label: `Explorar el proceso general: ${rector.titulo}` })),
    ]} />}

    <ClassificationFooter classification={entry.data.clasificacion} />

    {showFullPublication && <CorrectionLink title={entry.data.titulo} path={`/publicaciones/${entry.data.slug}/`} />}

    <SupportCTA />
  </article>
</SiteLayout>
