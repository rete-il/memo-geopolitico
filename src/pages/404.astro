---
import ActionLink from '../components/ActionLink.astro';
import PageTitle from '../components/PageTitle.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Página no encontrada" noindex>
  <div class="page-shell">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">Error 404</p>
        <PageTitle>Esta ruta no forma parte del mapa</PageTitle>
        <p>
          El contenido pudo cambiar de ubicación o todavía no estar publicado.
        </p>
        <div class="hero-actions">
          <ActionLink arrow href="/">Volver al inicio</ActionLink>
          <ActionLink arrow href="/observatorio/">Abrir el Observatorio</ActionLink>
        </div>
      </div>
    </section>
  </div>
</SiteLayout>
