---
import PageTitle from '../components/PageTitle.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Página no encontrada" noindex>
  <div class="page-shell">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">Error 404</p>
        <PageTitle>Esta ruta no forma parte del mapa</PageTitle>
        <p>
          El contenido pudo cambiar de ubicación o todavía no estar publicado.
        </p>
        <div class="hero-actions">
          <a class="button-primary" href="/">Volver al inicio</a>
          <a class="button-secondary" href="/observatorio/">Abrir el Observatorio</a>
        </div>
      </div>
    </section>
  </div>
</SiteLayout>
