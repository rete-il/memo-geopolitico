---
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';

const themes = [
  ['Seguridad y conflictos', 'Guerras, disuasión, alianzas, fronteras y competencia militar.'],
  ['Infraestructura estratégica', 'Puertos, ferrocarriles, corredores, cables y nodos logísticos.'],
  ['Comercio, energía y recursos', 'Cadenas de suministro, minerales críticos, sanciones y mercados.'],
  ['Tecnología y poder', 'Inteligencia artificial, plataformas, industria y soberanía tecnológica.'],
  ['Medios y desinformación', 'Cobertura mediática, narrativas, propaganda y ecosistemas informativos.'],
  ['Gobernanza y orden internacional', 'Instituciones, autoritarismo, democracia y reglas multilaterales.'],
];
---

<Layout title="Temas | Memo Geopolítico" description="Exploración temática de los contenidos de Memo Geopolítico.">
  <Header />
  <main class="mx-auto w-full max-w-5xl px-4 py-10 lg:px-6">
    <header class="mb-8 border-b border-slate-300 pb-6">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-500">Explorar</p>
      <h1 class="mt-2 text-4xl font-serif font-bold text-slate-950">Temas</h1>
      <p class="mt-3 max-w-3xl leading-7 text-slate-600">Clasificación transversal para relacionar acontecimientos recientes con procesos estructurales y fuentes de contexto.</p>
    </header>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {themes.map(([name, description]) => (
        <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <h2 class="text-xl font-serif font-bold text-slate-900">{name}</h2>
          <p class="mt-3 text-sm leading-6 text-slate-600">{description}</p>
        </article>
      ))}
    </div>
  </main>
</Layout>
