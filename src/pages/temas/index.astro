---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { catalog, processesForTheme } from '../../lib/data';

const items = [...catalog('temas'), ...catalog('subtemas')].filter(
  (item) => processesForTheme(item.id).length > 0,
);
---

<SiteLayout title="Temas" description="Exploración temática del Observatorio.">
  <div class="page-shell">
    <header class="page-intro">
      <div>
        <p class="eyebrow">Explorar</p>
        <h1>Temas que atraviesan regiones y actores.</h1>
      </div>
      <p>
        Los temas se asignan mediante IDs canónicos y sus relaciones se calculan
        desde los metadatos, sin listas manuales duplicadas.
      </p>
    </header>
    <section class="section-shell">
      <div class="explore-grid">
        {items.map((item) => (
          <article class="explore-card">
            <h2>{item.nombre}</h2>
            <p>{processesForTheme(item.id).length} procesos relacionados.</p>
            <a href={`/temas/${item.slug}/`}>Abrir</a>
          </article>
        ))}
      </div>
    </section>
  </div>
</SiteLayout>
