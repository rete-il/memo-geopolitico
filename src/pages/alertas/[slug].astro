---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const alertas = await getCollection('alertas');
  return alertas.map((alerta) => ({
    params: { slug: alerta.id },
    props: { alerta },
  }));
}

const { alerta } = Astro.props;
const { Content } = await render(alerta);

const severityConfig = {
  critical: {
    color: 'bg-red-100 text-red-700 border-red-200',
    icon: '🔴',
    label: 'CRÍTICO',
  },
  medium: {
    color: 'bg-amber-100 text-amber-700 border-amber-200',
    icon: '🟠',
    label: 'MEDIO',
  },
  low: {
    color: 'bg-yellow-100 text-yellow-700 border-yellow-200',
    icon: '🟡',
    label: 'BAJO',
  },
};
const meta = severityConfig[alerta.data.severity];
const absoluteDate = new Date(alerta.data.date).toLocaleDateString('es-ES', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});
---

<Layout>
  <div
    class="max-w-screen-md mx-auto w-full px-4 py-8 bg-slate-50 min-h-screen"
  >
    <header class="mb-8">
      <a
        href="/"
        class="inline-flex items-center text-sm font-medium text-slate-500 hover:text-slate-900 transition-colors mb-6"
      >
        <i class="ph ph-arrow-left mr-2"></i> Volver al tablero
      </a>
      <div class="flex items-center gap-3 mb-4">
        <span
          class={`px-2.5 py-1 rounded-full text-xs font-semibold border ${meta.color}`}
        >
          {meta.icon}
          {meta.label}
        </span>
        <time class="text-sm text-slate-500 font-medium">{absoluteDate}</time>
      </div>
      <h1 class="text-[24px] font-bold text-slate-900 leading-tight">
        {alerta.data.title}
      </h1>
    </header>
    <div class="prose prose-slate max-w-none mb-10 text-slate-700">
      <Content />
    </div>
    {
      alerta.data.sources && alerta.data.sources.length > 0 && (
        <section class="border-t border-slate-200 pt-8 mt-8">
          <h2 class="text-lg font-bold text-slate-800 mb-6 flex items-center gap-2">
            <i class="ph ph-article" /> Fuentes de Inteligencia
          </h2>
          <div class="flex flex-col">
            {alerta.data.sources.map((source, index) => (
              <article class="group">
                <a
                  href={source.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Abrir ${source.title} en una nueva pestaña`}
                  class="inline-flex items-center text-[16px] font-semibold text-slate-900 group-hover:text-red-600 transition-colors mb-2"
                >
                  {source.title}
                  <i class="ph ph-arrow-up-right ml-1 text-slate-400 group-hover:text-red-500" />
                </a>
                <p class="text-[15px] font-normal text-slate-700 leading-[1.6]">
                  {source.summary}
                </p>
                {index !== alerta.data.sources!.length - 1 && (
                  <hr class="border-slate-100 my-6" />
                )}
              </article>
            ))}
          </div>
        </section>
      )
    }
  </div>
</Layout>
