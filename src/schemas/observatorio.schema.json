{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memogeopolitico.com/schemas/observatorio.schema.json",
  "title": "Caso del Observatorio de relevancia geopolítica",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "titulo",
    "categoria",
    "region",
    "estado_publicacion",
    "estado_datos",
    "resumen",
    "corte_editorial",
    "insight",
    "fuentes",
    "historial"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "titulo": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "categoria": {
      "type": "string",
      "enum": [
        "seguridad_conflicto",
        "infraestructura_estrategica",
        "comercio_energia_recursos"
      ]
    },
    "region": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "estado_publicacion": {
      "type": "string",
      "enum": [
        "borrador",
        "publicado",
        "destacado",
        "archivado"
      ]
    },
    "estado_datos": {
      "type": "string",
      "enum": [
        "incompleto",
        "completo"
      ]
    },
    "orden_portada": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "resumen": {
      "type": "string",
      "minLength": 40,
      "maxLength": 500
    },
    "fecha_inicio": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "corte_editorial": {
      "type": "string",
      "format": "date"
    },
    "periodo_cobertura": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inicio",
        "fin",
        "dias"
      ],
      "properties": {
        "inicio": {
          "type": "string",
          "format": "date"
        },
        "fin": {
          "type": "string",
          "format": "date"
        },
        "dias": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        }
      }
    },
    "dimensiones_relevancia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criticidad_estrategica",
        "alcance_geografico",
        "poblacion_activos_afectados",
        "persistencia_temporal",
        "propagacion_regional",
        "dificultad_reversion",
        "capacidad_actores"
      ],
      "properties": {
        "criticidad_estrategica": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "alcance_geografico": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "poblacion_activos_afectados": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "persistencia_temporal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "propagacion_regional": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "dificultad_reversion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "capacidad_actores": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "indices": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relevancia",
        "atencion",
        "brecha",
        "clasificacion"
      ],
      "properties": {
        "relevancia": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "atencion": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "brecha": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "clasificacion": {
          "type": "string",
          "enum": [
            "subcubierto",
            "cobertura_proporcional",
            "sobrecubierto"
          ]
        }
      }
    },
    "atencion_mediatica": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "articulos",
        "medios_muestra",
        "participacion_pct",
        "amplitud_pct",
        "prominencia_pct",
        "persistencia_pct",
        "descripcion_muestra"
      ],
      "properties": {
        "articulos": {
          "type": "integer",
          "minimum": 0
        },
        "medios_muestra": {
          "type": "integer",
          "minimum": 1
        },
        "participacion_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "amplitud_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "prominencia_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "persistencia_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "descripcion_muestra": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500
        }
      }
    },
    "metricas_especificas": {
      "type": "object",
      "additionalProperties": true
    },
    "insight": {
      "type": "string",
      "minLength": 30,
      "maxLength": 700
    },
    "fuentes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "titulo",
          "editor",
          "url",
          "fecha_consulta",
          "tipo",
          "respalda"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "titulo": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300
          },
          "editor": {
            "type": "string",
            "minLength": 2,
            "maxLength": 150
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "fecha_publicacion": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "fecha_consulta": {
            "type": "string",
            "format": "date"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "primaria",
              "secundaria",
              "medio",
              "base_datos",
              "otro"
            ]
          },
          "respalda": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "nota": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          }
        }
      }
    },
    "historial": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fecha",
          "relevancia",
          "atencion",
          "brecha"
        ],
        "properties": {
          "fecha": {
            "type": "string",
            "format": "date"
          },
          "relevancia": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "atencion": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "brecha": {
            "type": "number",
            "minimum": -100,
            "maximum": 100
          },
          "nota": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          }
        }
      }
    },
    "migracion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origen",
        "estado",
        "datos_legacy"
      ],
      "properties": {
        "origen": {
          "type": "string",
          "const": "src/data/monitores.json"
        },
        "estado": {
          "type": "string",
          "enum": [
            "pendiente_datos",
            "validado",
            "retirado"
          ]
        },
        "datos_legacy": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "estado_publicacion": {
            "enum": [
              "publicado",
              "destacado",
              "archivado"
            ]
          }
        },
        "required": [
          "estado_publicacion"
        ]
      },
      "then": {
        "required": [
          "periodo_cobertura",
          "dimensiones_relevancia",
          "indices",
          "atencion_mediatica",
          "metricas_especificas"
        ],
        "properties": {
          "estado_datos": {
            "const": "completo"
          },
          "fuentes": {
            "minItems": 1
          },
          "historial": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "estado_publicacion": {
            "const": "destacado"
          }
        },
        "required": [
          "estado_publicacion"
        ]
      },
      "then": {
        "required": [
          "orden_portada"
        ],
        "properties": {
          "orden_portada": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  ]
}
