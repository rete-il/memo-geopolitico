    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.10.1",
    "typescript": "^6.0.3"
  }
