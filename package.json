    "check": "astro check",
    "test": "node --test",
    "validate:data": "node tools/validate-public-data.mjs",
    "validate:build": "node tools/validate-build.mjs",
    "sync:local": "node tools/sync-local-data.mjs",
    "qa": "npm run test && npm run validate:data && npm run check && npm run build && npm run build:preview && npm run validate:build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.7",
