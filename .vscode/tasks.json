{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Memo: vista local",
      "type": "process",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["run", "dev", "--", "--host", "127.0.0.1", "--port", "4321"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "ASTRO_TELEMETRY_DISABLED": "1" }
      },
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Memo: verificar producción",
      "type": "process",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["run", "qa:production"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "ASTRO_TELEMETRY_DISABLED": "1" }
      },
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
